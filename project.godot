; Engine configuration file.
config_version=5

[application]

config/name="Козацька Звитяга"
config/description="Екшн-RPG для смартфонів у сетингу козацького фентезі"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/gfx/icon/icon_192.png"
boot_splash/bg_color=Color(0.086, 0.173, 0.322, 1)
boot_splash/image="res://assets/gfx/icon/splash_384.png"
boot_splash/fullsize=false
boot_splash/use_filter=false

[autoload]

Events="*res://scripts/core/events.gd"
Audio="*res://scripts/core/audio.gd"
Ads="*res://scripts/core/ads.gd"
Billing="*res://scripts/core/billing.gd"
TouchScroll="*res://scripts/core/touch_scroll.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=0

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.12, 0.16, 0.1, 1)
