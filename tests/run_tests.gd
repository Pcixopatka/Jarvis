	await _frames(2)
	game.shop_tab = 1
	tabs_of.call().current_tab = 1
	await keeps.call("донатна крамниця після вибору товару", func(): game.shop_do("select", "x"), 120)
	game.close_shop()
	await _frames(2)
	game.ShopService.state(gw)["coins"] = 100000
	check(DS.buy(gw, gp, "khovanets") and DS.remote_shop(gp), "Хованець вдягнений")
	game.open_trader(game.enter_map)
	await _frames(2)
	await keeps.call("крамниця Хованця після вибору речі", func(): game.city_do("select", int(gp.inventory[0]["uid"])))
	await keeps.call("крамниця Хованця після продажу", func(): game.city_do("sell", int(gp.inventory[0]["uid"])))
	game.close_trader()
	await _frames(2)

	# ---- Довідник: закрив і відкрив, і він згори ----
	game.open_wiki(game.enter_map)
	await _frames(2)
	var wat: int = scroll_to.call(300)
	check(wat >= 40, "розділ довідника гортається")
	game.close_wiki()
	await _frames(2)
	game.open_wiki(game.enter_map)
	await _frames(3)
	check(sc_now.call().scroll_vertical == 0, "довідник, відкритий знову, починається згори")
	game.close_wiki()
	await _frames(2)
	var guide := ""
	for sx in WS.sections():
		for e in sx["entries"]:
			if str(e["title"]) == "Гортання списків":
				guide = str(e["text"])
	check("лишається там, куди ти його прогорнув" in guide and "іншу вкладку" in guide, "довідник каже, що список лишається на місці")

	# ---- Бічна панель мапи ----
	game.enter_map()
	game.TowerService.state(gw)["max"] = 30
	game.map_sel = game.TowerService.LOC_ID
	game.tower_sel = 10
	game._build_map_panel()
	await _frames(3)
	var msc: ScrollContainer = hud._map_scroll
	msc.scroll_vertical = mini(120, room.call(msc))
	var mat: int = msc.scroll_vertical
	check(mat >= 30, "панель Башти на низькому екрані гортається (%d)" % mat)
	game.tower_sel = 11  # те саме, що «▸» на панелі
	game._build_map_panel()
	await _frames(4)
	check(hud._map_scroll != msc and near.call(hud._map_scroll.scroll_vertical, mat), "вибір поверху: панель лишилась на місці (%d → %d)" % [mat, hud._map_scroll.scroll_vertical])
	game.map_sel = "sich"
	game._build_map_panel()
	await _frames(3)
	check(hud._map_scroll.scroll_vertical == 0, "інше місце на мапі: панель згори")

	# ---- Меню паузи ----
	var press_menu := func(prefix: String) -> bool:
		for b in hud.overlay_box.find_children("*", "Button", true, false):
			if not b.is_queued_for_deletion() and b.text.begins_with(prefix):
				b.pressed.emit()
				return true
		return false
	var osc: ScrollContainer = hud.overlay_scroll
	game.enter_location("wild_field")
	await _frames(3)
	game._show_pause()
	await _frames(3)
	osc.scroll_vertical = mini(200, room.call(osc))
	var oat: int = osc.scroll_vertical
	check(oat >= 40, "пауза на низькому екрані гортається (%d)" % oat)
	check(press_menu.call("Звук:"), "у паузі є перемикач звуку")
	await _frames(1)
	var ofirst: int = osc.scroll_vertical
	await _frames(3)
	check(near.call(ofirst, oat) and near.call(osc.scroll_vertical, oat), "перемикач звуку: меню лишилось на місці (%d → %d)" % [oat, osc.scroll_vertical])
	check(press_menu.call("Звук:"), "звук назад")
	await _frames(3)
	check(Aud.sound_on == sound0 and near.call(osc.scroll_vertical, oat), "звук повернуто, меню на місці")
	check(press_menu.call("Музика:"), "перемикач музики")
	await _frames(2)
	check(press_menu.call("Музика:"), "музика назад")
	await _frames(3)
	check(Aud.music_on == music0 and near.call(osc.scroll_vertical, oat), "музика повернута, меню на місці (%d)" % osc.scroll_vertical)
	# Підменю: фільтр автопідбору перемальовує себе, а «Назад» вертає паузу туди, де була
	check(press_menu.call("Автопідбір"), "кнопка фільтра автопідбору")
	await _frames(3)
	check(osc.scroll_vertical == 0 or room.call(osc) < 4, "фільтр відкривається згори")
	osc.scroll_vertical = mini(80, room.call(osc))
	var fat: int = osc.scroll_vertical
	for i in 2:
		game.combat.pickup_filter[0] = not game.combat.pickup_filter[0]
		game._show_pickup_menu(game._show_pause)
		await _frames(3)
	check(near.call(osc.scroll_vertical, fat), "фільтр після перемикання лишився на місці")
	check(press_menu.call("Назад"), "з фільтра назад")
	await _frames(4)
	check(near.call(osc.scroll_vertical, oat), "назад із фільтра: пауза на тому самому місці (%d → %d)" % [oat, osc.scroll_vertical])
	game.combat.pickup_filter = filter0.duplicate()
	hud.close_overlay()
	game._show_pause()
	await _frames(3)
	check(osc.scroll_vertical == 0, "пауза, відкрита знову, починається згори")
	game._resume_play()
	await _frames(2)
	game.enter_map()
	await _frames(2)

	# ---- «Персонажі»: перейменування й «Ні» на видаленні вертають список на місце ----
	game.save_game()
	game._show_heroes_menu()
	await _frames(3)
	osc.scroll_vertical = mini(150, room.call(osc))
	var hat2: int = osc.scroll_vertical
	check(hat2 >= 40, "«Персонажі» на низькому екрані гортаються (%d)" % hat2)
	game._ask_rename(1)  # без слотів перший слот це тестове збереження
	await _frames(2)
	check(game.naming == "rename" and game.name_edit != null, "відкрито екран імені")
	game.name_edit.text = "Остап"
	game.name_submit()
	await _frames(4)
	check(gp.nick == "Остап" and near.call(osc.scroll_vertical, hat2), "після перейменування «Персонажі» на тому самому місці (%d → %d)" % [hat2, osc.scroll_vertical])
	game._confirm_delete_slot(5)
	await _frames(2)
	check(press_menu.call("Ні"), "на видаленні є «Ні»")
	await _frames(4)
	check(near.call(osc.scroll_vertical, hat2), "«Ні» на видаленні: список на тому самому місці")
	game._show_main_menu()
	await _frames(2)
	game._show_heroes_menu()
	await _frames(3)
	check(osc.scroll_vertical == 0, "«Персонажі», відкриті з головного меню, згори")
	# Перенесення роду: меню перемальовує себе після «Скопіювати код» і лишається на місці
	game._show_transfer_menu()
	await _frames(3)
	osc.scroll_vertical = mini(120, room.call(osc))
	var tat: int = osc.scroll_vertical
	check(tat >= 20, "перенесення роду на низькому екрані гортається (%d)" % tat)
	game.transfer_copy()
	await _frames(4)
	check(near.call(osc.scroll_vertical, tat), "після «Скопіювати код» меню на тому самому місці (%d → %d)" % [tat, osc.scroll_vertical])
	hud.close_overlay()

	root.size = win_size
	hud.insets_override = []
	hud.layout()
	if Aud.sound_on != sound0:
		Aud.set_sound(sound0)
	if Aud.music_on != music0:
		Aud.set_music(music0)
	game.combat.pickup_filter = filter0.duplicate()
	game._save_settings()
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


func _suite_auto_buffs() -> void:
	suite("Авто-бафи Німба")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var DS = load("res://scripts/game/divine_service.gd")
	var SH = load("res://scripts/game/shop_service.gd")
	var SI = load("res://scripts/data/skill_info.gd")
	var Div = load("res://scripts/data/divine.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var UDiv = load("res://scripts/ui/ui_divine.gd")
	var Cls = load("res://scripts/data/classes.gd")
	var AS = load("res://scripts/game/auto_service.gd")
	# ---- Лікувальні вміння: усі бафи, що вертають здоров'я ----
	var heal_ids := []
	for id in Cls.actives():
		if SI.kind(id) == "buff" and SI.heals(id):
			heal_ids.append(id)
	for id in ["first_aid", "herb", "zhyvytsia", "zamova_krovi", "tsiliushche_kolo", "khoruhva", "stiika_tsilytelia"]:
		check(id in heal_ids, "лікувальний баф: %s" % id)
	for id in ["battle_cry", "mur", "navala", "kulia", "shield", "sokil", "dukh", "pidniaty"]:
		check(not SI.heals(id), "не лікувальний: %s" % id)
	for id in Cls.actives():
		if SI.kind(id) == "buff" and (Cls.act(id).has("heal") or Cls.act(id).get("fx", {}).has("regen_pct")):
			check(id in heal_ids, "баф за даними з лікуванням визнано лікувальним: %s" % id)
	# ---- Чисте лікування чекає рани, лікування з бонусом тиснеться одразу (SkillInfo.waits_for_wound) ----
	var pure_heals := ["first_aid", "herb", "zhyvytsia", "zamova_krovi", "tsiliushche_kolo", "stiika_tsilytelia"]
	for id in pure_heals:
		check(SI.waits_for_wound(id), "чисте лікування чекає рани: %s" % id)
	check(not SI.waits_for_wound("khoruhva"), "Хоругва лікує й дає шкоду: тиснеться одразу")
	var wrong_wait := []
	for id in Cls.actives():
		if SI.kind(id) == "buff" and not SI.heals(id) and SI.waits_for_wound(id):
			wrong_wait.append(id)
	check(wrong_wait.is_empty(), "баф, що не лікує, рани не чекає: %s" % [wrong_wait])
	check(SI.group("navala") == "stance" and SI.group("mur") == "stance" and SI.group("battle_cry") == "" and SI.group("khoruhva") == "", "група вміння: стійки «stance», решта без групи")
	# ---- Тексти ----
	var nl: Array = Div.def("nimb")["lines"]
	var heal_pct := "%d%%" % roundi(DS.AUTO_HEAL_AT * 100.0)
	check(nl.size() == 5 and "авто-бафи" in str(nl[2]) and "нижньої панелі" in str(nl[2]), "у Німба третій рядок про авто-бафи")
	check(nl.size() == 5 and "чисте лікування" in str(nl[3]) and heal_pct in str(nl[3]) and "з бонусом" in str(nl[3]) and "одразу" in str(nl[3]), "четвертий рядок: чисте лікування чекає %s, лікування з бонусом одразу" % heal_pct)
	check(nl.size() == 5 and "стійок" in str(nl[4]) and "найлівіша" in str(nl[4]), "п'ятий рядок: зі стійок вмикається найлівіша")
	check(int(Div.def("nimb")["price"]) == 1200 and is_equal_approx(float(Div.def("nimb")["xp"]), 5.0) and is_equal_approx(float(Div.def("nimb")["gold"]), 5.0) and str(nl[0]) == "+500% досвіду" and str(nl[1]) == "+500% гривень", "ціна та сама, Німб дає +500% досвіду й гривень")
	var art := ""
	for sec in WS.sections():
		for e in sec["entries"]:
			if str(e["title"]) == "Божі дари":
				art = str(e["text"])
	check("авто-бафи" in art and "Авто-бафи: так" in art and ("нижче %d%%" % roundi(DS.AUTO_HEAL_AT * 100.0)) in art and "Перша допомога" in art and "Замовляння крові" in art and "гетьманському огляді" in art, "довідник описує авто-бафи: коли вмикаються, поріг лікування, перемикач")
	check(not ("—" in str(nl[2]) or "—" in str(nl[3]) or "—" in str(nl[4])), "рядки авто-бафів без довгого тире")
	check(("Чисте лікування" in art) and ("Хоругва куреня" in art) and ("вмикається одразу" in art) and ("найлівіша" in art) and ("рукою їх можна натиснути" in art), "довідник: лікування з бонусом одразу, зі стійок лише найлівіша, рукою можна будь-яку")
	var shp = _new_player()  # Сагайдачний, що вивчив усе: на панелі чотири стійки, Німб тисне одну
	shp.job = "sahaidachnyk"
	for cl in Cls.lineage("sahaidachnyk"):
		for b in Cls.tree(cl):
			for n in b["nodes"]:
				shp.skills[n["id"]] = 1
	var sh_auto_st: Array = DS.auto_panel(shp).filter(func(x): return SI.group(x) == "stance")
	var sh_st: Array = shp.panel["buff"].filter(func(x): return SI.group(x) == "stance")
	check(sh_st.size() >= 3 and sh_auto_st == [sh_st[0]], "Сагайдачний: %d стійок на панелі, Німб бере лише найлівішу (%s)" % [sh_st.size(), sh_auto_st])
	shp.free()
	# ---- Гра ----
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	game.allow_quit = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full", "duel", "dungeon", "potion", "mana_potion", "res"]:
		gw.hints[k] = true
	_quests_set(gw, "story", {"chapter": 6, "step": 0, "stage": "done", "progress": 0})
	gp.change_class("cossack")
	gp.change_class("kharakternyk")
	game._sync_class()
	gp.level = 30
	gp.stats["vit"] = 200
	gp.stats["spi"] = 100
	var buffs := ["battle_cry", "mur", "khoruhva", "first_aid", "zamova_krovi"]
	gp.skills = {"whirl": 1}
	for id in buffs:
		gp.skills[id] = 1
	gp.panel = {"attack": ["whirl", "", ""], "buff": buffs.duplicate()}
	gp.recalc()
	check(not DS.has_auto_buffs(gp) and not DS.auto_buffs_on(gp), "без Німба авто-бафів нема")
	SH.state(gw)["coins"] = 100000
	check(DS.buy(gw, gp, "nimb") and DS.wears(gp, "nimb") and gp.auto_buffs and DS.auto_buffs_on(gp), "Німб куплено й вдягнено: авто-бафи ввімкнено одразу")
	var c = game.combat
	var reset := func(hp_part: float = 1.0) -> void:
		for id in buffs + ["whirl"]:
			gp.skill_timers[id] = 0.0
		gp.buffs.clear()
		gp.recalc()
		gp.mana = gp.max_mana
		gp.hp = gp.max_hp * hp_part
		gp.invuln = 999.0
	var tick := func() -> void:  # одна перевірка авто-бафів просто зараз
		gp.auto_buff_t = 0.0
		DS.auto_buff_tick(gp, c, 0.0)
	var fired := func(id: String) -> bool:
		return float(gp.skill_timers.get(id, 0.0)) > 0.0
	var no_mana_texts := func() -> int:
		var n := 0
		for t in c.effects.get_children():
			if not t.is_queued_for_deletion() and str(t.get("text")) == "Бракує наснаги":
				n += 1
		return n
	var spawn_near := func() -> void:
		c.spawn_enemy("upyr", 1, false, gp.global_position + Vector2(260, 0))
		c.enemies_dirty()
		for e in c.enemies_now():
			e.stun = 999.0
	game.enter_location("wild_field")
	await _frames(4)
	c.spawn_timer = 9999.0
	_clear_enemies(game)
	await _frames(2)
	# 2. Нечисті нема: бафи сплять
	reset.call()
	await _frames(40)
	var none_fired := true
	for id in buffs:
		none_fired = none_fired and not fired.call(id)
	check(none_fired and gp.mana >= gp.max_mana - 0.01, "нечисті нема: жоден баф не ввімкнувся, наснага ціла")
	# 1. Нечисть поруч: бафи вмикаються самі
	spawn_near.call()
	reset.call()
	var m0: float = gp.mana
	var waited := 0
	while waited < 40 and not fired.call("battle_cry"):
		await _frames(1)
		waited += 1
	check(fired.call("battle_cry") and fired.call("mur") and gp.mana < m0 - gp.skill_cost("battle_cry"), "нечисть поруч: Клич і Мур увімкнулись самі, наснага зменшилась")
	# 6. Атаки не чіпає, лікування при повному здоров'ї мовчить
	check(not fired.call("whirl"), "атака з комірок атак сама не вмикається")
	check(not fired.call("first_aid") and not fired.call("zamova_krovi") and fired.call("khoruhva"), "здоров'я повне: чисте лікування мовчить, Хоругва (лікує й дає шкоду) ввімкнулась")
	# 11. Позначка «авто» на кнопках бафів
	var hud = game.hud
	check(hud.skill_buttons["battle_cry"].auto_mark and hud.skill_buttons["zamova_krovi"].auto_mark and not hud.skill_buttons["whirl"].auto_mark, "позначка «авто» є на кнопках бафів і нема на атаці")
	# 4. Лікування: понад 60% мовчить, нижче вмикається
	reset.call(DS.AUTO_HEAL_AT + 0.1)
	tick.call()
	check(fired.call("battle_cry") and fired.call("khoruhva") and not fired.call("first_aid") and not fired.call("zamova_krovi"), "здоров'я %d%%: чисте лікування мовчить, підсилення й Хоругва вмикаються" % roundi((DS.AUTO_HEAL_AT + 0.1) * 100.0))
	reset.call(DS.AUTO_HEAL_AT - 0.4)  # Перша допомога лікує 20%: і після неї здоров'я нижче порога
	var hp_low: float = gp.hp
	tick.call()
	check(fired.call("first_aid") and fired.call("zamova_krovi") and fired.call("khoruhva") and gp.hp > hp_low, "здоров'я нижче %d%%: Перша допомога, Замовляння крові (лікування за даними) й Хоругва ввімкнулись" % roundi(DS.AUTO_HEAL_AT * 100.0))
	# 12. Усі лікувальні бафи: при повному здоров'ї лише Хоругва, нижче порога й чисте лікування
	var extra := ["herb", "zhyvytsia", "tsiliushche_kolo", "stiika_tsilytelia", "navala", "stiika_vezhi", "stiika_vitru", "stiika_zasidky"]
	for id in extra:
		gp.skills[id] = 1
	var reset_all := func(hp_part: float = 1.0) -> void:
		for id in gp.skill_timers.keys():
			gp.skill_timers[id] = 0.0
		gp.buffs.clear()
		gp.recalc()
		gp.mana = gp.max_mana
		gp.hp = gp.max_hp * hp_part
		gp.invuln = 999.0
	var heal_panels := [["khoruhva", "first_aid", "zamova_krovi", "herb", "tsiliushche_kolo"], ["zhyvytsia", "stiika_tsilytelia", "khoruhva", "", ""]]
	for hpn in heal_panels:
		gp.panel["buff"] = hpn.duplicate()
		reset_all.call()
		tick.call()
		var quiet := true
		for id in hpn:
			if id in pure_heals and fired.call(id):
				quiet = false
		check(fired.call("khoruhva") and quiet, "здоров'я повне: Хоругва вмикається, чисте лікування (%s) мовчить" % ", ".join(hpn.filter(func(x): return x in pure_heals)))
		var all_on := true
		for id in hpn:  # по одному: лікування, що спрацювало першим, може підняти здоров'я вище порога
			if id in pure_heals:
				gp.panel["buff"] = [id, "khoruhva", "battle_cry", "mur", "zamova_krovi" if id != "zamova_krovi" else "first_aid"]
				reset_all.call(DS.AUTO_HEAL_AT - 0.45)
				tick.call()
				all_on = all_on and fired.call(id)
		check(all_on, "здоров'я нижче %s: чисте лікування (%s) вмикається" % [heal_pct, ", ".join(hpn.filter(func(x): return x in pure_heals))])
	# 13. Стійки: з кількох на панелі тисне лише найлівішу
	for order in [["navala", "mur"], ["mur", "navala"]]:
		gp.panel["buff"] = [order[0], "battle_cry", order[1], "first_aid", "zamova_krovi"]
		reset_all.call()
		var m_st: float = gp.mana
		tick.call()
		check(fired.call(order[0]) and gp.buffs.has(order[0]) and not fired.call(order[1]) and not gp.buffs.has(order[1]) and fired.call("battle_cry"), "дві стійки (%s, %s): вмикається лише ліва, баф без групи теж" % order)
		check(is_equal_approx(gp.mana, m_st - gp.skill_cost(order[0]) - gp.skill_cost("battle_cry")), "наснага пішла на ліву стійку й Клич, на праву ні")
		reset_all.call()
		gp.skill_timers[order[0]] = 5.0  # ліва відновлюється: права однаково чекає
		tick.call()
		check(not fired.call(order[1]) and not gp.buffs.has(order[1]) and fired.call("battle_cry"), "ліва стійка відновлюється: права сама не вмикається, Клич вмикається")
	# довгий бій: ліва стійка діє, скільки дозволяє її тривалість, права ні разу
	gp.panel["buff"] = ["navala", "mur", "first_aid", "zamova_krovi", "battle_cry"]
	reset_all.call()
	var st_cd: float = gp.skill_cooldown("navala")
	var st_dur: float = Cls.val(Cls.act("navala")["dur"], gp.sk("navala"))
	var run_t: float = st_cd * 3.0 + 4.0
	var on_left := 0.0
	var on_right := 0.0
	var right_ever := false
	var left_casts := 0
	var left_t0: float = 0.0
	var tt := 0.0
	while tt < run_t:
		await process_frame
		var dt: float = 1.0 / 60.0
		tt += dt
		gp.invuln = 999.0
		gp.hp = gp.max_hp
		if float(gp.skill_timers.get("navala", 0.0)) > left_t0:
			left_casts += 1
		left_t0 = float(gp.skill_timers.get("navala", 0.0))
		if gp.buffs.has("navala"):
			on_left += dt
		if gp.buffs.has("mur"):
			on_right += dt
		if float(gp.skill_timers.get("mur", 0.0)) > 0.0:
			right_ever = true
	var want := 0.0  # скільки часу стійка може діяти: об'єднання відрізків [k·cd, k·cd + dur]
	var k := 0
	var covered := 0.0
	while k * st_cd < run_t:
		var a: float = maxf(k * st_cd, covered)
		var b: float = minf(k * st_cd + st_dur, run_t)
		if b > a:
			want += b - a
		covered = maxf(covered, b)
		k += 1
	check(left_casts == k and absf(on_left - want) <= 0.5 + DS.AUTO_STEP * k, "довгий бій %.0f с: Навала %d раз(и), діяла %.1f с з %.1f можливих" % [run_t, left_casts, on_left, want])
	check(not right_ever and on_right == 0.0, "довгий бій: Мур (права стійка) ні разу не ввімкнувся й не взяв наснаги")
	# ручний дотик по правій стійці працює
	gp.use_skill("mur")
	check(fired.call("mur") and gp.buffs.has("mur") and not gp.buffs.has("navala"), "рукою права стійка вмикається й знімає ліву")
	tick.call()
	check(gp.buffs.has("mur") and not gp.buffs.has("navala"), "Німб не перебиває стійку, ввімкнену рукою")
	# три стійки однієї групи: лише найлівіша
	gp.panel["buff"] = ["battle_cry", "stiika_vezhi", "stiika_vitru", "stiika_zasidky", "khoruhva"]
	reset_all.call()
	tick.call()
	check(fired.call("stiika_vezhi") and not fired.call("stiika_vitru") and not fired.call("stiika_zasidky") and DS.auto_panel(gp) == ["battle_cry", "stiika_vezhi", "khoruhva"], "три стійки: вмикається лише найлівіша")
	# лікувальна стійка ліворуч: при повному здоров'ї мовчать обидві, нижче порога лише вона
	gp.panel["buff"] = ["stiika_tsilytelia", "navala", "first_aid", "zamova_krovi", "battle_cry"]
	reset_all.call()
	tick.call()
	check(not fired.call("stiika_tsilytelia") and not fired.call("navala") and not gp.buffs.has("stiika_tsilytelia") and not gp.buffs.has("navala"), "Стійка: цілитель ліворуч, здоров'я повне: не вмикається ні вона, ні Навала")
	reset_all.call(DS.AUTO_HEAL_AT - 0.2)
	tick.call()
	check(fired.call("stiika_tsilytelia") and not fired.call("navala") and gp.buffs.has("stiika_tsilytelia"), "здоров'я нижче %s: вмикається лише Стійка: цілитель" % heal_pct)
	for id in extra:
		gp.skills.erase(id)
		gp.skill_timers.erase(id)
	gp.panel["buff"] = buffs.duplicate()
	# 7. Порядок комірок і запас наснаги
	reset.call()
	gp.mana = gp.skill_cost("battle_cry") + gp.skill_cost("mur") + 1.0
	tick.call()
	check(fired.call("battle_cry") and fired.call("mur") and gp.mana < 2.0, "вмикається все, на що вистачає наснаги, без запасу")
	reset.call()
	gp.mana = gp.skill_cost("battle_cry") + 1.0
	tick.call()
	check(fired.call("battle_cry") and not fired.call("mur"), "наснаги на один: вмикається лівий (Клич у першій комірці)")
	gp.panel["buff"] = ["mur", "battle_cry", "khoruhva", "first_aid", "zamova_krovi"]
	reset.call()
	gp.mana = gp.skill_cost("battle_cry") + 1.0
	tick.call()
	check(fired.call("mur") and not fired.call("battle_cry"), "переставили: тепер лівий Мур, він і вмикається")
	gp.panel["buff"] = buffs.duplicate()
	# 5. Бракує наснаги: авто мовчить, ручний дотик каже
	reset.call()
	gp.mana = 1.0
	var t0: int = no_mana_texts.call()
	tick.call()
	await _frames(1)
	check(not fired.call("battle_cry") and not fired.call("mur") and no_mana_texts.call() == t0, "наснаги бракує: авто-бафи нічого не вмикають і не кажуть «Бракує наснаги»")
	gp.mana = 1.0
	gp.use_skill("battle_cry")
	await _frames(1)
	check(not fired.call("battle_cry") and no_mana_texts.call() > t0, "ручний дотик без наснаги, як і раніше, каже «Бракує наснаги»")
	# 6. Ручний дотик по бафу працює
	reset.call()
	gp.auto_buffs = false
	gp.use_skill("mur")
	check(fired.call("mur"), "ручний дотик по бафу вмикає його")
	# 3. Перемикач вимкнено: нічого; ввімкнули: вмикається
	reset.call()
	await _frames(40)
	check(not fired.call("battle_cry") and not fired.call("mur") and not DS.auto_buffs_on(gp), "перемикач вимкнено: бафи самі не вмикаються")
	check(not hud.skill_buttons["battle_cry"].auto_mark, "перемикач вимкнено: позначки «авто» нема")
	gp.auto_buffs = true
	await _frames(40)
	check(fired.call("battle_cry") and fired.call("mur") and hud.skill_buttons["battle_cry"].auto_mark, "перемикач ввімкнули: бафи знову вмикаються самі, позначка є")
	# 3, 9. Німб знято: поведінка як без нього
	DS.unequip(gw, gp, "halo")
	reset.call()
	await _frames(40)
	check(not fired.call("battle_cry") and not fired.call("mur") and not hud.skill_buttons["battle_cry"].auto_mark, "Німб знято: бафи самі не вмикаються, позначки нема")
	gp.use_skill("battle_cry")
	check(fired.call("battle_cry"), "без Німба ручний дотик працює, як раніше")
	DS.equip(gw, gp, "nimb")
	reset.call()
	await _frames(40)
	check(fired.call("battle_cry") and DS.auto_buffs_on(gp), "Німб вдягли знову: бафи вмикаються")
	# Не щокадру
	var tq: float = gp.auto_buff_t
	check(tq > 0.0 and tq <= DS.AUTO_STEP, "перевірка йде раз на %.2f с, не щокадру" % DS.AUTO_STEP)
	# 10. Разом з автобоєм: авто-бафи мовчать, тисне автобій
	gw.cleared["wild_field"] = AS.MIN_CLEARS
	reset.call()
	game.toggle_auto()
	await _frames(2)
	gp.auto_buff_t = 0.5
	await _frames(20)
	check(game.auto_on and is_equal_approx(gp.auto_buff_t, 0.5), "з автобоєм авто-бафи не перевіряються: вміння тисне лише автобій")
	await _frames(60)
	check(gp.alive and fired.call("battle_cry"), "з автобоєм бій іде, бафи вмикає автобій, нічого не падає")
	game.toggle_auto()
	await _frames(2)
	check(not game.auto_on, "автобій вимкнено")
	# 8. Збереження
	gp.auto_buffs = false
	var d: Dictionary = gp.to_dict()
	check(d.has("auto_buffs") and d["auto_buffs"] == false, "перемикач пишеться в збереження героя")
	var p2 = _new_player()
	p2.from_dict(d)
	check(p2.auto_buffs == false, "вимкнений перемикач переживає to_dict/from_dict")
	var old: Dictionary = d.duplicate(true)
	old.erase("auto_buffs")
	var p3 = _new_player()
	p3.auto_buffs = false
	p3.from_dict(old)
	check(p3.auto_buffs == true, "старе збереження без поля: авто-бафи ввімкнено")
	gp.auto_buffs = true
	p2.free()
	p3.free()
	# 5. Герць
	_clear_enemies(game)
	game.enter_map()
	await _frames(2)
	game.start_duel(true)
	await _frames(4)
	check(c.is_duel(), "вийшли на вільний герць")
	reset.call()
	var duel_ok := false
	for i in 30:
		await _frames(10)
		gp.invuln = 999.0
		if fired.call("battle_cry"):
			duel_ok = true
			break
	check(duel_ok, "у герці авто-бафи теж діють")
	game.enter_map()
	await _frames(2)
	# Картка Німба з перемикачем
	game.open_character()
	await _frames(2)
	game.char_do("select", UDiv.sel_of("halo"))
	await _frames(2)
	await _reveal_tabs(game)
	var find_btn := func(text: String) -> Button:
		for b in game.hud.screen_root.find_children("*", "Button", true, false):
			if not b.is_queued_for_deletion() and b.text == text:
				return b
		return null
	check(find_btn.call("Авто-бафи: так") != null, "на картці Німба кнопка «Авто-бафи: так»")
	game.char_do("auto_buffs", null)
	await _frames(2)
	await _reveal_tabs(game)
	check(not gp.auto_buffs and find_btn.call("Авто-бафи: ні") != null, "дотик вимикає: кнопка «Авто-бафи: ні»")
	game.char_do("auto_buffs", null)
	check(gp.auto_buffs, "другий дотик вмикає знову")
	game.char_do("divine_toggle", "nimb")
	await _frames(2)
	await _reveal_tabs(game)
	check(find_btn.call("Авто-бафи: так") == null and find_btn.call("Авто-бафи: ні") == null, "Німб знято: перемикача на картці нема")
	game.close_character()
	await _frames(2)
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


## Купівлю червінців і божих дарів вимкнено (Shop.COINS_ON_SALE, Divine.ON_SALE): вигляд крамниці й екрана героя
## той самий, не працюють лише дві кнопки купівлі. Решта товарів за червінці купується. Наприкінці продаж знову
## ввімкнено, як чекають інші набори.
func _suite_sale_off() -> void:
	suite("Продаж червінців і дарів вимкнено")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var Shop = load("res://scripts/data/shop.gd")
	var SH = load("res://scripts/game/shop_service.gd")
	var Div = load("res://scripts/data/divine.gd")
	var DS = load("res://scripts/game/divine_service.gd")
	var CS = load("res://scripts/game/costume_service.gd")
	var Cost = load("res://scripts/data/costumes.gd")
	var PS = load("res://scripts/game/premium_service.gd")
	var UD = load("res://scripts/ui/ui_divine.gd")
	var UIK = load("res://scripts/ui/ui_kit.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var billing = root.get_node("Billing")
	var was_instant: bool = billing.instant
	billing.instant = true  # якби Billing таки покликали, оплата пройшла б одразу й тест це побачив би
	# Типові значення в даних
	check(Shop.COINS_ON_SALE == false and Div.ON_SALE == false, "у даних обидва продажі вимкнено (тимчасове рішення власника)")
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	game.allow_quit = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
