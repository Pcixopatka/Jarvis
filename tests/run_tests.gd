		c.spawn_enemy("zarazhenyi", gp.level, boss, gp.global_position + Vector2(3000, 0))
		var e = c._last_enemy()
		if elite:
			e.make_elite(["swift"])
		e.max_hp = 1.0e6
		e.hp = e.max_hp * frac
		e.damage = 0.0
		e.speed = 0.0
		return e
	var dealt := func(e) -> float:
		var h0: float = e.hp
		gp.hit(e, 100.0, Vector2.ZERO, false)
		return h0 - e.hp
	var base: float = dealt.call(mk.call(false, false, 0.5))
	var near := func(a: float, b: float) -> bool:
		return absf(a - b) <= 1e-5 * maxf(1.0, absf(b))
	check(near.call(base, 100.0 * HS.all_hits_mult(gp)) and B.get("Шкода всіх ударів", "") == HS._bonus(base / 100.0), "«Шкода всіх ударів» %s: удар по звичайному ворогу %.3f з 100" % [B.get("Шкода всіх ударів"), base])
	var r_elite: float = dealt.call(mk.call(false, true, 0.5)) / base
	check(near.call(r_elite, HS.elite_mult(gp)) and B.get("По елітах", "") == HS._bonus(r_elite), "«По елітах» %s: еліта отримує в %.4f раза більше за звичайного" % [B.get("По елітах"), r_elite])
	var r_boss: float = dealt.call(mk.call(true, false, 0.5)) / base
	check(near.call(r_boss, HS.boss_mult(gp, c.festive)) and B.get("По босах", "") == HS._bonus(r_boss), "«По босах» %s: бос отримує в %.4f раза більше (душі, набір, зачарування, артефакт разом)" % [B.get("По босах"), r_boss])
	var r_exec: float = dealt.call(mk.call(false, false, 0.2)) / base
	check(near.call(r_exec, HS.execute_mult(gp)) and B.get("Добивання", "") == HS._bonus(r_exec), "«Добивання» %s: слабкий ворог отримує в %.4f раза більше" % [B.get("Добивання"), r_exec])
	var r_open: float = dealt.call(mk.call(false, false, 1.0)) / base
	check(near.call(r_open, HS.opener_mult(gp)) and B.get("Перший удар", "") == HS._bonus(r_open), "«Перший удар» %s" % B.get("Перший удар"))
	var st = mk.call(false, false, 0.5)
	st.stun = 2.0
	var r_stun: float = dealt.call(st) / base
	check(near.call(r_stun, HS.stun_mult(gp)) and B.get("По оглушених", "") == HS._bonus(r_stun), "«По оглушених» %s" % B.get("По оглушених"))
	# удари по героєві: відкрито, з блоком; шипи й оберіг
	var src = mk.call(false, false, 1.0)
	gp.invuln = 0.0
	gp.blocking = false
	var h0: float = gp.hp
	gp.take_damage(100.0, src)
	var open_loss: float = h0 - gp.hp
	var thorn_loss: float = src.max_hp - src.hp
	check(near.call(thorn_loss / 100.0, gp.thorns) and B.get("Шипи", "") == HS._share(thorn_loss / 100.0), "«Шипи» %s: той, хто вдарив на 100, отримав %.3f" % [B.get("Шипи"), thorn_loss])
	var ward_part: float = open_loss / (100.0 * (1.0 - gp.armor))
	check(near.call(ward_part, HS.ward_pass(gp)) and B.get("Оберіг", "") == HS._share(1.0 - ward_part), "«Оберіг» %s: після захисту проходить %.4f удару (звитяга, вміння, зілля від зарази)" % [B.get("Оберіг"), ward_part])
	gp.hp = gp.max_hp
	gp.invuln = 0.0
	gp.blocking = true
	gp.block_time = gp.PARRY_WINDOW + 0.5
	h0 = gp.hp
	gp.take_damage(100.0, null)
	var block_part: float = (h0 - gp.hp) / open_loss
	gp.blocking = false
	check(near.call(block_part, HS.block_pass(gp)) and B.get("Блок гасить", "") == HS._share(1.0 - block_part), "«Блок гасить» %s: крізь блок пройшло %.4f удару" % [B.get("Блок гасить"), block_part])
	# парирування: удар у відповідь і лікування
	var ps = mk.call(false, false, 0.5)
	gp.hp = gp.max_hp * 0.5
	gp.invuln = 0.0
	gp.blocking = true
	gp.block_time = 0.0
	gp.leech_pool = 0.0
	h0 = gp.hp
	gp.take_damage(100.0, ps)
	var counter: float = (ps.max_hp * 0.5 - ps.hp) / HS.all_hits_mult(gp)
	check(near.call(counter, gp.damage * HS.parry_mult(gp)) and B.get("Удар парирування", "") == "%.1f" % counter, "«Удар парирування» %s: удар у відповідь %.1f" % [B.get("Удар парирування"), counter])
	var ph: float = (gp.hp - h0) / gp.max_hp
	check(near.call(ph, HS.parry_heal(gp)) and B.get("Парирування лікує", "") == HS._share(ph), "«Парирування лікує» %s: повернуло %.4f здоров'я" % [B.get("Парирування лікує"), ph])
	gp.blocking = false
	gp.invuln = 0.0
	# вбивство: здоров'я й наснага
	var kv = mk.call(false, false, 1.0)
	kv.hp = 1.0
	gp.hp = gp.max_hp * 0.5
	gp.mana = 0.0
	gp.leech_pool = 0.0
	gp.hit(kv, 100.0, Vector2.ZERO, false)
	var kh: float = (gp.hp - gp.max_hp * 0.5) / gp.max_hp
	check(kv.dead and near.call(kh, HS.kill_heal(gp)) and B.get("За вбивство: здоров'я", "") == HS._share(kh), "«За вбивство: здоров'я» %s: повернуло %.4f" % [B.get("За вбивство: здоров'я"), kh])
	check(near.call(gp.mana, HS.kill_mana(gp)) and B.get("За вбивство: наснага", "") == "+" + HS._trim(gp.mana), "«За вбивство: наснага» %s: дало %.2f" % [B.get("За вбивство: наснага"), gp.mana])
	# перекид і наснага за удар зблизька
	gp.dodge_timer = 0.0
	gp.dodge()
	check(gp.dodge_timer == gp.dodge_cooldown and gp.dodge_cooldown < 1.0 and B.get("Перекид раз на", "") == "%.2f с" % gp.dodge_timer, "«Перекид раз на» %s: перезарядка перекиду %.3f с" % [B.get("Перекид раз на"), gp.dodge_timer])
	gp.dodge_time_left = 0.0
	_clear_enemies(game)
	var tgt = mk.call(false, false, 1.0)
	tgt.global_position = gp.global_position + Vector2(40, 0)
	gp.facing = Vector2.RIGHT
	gp.mana = 0.0
	gp.attack_timer = 0.0
	gp.attack()
	check(tgt.hp < tgt.max_hp and near.call(gp.mana, HS.mana_per_hit(gp)) and B.get("Наснага за удар", "") == "+" + HS._trim(gp.mana), "«Наснага за удар» %s: влучний удар шаблею дав %.3f" % [B.get("Наснага за удар"), gp.mana])
	_clear_enemies(game)
	await _frames(1)
	if game.state == game.State.PLAYING:
		game.enter_map()
	await _frames(1)
	# ---- Стрілець: «Сила пострілу» лише з луком, пістолями й пищаллю ----
	gp.change_class("strilets")
	game._sync_class()
	gp.buffs = {}
	gp.trip_buffs = {}
	var bow: Dictionary = Data.gen_item(40, 2, "weapon", "bow")
	gp.equip_new(bow)
	gp.recalc()
	tab = _hero_tab(UChar, game)
	check(tab["by"].has(HS.SHOT_LABEL) and tab["by"][HS.SHOT_LABEL] == "x" + HS._trim(gp.shot_mult) and tab["rows"].size() == 15 + NEW.size(), "з луком є рядок «%s» %s" % [HS.SHOT_LABEL, tab["by"].get(HS.SHOT_LABEL, "")])
	var want_bow: Array = want_groups[HS.ATTACK].duplicate()
	want_bow.insert(want_bow.find("Замах") + 1, HS.SHOT_LABEL)
	check(tab["groups"].get(HS.ATTACK, []) == want_bow, "з луком «%s» стоїть у «%s» одразу під «Замах»" % [HS.SHOT_LABEL, HS.ATTACK])
	gp.buffs = {"s": {"t": 999.0, "fx": {"aspd": 400.0}, "group": ""}}
	gp.recalc()
	tab = _hero_tab(UChar, game)
	check(gp.shot_mult > 1.0 and gp.attack_cooldown == gp.RANGED_MIN_CD and tab["by"].get(HS.SHOT_LABEL, "") == "x" + HS._trim(gp.shot_mult), "швидкість понад межу йде в силу пострілу: %s" % tab["by"].get(HS.SHOT_LABEL, ""))
	check(near.call(HS.mana_per_hit(gp), Data.MANA_ON_HIT * Data.MANA_ON_SHOT * minf(1.0, gp.attack_cooldown / Data.MANA_ON_HIT_CD)) and tab["by"].get("Наснага за удар", "") == "+" + HS._trim(HS.mana_per_hit(gp)), "стрілець бачить наснагу за постріл: %s" % tab["by"].get("Наснага за удар", ""))
	var shot_labels: Array = []
	for r in tab["rows"]:
		shot_labels.append(r[0])
	gp.change_class("volkhv")
	game._sync_class()
	gp.equip_new(Data.gen_item(40, 2, "weapon", "staff"))
	gp.recalc()
	tab = _hero_tab(UChar, game)
	check(not tab["by"].has(HS.SHOT_LABEL) and tab["by"].get("Наснага за удар", "") == "+0", "з посохом рядка «%s» нема, наснаги за удар він не дає" % HS.SHOT_LABEL)
	# ---- Довідник: стаття «Показники героя» називає кожен рядок ----
	var art_text := ""
	for e in WS._entries("basics"):
		if str(e["title"]) == "Показники героя":
			art_text = str(e["text"])
	var unnamed := shot_labels.filter(func(l): return not (l in art_text))
	check(art_text != "" and unnamed.is_empty(), "у довіднику є стаття «Показники героя» з кожним рядком вкладки (бракує: %s)" % str(unnamed))
	var at := -1
	var art_order := true
	for gname in want_groups:
		var hp: int = art_text.find("\n" + gname)
		art_order = art_order and hp > at
		at = hp
		if gname == HS.PROCS:
			continue
		for l in want_groups[gname]:
			var lp: int = art_text.find("«%s»" % l)
			art_order = art_order and lp > at
			at = maxi(at, lp)
	check(art_order, "стаття йде за групами вкладки: заголовки й рядки в тому самому порядку")
	var limits := ["%d%%" % roundi(Data.ARMOR_CAP * 100.0), "%d%%" % roundi(gp.CRIT_CAP * 100.0), "%d%%" % roundi(gp.SKILL_CD_MIN * 100.0), "%d%%" % roundi(gp.BLOCK_FX_CAP), "%d%%" % roundi(gp.WARD_FX_CAP), "%d%%" % roundi((1.0 - gp.DODGE_FX_MIN) * 100.0), str(gp.RANGED_MIN_CD).replace(".", ","), "%d очок" % int(Data.SPI_SOFT), "%d очок" % int(Data.AGI_ASPD_SOFT)]
	check(limits.all(func(x): return x in art_text), "стаття називає межі з тих самих сталих, що й бій: %s" % str(limits))
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)

func _suite_legends() -> void:
	suite("Перекази: Дракула й лінійки за легендами земель")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var Leg = load("res://scripts/data/legends.gd")
	var LS = load("res://scripts/game/legend_service.gd")
	var Story = load("res://scripts/data/story.gd")
	var JS = load("res://scripts/game/journal_service.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var Wiki = load("res://scripts/data/wiki_data.gd")
	var Ach = load("res://scripts/data/achievements.gd")
	var Sounds = load("res://scripts/data/sounds.gd")
	var Souls = load("res://scripts/data/souls.gd")
	var Arts = load("res://scripts/data/artifacts.gd")
	var Uniq = load("res://scripts/data/uniques.gd")
	var Acts = load("res://scripts/data/activities.gd")
	var EnemyS = load("res://scripts/entities/enemy.gd")
	var GfxS = load("res://scripts/world/gfx.gd")
	# ---- Семигород: земля, нечисть, бос ----
	var land_ok: bool = Data.is_region("semyhorod") and "semyhorod" in Data.region_ids()
	for id in ["tihutsa", "hoia", "tyrhovyshte", "zamok_drakuly"]:
		var L: Dictionary = Data.place(id)
		land_ok = land_ok and L.get("scale", false) == (L["type"] == "dungeon") and L["region"] == "semyhorod" and int(L["level"]) >= 30 and str(L["desc"]) != ""
	var brashov: Dictionary = Data.city("brashov")
	check(land_ok and Data.place("zamok_drakuly")["boss"] == "drakula" and Data.place("zamok_drakuly")["type"] == "dungeon", "Семигород на мапі: три місцевості й Замок Дракули")
	check(str(brashov.get("region", "")) == "semyhorod" and Acts.trade_city_prices("brashov").size() == Acts.trade_good_ids().size() and Data.region_ids()[-1] == "semyhorod", "Брашов: місто Семигороду з торгом, край стоїть у списку останнім")
	for kind in ["strygoi", "moroi"]:
		check((GameDB.mob_name(kind) != "") and (GameDB.mob_plural(kind) != "") and (GameDB.quest_item(kind) != "") and GfxS.has(kind) and GameDB.death_sound(kind) != "" and not GameDB.mob_wiki(kind).is_empty() and kind in Wiki.enemy_order() and Souls.has(kind) and kind in Souls.ids() and GameDB.hit_status(kind) != "" and not GameDB.bounty_names(kind).is_empty(), "%s: ім'я, спрайт, голос, душа, довідник, розшук" % GameDB.mob_name(kind, kind))
	check(GameDB.has_boss("drakula") and (GameDB.mob_name("drakula") != "") and GfxS.has("drakula") and GameDB.death_sound("drakula") != "" and not GameDB.boss_wiki("drakula").is_empty() and "drakula" in Wiki.boss_order() and Souls.has("b_drakula") and Arts.by_boss("drakula") != "" and GameDB.boss_tier("drakula") == Uniq.TOP_COMMON_TIER and GameDB.is_phase2_boss("drakula"), "Дракула: ім'я, спрайт, голос, душа, артефакт, довідник, другий етап бою")
	check("Влад" in str(GameDB.boss_wiki("drakula")["text"]) and "украв" in str(GameDB.boss_wiki("drakula")["text"]), "довідник відділяє упиря від справжнього воєводи Влада")
	# ---- Дані лінійок ----
	var data_ok := true
	var bad := ""
	for line in Leg.order():
		var LL: Dictionary = Leg.line(line)
		var ok: bool = str(LL["title"]) != "" and str(LL["land"]) != "" and str(LL["source"]) != "" and int(LL["min_level"]) >= 1 and Leg.steps(line).size() >= 2
		for i in Leg.steps(line).size():
			var st: Dictionary = Leg.steps(line)[i]
			var obj: Dictionary = st["objective"]
			ok = ok and Story.has_npc(st["giver"]) and Data.is_city(st["city"]) and not st["start"].is_empty() and not st["end"].is_empty() and str(obj["text"]) != "" and int(st["reward"]["gold_lvl"]) > 0
			for ln in st["start"] + st["end"]:
				ok = ok and Story.has_npc(ln[0]) and str(ln[1]).length() > 8
			var loc: String = str(obj.get("loc", ""))
			ok = ok and Data.is_place(loc)
			match str(obj["type"]):
				"clear":
					ok = ok and Data.place(loc)["type"] == "field"
				"dungeon":
					ok = ok and Data.place(loc)["type"] == "dungeon"
				"kill", "fetch":
					ok = ok and (GameDB.mob_name(obj["enemy"]) != "") and obj["enemy"] in Data.place(loc)["enemies"] and int(obj["count"]) > 1
					if obj["type"] == "fetch":
						ok = ok and str(obj["item"]) != "" and float(obj["chance"]) > 0.0
				_:
					ok = false
			if i == Leg.steps(line).size() - 1:
				# фінал — лігво боса; лише Кожум'яка кінчається зачисткою Кирилової борозни (Змія вже вбито в Розділі I)
				ok = ok and st["reward"].has("item") and st["reward"]["item"]["slot"] in Data.slots() and obj["type"] == ("clear" if line == "kozhumiaka" else "dungeon")
		if not ok:
			bad += line + " "
		data_ok = data_ok and ok
	check(data_ok and Leg.order().all(func(l): return not Leg.steps(l).is_empty()) and Leg.order().size() == 12, "дванадцять лінійок: оповідачі, міста, мети й нагороди існують %s" % bad)
	var top := 0
	for a in Ach.achievements():
		if str(a["stat"]) == "legend":
			top = maxi(top, int(a["goal"]))
	check(top == Leg.order().size(), "останнє досягнення просить усі лінійки")
	# ---- Лінійка Дракули: від розмови до нагороди ----
	var w = WorldState.new()
	var p = _new_player()
	p.change_class("cossack")
	p.level = 66
	var DL: Dictionary = Leg.line("drakula")
	w.hero_level = 66
	check(LS.city_dialogue(w, "verkhovyna").is_empty() and LS.target(w, "drakula") == "" and LS.QuestEngine.stage(w, "drakula_1") == "locked", "переказ — ланка історії: доки не пройдено попередню, про Дракулу мовчать")
	LS.QuestEngine.place_at(w, "drakula_1")  # попередні ланки пройдено
	w.hero_level = int(DL["min_level"]) - 1
	check(not LS.unlocked(w, "drakula") and LS.city_dialogue(w, "verkhovyna").is_empty() and LS.target(w, "drakula") == "", "до %d-го рівня про Дракулу мовчать" % int(DL["min_level"]))
	w.hero_level = 66
	var d: Dictionary = LS.city_dialogue(w, "verkhovyna")
	check(d.get("kind", "") == "legend_start" and d["line"] == "drakula" and d["lines"].size() == Leg.steps("drakula")[0]["start"].size() and LS.target(w, "drakula") == "verkhovyna", "у Верховині оповідач починає переказ")
	var said := ""
	for ln in d["lines"]:
		said += str(ln[1])
	check("Влад" in said and "украв" in said, "перша ж розмова каже, що упир лише вкрав ім'я воєводи")
	LS.on_dialogue_done(w, p, "legend_start", "drakula")
	check(LS.stage(w, "drakula") == "active" and LS.target(w, "drakula") == "tihutsa" and "tihutsa" in LS.targets(w), "мета: Перевал Тігуца, він позначений на мапі")
	check(LS.on_event(w, p, "clear", "hoia").is_empty() and LS.stage(w, "drakula") == "active", "чуже місце кроку не зараховує")
	check(not LS.on_event(w, p, "clear", "tihutsa").is_empty() and LS.stage(w, "drakula") == "turnin" and LS.target(w, "drakula") == "verkhovyna", "перевал очищено: повертайся до оповідача")
	var gold0: int = p.gold
	var tr0: int = int(p.resources.get("trophy", 0))
	check(LS.city_dialogue(w, "verkhovyna").get("kind", "") == "legend_end", "оповідач чекає з кінцевою розмовою")
	LS.on_dialogue_done(w, p, "legend_end", "drakula")
	check(p.gold == gold0 + int(Leg.steps("drakula")[0]["reward"]["gold_lvl"]) * 66 and int(p.resources["trophy"]) == tr0 + int(Leg.steps("drakula")[0]["reward"]["trophy"]) and str(LS.current(w, "drakula")["id"]) == "drakula_2", "нагорода: гривні за рівень героя й трофеї")
	# здобути ікла
	LS.on_dialogue_done(w, p, "legend_start", "drakula")
	seed(99)
	var kills := 0
	LS.on_event(w, p, "kill", "moroi")
	check(LS.QuestEngine.progress(w, str(LS.current(w, "drakula")["id"])) == 0, "ікла падають лише зі стригоїв")
	while LS.stage(w, "drakula") == "active" and kills < 200:
		LS.on_event(w, p, "kill", "strygoi")
		kills += 1
	check(LS.stage(w, "drakula") == "turnin" and kills >= 10 and kills < 60, "десять ікол здобуто за %d стригоїв" % kills)
	LS.on_dialogue_done(w, p, "legend_end", "drakula")
	# замок
	LS.on_dialogue_done(w, p, "legend_start", "drakula")
	check(LS.target(w, "drakula") == "zamok_drakuly", "останній крок веде в Замок Дракули")
	LS.on_event(w, p, "dungeon", "zamok_drakuly")
	var bag0: int = p.inventory.size()
	var fin: Array = LS.on_dialogue_done(w, p, "legend_end", "drakula")
	var prize: Dictionary = p.inventory[p.inventory.size() - 1] if p.inventory.size() > bag0 else {}
	check(LS.finished(w, "drakula") and LS.done_count(w) == 12 and prize.get("name", "") == Leg.steps("drakula")[2]["reward"]["item"]["name"] and int(prize.get("ilvl", 0)) == int(Data.place("zamok_drakuly")["level"]) + 1 and int(prize.get("rarity", 0)) == 3 and not fin.is_empty(), "переказ розказано: іменна легендарна річ на рівень вища за Замок Дракули в торбі")
	check(LS.city_dialogue(w, "verkhovyna").is_empty() and LS.target(w, "drakula") == "", "після кінця оповідач мовчить")
	# ---- Старе збереження: кілька лінійок почато одразу (так грали до ланцюжка) ----
	var wo = WorldState.new()
	wo.hero_level = 66
	_quests_set(wo, "legends", {"idolyshche": {"step": 1, "stage": "turnin", "progress": 0}, "karachun": {"step": 0, "stage": "turnin", "progress": 0}})
	var stan: Array = LS.city_dialogues(wo, "cherkaskyi_stan")
	check(stan.size() == 2 and stan[0]["line"] == "idolyshche" and stan[1]["line"] == "karachun" and LS.city_dialogue(wo, "cherkaskyi_stan", "karachun")["line"] == "karachun" and LS.city_dialogue(wo, "cherkaskyi_stan", "drakula").is_empty(), "у місті чекають усі оповідачі одразу, і до кожного можна підійти окремо")
	_quests_set(wo, "legends", {"bila_pani": {"step": 0, "stage": "active", "progress": 0}, "shubin": {"step": 0, "stage": "active", "progress": 0}})
	for i in 14:
		LS.on_event(wo, p, "kill", "mara")
	check(LS.QuestEngine.progress(wo, str(LS.current(wo, "bila_pani")["id"])) == 14 and LS.stage(wo, "bila_pani") == "active" and LS.QuestEngine.progress(wo, str(LS.current(wo, "shubin")["id"])) == 0, "кожна мара рахується, чужа лінійка не рухається")
	LS.on_event(wo, p, "kill", "mara")
	for i in 12:
		LS.on_event(wo, p, "kill", "kamiana_baba")
	check(LS.stage(wo, "bila_pani") == "turnin" and LS.stage(wo, "shubin") == "turnin" and LS.targets(wo).has("lviv") and LS.targets(wo).has("izium"), "дві почато давно лінійки йдуть одразу й кожна веде у своє місто")
	# ---- Бій у місці переказу — на рівні кроку ----
	_quests_set(wo, "legends", {"lykho": {"step": 0, "stage": "active", "progress": 0}}, true)
	var m: Dictionary = LS.mods_for(wo, p, "tarkhankut")
	check(int(m.get("level", 0)) == 48 and int(m["base_level"]) == int(Data.place("tarkhankut")["level"]) and LS.mods_for(wo, p, "crypt").is_empty(), "Тарханкут під час переказу «Лихо» — на рівні кроку (48), інші місця ні")
	var low = _new_player()
	low.level = 5
	check(int(LS.mods_for(wo, low, "tarkhankut").get("level", 0)) == 48, "рівень бою — рівень кроку, а не героя")
	# ---- Збереження ----
	var w2 = WorldState.new()
	w2.from_dict(wo.to_dict())
	w2.hero_level = 66
	check(LS.stage(w2, "bila_pani") == "turnin" and LS.stage(w2, "lykho") == "active", "поступ переказів зберігається з героєм")
	# ---- Журнал і довідник ----
	var sec: Dictionary = {}
	var jsecs: Array = JS.sections(wo, p)
	for s0 in jsecs:
		if str(s0.get("title", "")).begins_with("Перекази"):
			sec = s0
	var ready := 0
	for r in sec.get("rows", []):
		if r["ready"]:
			ready += 1
	check(not sec.is_empty() and sec["rows"].size() == 3 and ready == 2 and str(sec["rows"][0]["text"]).begins_with("★ ") and "0 із 12" in str(sec["title"]), "журнал: розділ «Перекази» з нинішніми кроками (зі зіркою), два можна здати: %s" % str(sec.get("title", "")))
	var wj = WorldState.new()
	wj.hero_level = 8
	LS.QuestEngine.place_at(wj, "kozhumiaka_1")
	var jsec0: Dictionary = JS.sections(wj, p)[0]
	check(jsec0["rows"].is_empty() and "переказ «Кирило Кожум'яка»" in str(jsec0["empty"]), "журнал: коли ланка історії — переказ, розділ «Історія» каже, де її шукати: %s" % str(jsec0["empty"]))
	var titles := {}
	for e in WS._entries("basics"):
		titles[str(e["title"])] = str(e["text"])
	var wiki_ok: bool = titles.has("Перекази")
	for line in Leg.order():
		var key := "Переказ «%s»" % Leg.line(line)["title"]
		wiki_ok = wiki_ok and titles.has(key) and str(Leg.line(line)["source"]) in titles[key] and str(Leg.line(line)["title"]) in titles.get("Перекази", "")
	check(wiki_ok, "довідник описує кожен переказ і його джерело")
	check("самі не починаються" in titles.get("Ратуша", "") and "«Поговорити»" in titles.get("Ратуша", "") and Data.hall_name("sich") in titles.get("Ратуша", "") and "в ратуші" in titles.get("Перекази", ""), "довідник має статтю «Ратуша»: розмови самі не починаються")
	# ---- У грі ----
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
	var c = game.combat
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "depths_open", "dungeon", "potion", "mana_potion", "varenyk", "res"]:
		gw.hints[k] = true
	gp.change_class("cossack")
	game._sync_class()
	gp.level = 40
	gp.stats["str"] = 3000
	gp.stats["vit"] = 3000
	gp.recalc()
	gp.hp = gp.max_hp
	_quests_set(gw, "story", {"chapter": Story.chapter_count(), "step": 0, "stage": "done", "progress": 0}, false, false)  # старе збереження: переказів не чіпали
	_quests_set(gw, "saga", {"step": Leg.order().size(), "stage": "done"})
	game.enter_map()
	await _frames(2)
	game.enter_city("kyiv")
	await _frames(3)
	var kyiv_hall: Array = game.hall_rows("kyiv")
	var hall_lines := []
	for r in kyiv_hall:
		hall_lines.append(str(r["line"]))
	# стара історія пройдена, переказів не чіпали: у Києві чекає кобзар (Вій — далі в ланцюжку, після Солов'я)
	check(game.hud.dialogue_root == null and hall_lines == ["kozhumiaka"] and kyiv_hall[0]["kind"] == "legend" and kyiv_hall[0]["name"] == Story.npc_name("kobzar") and "Кожум'яка" in str(kyiv_hall[0]["what"]), "у Києві ніхто не заговорює сам: у ратуші чекає кобзар із переказом")
	var tck = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	check(tck.get_tab_title(0) == "Ратуша (★ 1)" and Data.hall_name("kyiv") == "Ратуша" and Data.hall_name("sich") != "Ратуша", "перша вкладка міста «Ратуша (★ 1)»: переказ — ланка історії; на Січі це курінь")
	check(_hall_talk(game, "legend", "kozhumiaka"), "герой сам підходить до кобзаря")
	await _frames(2)
	check(game.hud.dialogue_root != null and is_instance_valid(game.hud.dialogue_root), "кобзар починає розмову про Кожум'яку")
	var guard := 0
	while game.hud.dialogue_root != null and is_instance_valid(game.hud.dialogue_root) and guard < 6:
		game.hud.dialogue_root.finished.emit(-1)
		await _frames(2)
		guard += 1
	check(guard == 1 and game.hall_rows("kyiv").is_empty() and game.state == game.State.CITY, "після розмови герой лишається в ратуші")
	check(LS.stage(gw, "kozhumiaka") == "active", "після розмови крок активний")
	game.enter_map()
	await _frames(2)
	check(game.hud.map_view.stars.has("rapids"), "Дніпрові пороги позначені на мапі зіркою як мета")
	game.enter_location("rapids")
	await _frames(4)
	var lvl_ok := true
	for e in get_nodes_in_group("enemies"):
		lvl_ok = lvl_ok and int(e.level) >= 8
	check(int(c.loc["level"]) == 8 and lvl_ok and str(c.loc.get("legend", "")) == "kozhumiaka", "на порогах нечисть рівня кроку (8-го), хоч місце 4-го: переказ не прогулянка")
	game.enter_map()
	await _frames(2)
	# Дракула в бою
	game.enter_location("tihutsa")
	await _frames(3)
	_clear_enemies(game)
	await _frames(2)
	c.spawn_timer = 9999.0
	gp.invuln = 999.0
	c.spawn_enemy("drakula", 40, true, gp.global_position + Vector2(260, 0))
	var boss = c._last_enemy()
	check(boss.is_boss and boss.kind == "drakula" and boss.sprite_id() == "drakula" and boss.max_hp > 0.0, "Дракула виходить на бій")
	var zones0: int = c.effects.get_child_count()
	boss._boss_ability(gp)
	await _frames(1)
	var zones1: int = c.effects.get_child_count()
	boss._boss_ability(gp)
	await _frames(1)
	var zones2: int = c.effects.get_child_count()
	var foes0: int = c.alive_enemy_count()
	boss.hp = boss.max_hp * 0.8
	var hp_before: float = boss.hp
	boss._boss_ability(gp)
	await _frames(1)
	check(zones1 == zones0 + 1 and zones2 >= zones1 + 3 and c.alive_enemy_count() == foes0 + 2 and boss.hp > hp_before, "три прийоми: падає кажаном, пускає три смуги туману, кличе слуг і лікується")
	var kinds := {}
	for e in get_nodes_in_group("enemies"):
		kinds[e.kind] = true
	check(kinds.has("strygoi") or kinds.has("moroi"), "слуги Дракули — стригої й морої")
	# ---- Ратуша: побратим теж чекає там, а не перестріває на вході ----
	var HSv = load("res://scripts/game/hero_service.gd")
	var UCity = load("res://scripts/ui/ui_city.gd")
	game.enter_map()
	await _frames(2)
	game.enter_city("chernihiv")
	await _frames(3)
	var hero_row := {}
	for r in game.hall_rows("chernihiv"):
		if r["kind"] == "hero":
			hero_row = r
	check(game.hud.dialogue_root == null and HSv.can_meet(gw, "oksana", "chernihiv") and hero_row.get("npc", "") == "oksana" and "загін" in str(hero_row.get("what", "")), "Оксана чекає в ратуші Чернігова й сама не заговорює")
	_hall_talk(game, "hero")
	await _frames(2)
	check(game.hud.dialogue_root != null and game.hud.dialogue_root.choices.size() == 2, "підійшов до неї: розмова з вибором")
	game.hud.dialogue_root.finished.emit(0)
	await _frames(3)
	var still_hero := false
	for r in game.hall_rows("chernihiv"):
		still_hero = still_hero or r["kind"] == "hero"
	check(HSv.in_party(gw, "oksana") and not still_hero and game.state == game.State.CITY, "Оксана в загоні, у ратуші її більше нема")
	game.enter_map()
	await _frames(2)
	game.enter_city("poltava")
	await _frames(3)
	var quiet := false
	var no_talk := true
	for l in game.hud.screen_root.find_children("*", "Label", true, false):
		quiet = quiet or (not l.is_queued_for_deletion() and l.text == "Зараз на тебе ніхто не чекає.")
	for b in game.hud.screen_root.find_children("*", "Button", true, false):
		no_talk = no_talk and not (not b.is_queued_for_deletion() and b.text == UCity.HALL_TALK)
	var tcp = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	check(game.hall_rows("poltava").is_empty() and quiet and no_talk and tcp.get_tab_title(0) == "Ратуша", "де ніхто не чекає, ратуша порожня й без числа в назві")
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


## Перевірки знахідок повного аудиту 0.48.0: годинник, лазівки зі спробами й цінами, переходи між
## екранами, збереження, зайва робота в бою.
func _suite_audit() -> void:
	suite("Аудит: годинник, лазівки, переходи, збереження")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var Clock = load("res://scripts/core/clock.gd")
	var CS = load("res://scripts/game/challenge_service.gd")
	var QS = load("res://scripts/game/quick_service.gd")
	var AR = load("res://scripts/game/ad_rewards.gd")
	var Prem = load("res://scripts/game/premium_service.gd")
	var Acc = load("res://scripts/game/account.gd")
	var City = load("res://scripts/game/city_service.gd")
	var TR = load("res://scripts/game/trade_service.gd")
	var Craft = load("res://scripts/game/craft_service.gd")
	var LS = load("res://scripts/game/legend_service.gd")
	var Leg = load("res://scripts/data/legends.gd")
	var Far = load("res://scripts/game/far_service.gd")
	var PS = load("res://scripts/game/plague_service.gd")
	var TS = load("res://scripts/game/travel_service.gd")
	var BS = load("res://scripts/game/boss_service.gd")
	var ES = load("res://scripts/game/event_service.gd")
	var Ach = load("res://scripts/data/achievements.gd")
	var Sets = load("res://scripts/data/sets.gd")
	var Uni = load("res://scripts/data/uniques.gd")
	var Acts = load("res://scripts/data/activities.gd")
	var Story = load("res://scripts/game/story_service.gd")
	var ST = load("res://scripts/core/save_transfer.gd")
	var DuelS = load("res://scripts/game/duel_service.gd")
	var DefS = load("res://scripts/game/defense_service.gd")
	var DS = load("res://scripts/game/divine_service.gd")

	# ---- Годинник гри: назад не йде ----
	CS.now_override = 0
	Prem.now_override = -1.0
	var real: float = Time.get_unix_time_from_system()
	Clock.high = 0.0
	check(absf(Clock.now() - real) < 5.0 and not Clock.rolled_back(), "годинник гри йде за годинником телефона")
	Clock.high = real + 5.0 * 86400.0  # гра вже бачила час на п'ять діб уперед, а телефон перевели назад
	check(is_equal_approx(Clock.now(), real + 5.0 * 86400.0) and Clock.rolled_back(), "телефон перевели назад: годинник гри стоїть на найпізнішому баченому часі")
	check(CS._now() == int(Clock.now()) and is_equal_approx(Prem.now(), Clock.now()), "виклики, боси, ярмарок і універсал рахують від годинника гри")
	check(QS._today() == CS.day_key(CS._now()) and AR._today() == QS._today(), "швидкі походи й реклама мають той самий день, що й виклики (за Гринвічем)")
	var acc = Acc.new()
	var acc_d: Dictionary = acc.to_dict()
	check(float(acc_d.get("clock", 0.0)) >= real + 5.0 * 86400.0 - 1.0, "найпізніший час зберігається з акаунтом")
	Clock.high = 0.0
	var acc2 = Acc.new()
	acc2.from_dict(acc_d)
	check(Clock.high >= real + 5.0 * 86400.0 - 1.0 and Clock.rolled_back(), "після перезапуску гра пам'ятає цей час: переведений назад годинник нічого не скидає")
	Clock.high = real + 40.0 * 86400.0
	check(absf(Clock.now() - real) < 5.0 and not Clock.rolled_back(), "бачений час далі ніж за місяць уперед вважається помилкою годинника: гра вертається до телефона")
	Clock.high = 0.0  # далі тести йдуть за справжнім часом

	# ---- Ціни: ярмарок, цінні речі ----
	var it0: Dictionary = Data.gen_item(20, 2, "head")
	var w0 = WorldState.new()
	Data.sell_mult = 1.0
	var base0: int = Data.sell_price(it0)
	var buy0: int = City.buy_price(w0, "poltava", it0)
	Data.sell_mult = 2.0
	check(Data.sell_price(it0) == base0 * 2 and Data.base_price(it0) == base0 and City.buy_price(w0, "poltava", it0) == buy0, "ярмарок подвоює ціну продажу, а ціна в крамниці лишається та сама")
	Data.sell_mult = 1.0
	var set_it: Dictionary = Sets.make(Sets.ids()[0], "head", 100)
	var gold_it: Dictionary = Uni.make(Uni.ids()[0], 50)
	check(Data.is_precious(set_it) and Data.is_precious(gold_it) and not Data.is_precious(it0), "золота й наборна речі цінні, звичайна рідкісна ні")

	# ---- Торг: надбавки не діють на крам, куплений тут-таки ----
	var tw = WorldState.new()
	var tp = _new_player()
	tp.change_class("cossack")
	tp.level = 30
	tp.gold = 10000000
	var tcity: String = Acts.trade_city_ids()[0]
	var tgood: String = Acts.trade_good_ids()[0]
	ES.state(tw)["fair"] = {"city": tcity, "left": 3}
	check(is_equal_approx(TR.sell_bonus(tw, tcity, tgood), 1.25), "на ярмарку привезений крам беруть на чверть дорожче")
	var gold_t: int = tp.gold
	var got_n: int = TR.buy(tw, tp, tcity, tgood, int(Acts.TRADE_STOCK))
	check(got_n > 0 and is_equal_approx(TR.sell_bonus(tw, tcity, tgood), 1.0), "крам, куплений тут сьогодні, місто бере назад без надбавки")
	TR.sell(tw, tp, tcity, tgood, got_n)
	check(tp.gold < gold_t, "купити й одразу продати на ярмарку більше не дає прибутку (%d → %d)" % [gold_t, tp.gold])

	# ---- Кузня: перековка й оновлення ----
	var cw = WorldState.new()
	cw.camp = {"buildings": {"kuznia": 3}}
	var plain_it: Dictionary = Data.gen_item(20, 3, "body")
	check(Craft.can_reforge(cw, plain_it) and Craft.can_reforge(cw, set_it) and Craft.can_reforge(cw, gold_it), "золоті, наборні й звичайні речі перековуються")
	var rp = _new_player()
	rp.change_class("cossack")
	rp.level = 60
	rp.gold = 100000000
	for r in ["iron", "wood", "herbs", "trophy"]:
		rp.resources[r] = 100000
	var never_lower := true
	for i in 12:
		var ri: Dictionary = Data.gen_item(10 + i, 3, "body")
		rp.add_item(ri, true)
		var before: Dictionary = ri["affixes"].duplicate()
		if Craft.renew(cw, rp, ri["uid"], 3):
			for a in before:
				never_lower = never_lower and float(ri["affixes"][a]) >= float(before[a]) - 0.0001
	check(never_lower, "оновлення речі не знижує жодної властивості")

	# ---- Переказ: мета зачистки в межах ----
	var lw = WorldState.new()
	var lp = _new_player()
	lp.level = 99
	var leg_goal := -1
	var leg_base := 0
	for line in Leg.order():
		var steps: Array = Leg.steps(line)
		for i in steps.size():
			var lloc := str(steps[i]["objective"].get("loc", ""))
			if leg_goal < 0 and Data.is_place(lloc) and int(Data.place(lloc)["level"]) < 99:
				_quests_set(lw, "legends", {line: {"step": i, "stage": "active", "progress": 0}}, true)
				var lm: Dictionary = LS.mods_for(lw, lp, lloc)
				leg_goal = int(lm.get("goal", -1))
				leg_base = int(Data.place(lloc)["level"])
				check(int(lm.get("level", 0)) == maxi(int(steps[i]["min_level"]), leg_base) and int(lm["level"]) > leg_base and QS.step_target(lw, lloc), "місце переказу підтягується до рівня кроку й є метою кроку")
				check("справа" in QS.block_reason(_cleared_world(lw, lloc), lp, lloc), "швидкий похід у місце, де чекає крок переказу, не дається")
	check(leg_goal > 0 and leg_goal <= int(Far.GOAL_MAX) and leg_goal == mini(int(Far.GOAL_MAX), Data.FIELD_GOAL_BASE + leg_base * Data.FIELD_GOAL_PER_LEVEL), "мета зачистки рахується від рідного рівня місця: %d, а не сотні" % leg_goal)

	# ---- Зараза не осідає на Башті й Глибинах ----
	var pw = WorldState.new()
	PS.state(pw)["levels"]["bashta"] = 3
	PS.state(pw)["levels"]["hlybyny"] = 2
	check(PS.level(pw, "bashta") == 0 and PS.level(pw, "hlybyny") == 0, "зараза на Башті й Глибинах не діє навіть зі старого збереження")
	PS.state(pw)["levels"].clear()
	PS.state(pw)["pressure"] = 50.0
	for i in 40:
		PS.tick(pw)
