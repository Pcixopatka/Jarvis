	p.change_class("cossack")
	p.level = 12
	p.stats["str"] = 80
	p.stats["vit"] = 80
	p.skills = {"whirl": 3}
	p.recalc()
	p.hp = p.max_hp
	p.gold = 5000
	game.world.hints = {"combat": true, "block": true, "elite": true, "city": true, "map": true, "boss": true, "item": true, "cleared": true, "ambush": true, "defense": true, "stones": true}
