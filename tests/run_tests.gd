	var art := ""
	for e in WS._entries("basics"):
		if str(e["title"]) == "Здобич із нечисті":
			art = str(e["text"])
	check("%d%%" % roundi(Camp.RESOURCE_DROP_CHANCE * 100.0) in art and "рівень/%d" % Camp.BUNDLE_LEVEL_STEP in art and "Вареник: %d%%" % roundi(Data.VARENYK_DROP_CHANCE * 100.0) in art and "0,6%" in art and "Золота річ" in art and "Душа" in art, "довідник називає всі шанси здобичі")
	var map_art := ""
	for e in WS._entries("map"):
		if str(e["title"]) == "Глибини зарази":
			map_art = str(e["text"])
	check("Стелі нема" in map_art and str(DS.level_of(150)) in map_art, "довідник пояснює, що Глибини не мають дна")
	# ---- У бою ----
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var p = game.player
	var w = game.world
	var c = game.combat
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "dungeon", "depths", "potion", "mana_potion", "varenyk", "res", "depths_open"]:
		w.hints[k] = true
	p.change_class("cossack")
	game._sync_class()
	p.level = 99
	p.stats["str"] = 5000
	p.stats["vit"] = 5000
	p.recalc()
	p.hp = p.max_hp
	_quests_set(w, "story", {"chapter": 6, "step": 0, "stage": "done", "progress": 0})
	# статистика падіння з рядових ворогів на 92-му рівні
	game.enter_location("wild_field")
	await _frames(3)
	_clear_enemies(game)
	await _frames(2)
	c.loc = c.loc.duplicate()
	c.loc["level"] = 92
	c.spawn_timer = 9999.0
	seed(4242)
	var kills := 600
	for i in kills:
		c.spawn_enemy("zarazhenyi", 92, false, p.global_position + Vector2(900, 0))
		var e = c._last_enemy()
		c._drop_loot(e)
		e.remove_from_group("enemies")
		e.free()
	var res_n := 0
	var pot_n := 0
	var var_n := 0
	for n in c.entities.get_children():
		if n.get_script() == c.PickupScript:
			if n.kind == "res" and str(n.item.get("res", "")) != Camp.TROPHY:
				res_n += int(n.value)
			elif n.kind == "potion":
				pot_n += 1
			elif n.kind == "varenyk":
				var_n += 1
	check(res_n > kills * 0.05 and res_n < kills * 0.17 and pot_n < kills * 0.03 and var_n < kills * 0.06, "із 600 рядових ворогів: ресурсів %d, зілля %d, вареників %d" % [res_n, pot_n, var_n])
	for n in c.entities.get_children():
		if n.get_script() == c.PickupScript:
			n.queue_free()
	await _frames(2)
	# еліта: трофей через раз, жменя за новою міркою
	seed(77)
	var trophies := 0
	var elite_res := 0
	for i in 200:
		c.spawn_enemy("zarazhenyi", 92, false, p.global_position + Vector2(900, 0))
		var e = c._last_enemy()
		e.make_elite(load("res://scripts/data/elites.gd").roll_affixes(92))
		c._drop_loot(e)
		e.remove_from_group("enemies")
		e.free()
	for n in c.entities.get_children():
		if n.get_script() == c.PickupScript and n.kind == "res":
			if str(n.item.get("res", "")) == Camp.TROPHY:
				trophies += int(n.value)
			else:
				elite_res += int(n.value)
	check(trophies > 60 and trophies < 140 and elite_res == 200 * 2 * Camp.bundle_amount(92), "із 200 еліт: трофеїв %d, ресурсів %d (по дві жмені з %d)" % [trophies, elite_res, Camp.bundle_amount(92)])
	game.enter_map()
	await _frames(2)
	# Глибина понад 99-й рівень: нечисть сильніша, здобич 99-го
	DS.state(w)["max"] = 80
	game.start_depth(60)
	await _frames(4)
	var foe = null
	for e in get_nodes_in_group("enemies"):
		if not e.is_boss and not e.elite:
			foe = e
	var L60: Dictionary = DS.loc_for(60)
	check(game.state == game.State.PLAYING and int(c.loc["level"]) == DS.level_of(60) and int(c.loc["level"]) > 99 and c.loot_level() == Data.ENDLESS_SOFT and foe != null and int(foe.level) == DS.level_of(60), "глибина 60 у бою: нечисть %d-го рівня, здобич %d-го" % [int(c.loc["level"]), c.loot_level()])
	c._drop_loot(foe)
	var item_lvls := []
	for i in 40:
		item_lvls.append(int(c._loot(c.loot_level(), 3)["ilvl"]))
	check(item_lvls.max() <= Data.ENDLESS_SOFT + 1, "речі з глибини не вищі за %d-й рівень" % Data.ENDLESS_SOFT)
	var fake_boss = null
	c.spawn_enemy(str(c.loc["boss"]), int(c.loc["level"]), true, p.global_position + Vector2(900, 0))
	fake_boss = c._last_enemy()
	p.u_luck = Uniq.LUCK_SURE
	var gold_item: Dictionary = load("res://scripts/game/loot_service.gd").on_boss(c, p, fake_boss)
	check(not gold_item.is_empty() and int(gold_item["ilvl"]) == Data.ENDLESS_SOFT and int(fake_boss.level) > 99, "золота річ із глибинного боса теж %d-го рівня" % Data.ENDLESS_SOFT)
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


func _suite_divine() -> void:
	suite("Божі дари: дев'ять речей у семи власних гніздах")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var Div = load("res://scripts/data/divine.gd")
	var DS = load("res://scripts/game/divine_service.gd")
	var SH = load("res://scripts/game/shop_service.gd")
	var Camp = load("res://scripts/game/camp_service.gd")
	var Classes = load("res://scripts/data/classes.gd")
	var GfxS = load("res://scripts/world/gfx.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var UD = load("res://scripts/ui/ui_divine.gd")
	# ---- Дані ----
	var data_ok := true
	var slots := {}
	for id in Div.ids():
		var D: Dictionary = Div.def(id)
		slots[D["slot"]] = id
		data_ok = data_ok and D["slot"] in Div.slots() and str(D["name"]) != "" and int(D["price"]) > 0 and GfxS.icon_tex(str(D["icon"])) != null and not D["lines"].is_empty() and id in Div.in_slot(D["slot"])
		for k in D.get("fx", {}):
			data_ok = data_ok and Classes.has_fx(k)
	var two := 0
	for sl in Div.slots():
		data_ok = data_ok and not Div.in_slot(sl).is_empty() and GameDB.table("gift_slots").has(sl)
		if Div.in_slot(sl).size() > 1:
			two += 1
	check(data_ok and slots.size() == Div.slots().size() and Div.ids().size() == 9 and Div.slots().size() == 7 and two == 2, "дев'ять дарів на сім гнізд: у двох гніздах вибір із двох")
	# ---- Купівля й гнізда ----
	var w = WorldState.new()
	var p = _new_player()
	p.change_class("cossack")
	p.level = 50
	p.stats["str"] = 100
	p.stats["agi"] = 60
	Camp.apply_effects(w, p)
	var bag0: int = p.bag_size()
	var str0: int = p.stat("str")
	var agi0: int = p.stat("agi")
	var dmg0: float = p.damage
	var pick0: float = p.pickup_radius
	var crit0: float = p.crit_mult
	check(not DS.buy(w, p, "mazha") and "бракує" in DS.block_reason(w, "mazha") and not DS.equip(w, p, "mazha") and p.divine.is_empty(), "без червінців дар не купити й не вдягнути")
	SH.state(w)["coins"] = 100000
	var TS = load("res://scripts/game/trade_service.gd")
	var Acts = load("res://scripts/data/activities.gd")
	var cap0: int = Acts.TRADE_CART + Acts.TRADE_CART_SKLAD * Camp.level(w, "sklad")
	check(TS.capacity(w) == cap0, "без дару віз для торгу звичайний: %d" % TS.capacity(w))
	check(DS.buy(w, p, "mazha") and DS.owned(w, "mazha") and DS.wears(p, "mazha") and int(Div.def("mazha")["bag"]) == 50 and p.bag_size() == bag0 + 50 and SH.coins(w) == 100000 - DS.price("mazha"), "Чумацький віз куплено: він у своєму гнізді, торба більша рівно на 50 (%d → %d)" % [bag0, p.bag_size()])
	check(p.inventory.is_empty() and DS.block_reason(w, "mazha") == "уже куплено", "дар не займає місця в торбі й удруге не продається")
	check(DS.buy(w, p, "kryla") and p.stat("str") == int(round(str0 * 1.1)) and p.stat("agi") == int(round(agi0 * 1.1)) and p.damage > dmg0 * 1.05, "крила: усі характеристики +10%% (Сила %d → %d)" % [str0, p.stat("str")])
	var dmg1: float = p.damage
	check(DS.buy(w, p, "molot") and p.damage > dmg1 * 1.11 and is_equal_approx(p.fx("dmg"), float(Div.def("molot")["fx"]["dmg"])) and is_equal_approx(p.crit_mult, crit0 + float(Div.def("molot")["fx"]["crit_dmg"]) / 100.0), "громовий молот: бойові показники ростуть")
	check(DS.buy(w, p, "khovanets") and is_equal_approx(p.pickup_radius, pick0 * (1.0 + float(Div.def("khovanets")["pickup"]))) and DS.remote_shop(p), "Хованець: радіус збору вп'ятеро більший, крамниця будь-де")
	check(p.divine.size() == 4 and p.inventory.is_empty(), "усі чотири гнізда зайнято, торба порожня")
	# ---- Зняти й вдягнути ----
	DS.unequip(w, p, "wings")
	check(p.stat("str") == str0 and not DS.wears(p, "kryla") and DS.owned(w, "kryla"), "зняті крила не діють, але лишаються в роду")
	check(DS.equip(w, p, "kryla") and p.stat("str") == int(round(str0 * 1.1)), "вдягнули знову")
	DS.unequip(w, p, "cart")
	check(p.bag_size() == bag0 and not DS.remote_shop(_new_player()), "без воза торба звичайна")
	DS.equip(w, p, "mazha")
	# ---- Чумацький віз: назва, тексти й місткість торгу ----
	var MD: Dictionary = Div.def("mazha")
	var mtext: String = (str(MD["name"]) + " " + str(MD["desc"]) + " " + " ".join(MD["lines"])).to_lower()
	check(str(MD["name"]) == "Чумацький віз" and not "маж" in mtext, "дар зветься «Чумацький віз», слова «мажа» нема в назві, описі й рядках")
	check(MD["lines"].size() == 3 and "50 місць" in str(MD["lines"][0]) and "торз" in str(MD["lines"][1]) and "50" in str(MD["lines"][1]) and int(MD["trade"]) == 50, "у властивостях дару бонуси торби й воза для торгу, по 50")
	check(int(MD.get("chest", 0)) == 50 and "скриня на хуторі більша на 50 місць" in MD["lines"], "у картці воза скриня роду більша на 50: «chest» і третій рядок")
	var wiki_maz := []
	for sec in WS.sections():
		for e in sec["entries"]:
			if "маж" in str(e).to_lower():
				wiki_maz.append(str(e.get("title", "")))
	check(wiki_maz.is_empty(), "у статтях довідника нема слова «мажа»: %s" % str(wiki_maz))
	check(TS.capacity(w) == cap0 + 50, "з вдягненим возом місткість торгу більша на 50: %d" % TS.capacity(w))
	DS.unequip(w, p, "cart")
	check(TS.capacity(w) == cap0, "зняв віз: місткість торгу знову %d" % cap0)
	DS.equip(w, p, "mazha")
	check(TS.capacity(w) == cap0 + 50, "вдягнув знову: знову більша на 50")
	var p_other = _new_player()
	Camp.apply_effects(w, p_other)
	check(p_other.divine.is_empty() and TS.capacity(w) == cap0, "інший герой роду без дару бонусу до воза не має")
	Camp.apply_effects(w, p)
	check(TS.capacity(w) == cap0 + 50, "знову граємо героєм із возом: бонус повернувся")
	# ---- Чумацький віз: місця в скрині роду ----
	var Account = load("res://scripts/game/account.gd")
	var acc = Account.new()
	var bag_cart: int = p.bag_size()
	var chest_on: int = acc.chest_size(w)
	DS.unequip(w, p, "cart")
	var chest_off: int = acc.chest_size(w)
	check(chest_on == chest_off + int(MD["chest"]) and chest_off == Account.CHEST_SIZE + Account.CHEST_PER_SKLAD * Camp.level(w, "sklad"), "з вдягненим возом скриня більша на 50 при тому самому Складі (%d → %d)" % [chest_off, chest_on])
	check(TS.capacity(w) == cap0 and p.bag_size() == bag_cart - 50, "зняв віз: торба й віз для торгу теж звичайні")
	Camp.state(w)["buildings"]["sklad"] = 2
	var sk_off: int = acc.chest_size(w)
	DS.equip(w, p, "mazha")
	check(acc.chest_size(w) == sk_off + 50 and TS.capacity(w) == Acts.TRADE_CART + Acts.TRADE_CART_SKLAD * 2 + 50 and p.bag_size() == bag_cart, "зі Складом 2 віз так само додає 50 місць скрині, а торба й торг діють як і були")
	Camp.state(w)["buildings"].erase("sklad")
	Camp.apply_effects(w, p_other)
	check(acc.chest_size(w) == chest_off, "інший герой роду без воза: скриня без надбавки")
	Camp.apply_effects(w, p)
	check(acc.chest_size(w) == chest_on, "знову граємо героєм із возом: скриня знову більша")
	# скриню заповнили понад меншу місткість, віз зняли: усе лишилось, класти не можна, брати можна
	var fill: int = chest_off + 10
	var put_ok := true
	for i in fill:
		put_ok = put_ok and acc.put_item(Data.gen_item(1, 0, "belt"), w)
	var uids: Array = []
	for it in acc.chest["items"]:
		uids.append(int(it["uid"]))
	check(put_ok and acc.chest["items"].size() == fill and not acc.chest_full(w), "з возом у скриню влізло %d речей, понад %d" % [fill, chest_off])
	DS.unequip(w, p, "cart")
	var still := true
	for i in uids.size():
		still = still and int(acc.chest["items"][i]["uid"]) == uids[i]
	check(acc.chest_size(w) == chest_off and acc.chest["items"].size() == fill and still, "віз зняли: скриня менша (%d), а всі %d речей на місці" % [acc.chest_size(w), fill])
	check(acc.chest_full(w) and not acc.put_item(Data.gen_item(1, 0, "belt"), w) and acc.chest["items"].size() == fill, "понад місткість класти не можна")
	var took: Dictionary = acc.take_item(uids[0])
	check(not took.is_empty() and acc.chest["items"].size() == fill - 1, "брати зі скрині можна")
	for i in range(1, 11):
		acc.take_item(uids[i])
	check(acc.chest["items"].size() == chest_off - 1 and not acc.chest_full(w) and acc.put_item(Data.gen_item(1, 0, "belt"), w), "забрали досить речей: класти знову можна")
	var chest_txt := ""
	for sec in WS.sections():
		for e in sec["entries"]:
			if str(e.get("title", "")) == "Скриня":
				chest_txt = str(e["text"])
	check(("Чумацький віз додає ще %d місць, поки він вдягнений на героєві, яким граєш." % int(MD["chest"])) in chest_txt, "у довіднику «Скриня» сказано про 50 місць від воза")
	DS.equip(w, p, "mazha")
	# крам понад стару місткість; дар зняли, вантаж лишився
	var wt = WorldState.new()
	var pt = _new_player()
	pt.level = 10
	pt.gold = 10000000
	SH.state(wt)["coins"] = 100000
	Camp.apply_effects(wt, pt)
	DS.buy(wt, pt, "mazha")
	var got := 0
	for g in Acts.trade_good_ids():
		got += TS.buy(wt, pt, "sich", g, Acts.TRADE_STOCK - 1)
	check(got > Acts.TRADE_CART and TS.cargo_count(wt) == got and got <= TS.capacity(wt), "з возом куплено %d одиниць краму, понад стару місткість %d" % [got, Acts.TRADE_CART])
	DS.unequip(wt, pt, "cart")
	var g_left: String = Acts.trade_good_ids()[0]
	var gold_t: int = pt.gold
	check(TS.capacity(wt) == Acts.TRADE_CART and TS.cargo_count(wt) == got and TS.free_space(wt) == 0, "дар зняли: вантаж цілий (%d), вільного місця 0, а не від'ємне" % TS.cargo_count(wt))
	check(TS.stock_left(wt, "sich", g_left) > 0 and not TS.can_buy(wt, pt, "sich", g_left) and TS.buy(wt, pt, "sich", g_left, 1) == 0 and pt.gold == gold_t and TS.cargo_count(wt) == got, "поки вантаж більший за віз, докупити не можна")
	for g in Acts.trade_good_ids():
		TS.sell(wt, pt, "sich", g, 99)
	check(TS.cargo_count(wt) == 0 and TS.free_space(wt) == Acts.TRADE_CART and TS.buy(wt, pt, "sich", g_left, 1) == 1, "продав, і купувати знову можна")
	# ---- Рід і збереження ----
	var p2 = _new_player()
	p2.change_class("cossack")
	check(DS.equip(w, p2, "molot") and p2.divine.size() == 1 and p2.fx("dmg") > 0.0, "інший герой роду вдягає куплене без оплати")
	var p3 = _new_player()
	p3.from_dict(p.to_dict())
	Camp.apply_effects(w, p3)
	check(p3.divine.size() == 4 and p3.bag_size() == p.bag_size() and DS.remote_shop(p3) and p3.fx("dmg") > 0.0, "вдягнені дари зберігаються з героєм і діють після завантаження")
	Camp.apply_effects(WorldState.new(), p3)
	check(p3.divine.is_empty() and p3.bag_size() == Data.INVENTORY_SIZE and not DS.remote_shop(p3) and p3.fx("dmg") == 0.0, "у роду без цих дарів вони знімаються")
	# ---- Нові дари: вибір у гнізді й нові гнізда ----
	var w5 = WorldState.new()
	var p5 = _new_player()
	p5.change_class("cossack")
	p5.level = 50
	SH.state(w5)["coins"] = 100000
	Camp.apply_effects(w5, p5)
	var sp0: float = p5.speed
	var xp0: float = p5.xp_mult
	var gm0: float = p5.gold_mult
	DS.buy(w5, p5, "khovanets")
	check(DS.buy(w5, p5, "skakun") and DS.worn(p5, "pet") == "skakun" and not DS.remote_shop(p5) and DS.owned(w5, "khovanets") and is_equal_approx(p5.speed, sp0 * 1.2), "скакун стає в гніздо «Супутник» замість Хованця: біг +20%, Хованець лишився в роду")
	check(DS.equip(w5, p5, "khovanets") and DS.remote_shop(p5) and is_equal_approx(p5.speed, sp0) and p5.divine.size() == 1, "назад на Хованця: у гнізді завжди один дар")
	DS.buy(w5, p5, "molot")
	check(DS.buy(w5, p5, "ladanka") and DS.worn(p5, "relic") == "ladanka" and p5.fx("dmg") == 0.0 and is_equal_approx(float(p5.divine_fx["revive"]), 0.5), "ладанка лягає в гніздо «Реліквія» замість молота")
	check(DS.buy(w5, p5, "nimb") and is_equal_approx(p5.xp_mult, xp0 + 5.0) and is_equal_approx(p5.gold_mult, gm0 + 5.0), "німб: досвід і гривні +500%% (множники %.2f і %.2f)" % [p5.xp_mult, p5.gold_mult])
	# з Німбом та сама нагорода вшестеро більша, якщо інших надбавок нема
	var pn0 = _new_player()
	Camp.apply_effects(w5, pn0)
	var pn1 = _new_player()
	pn1.divine = {"halo": "nimb"}
	Camp.apply_effects(w5, pn1)
	pn0.gold = 0
	pn1.gold = 0
	pn0.add_gold(100)
	pn1.add_gold(100)
