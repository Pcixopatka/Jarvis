	var w = game.world
	game.enter_map()
	await _frames(2)
	check(p.level == 1 and game.state == game.State.MAP, "герой 1-го рівня на мапі")
	# ---- Вхід ----
	game.enter_location("zmii_cave")
	await _frames(2)
	check(game.state == game.State.MAP and not game.combat.active and game.map_here == "zmii_cave" and str(game.hud.last_banner.get("text", "")) == "Змієва печера: ще зарано. Відкриється з 7-го рівня героя.",
		"Game.enter_location не пускає в закриту печеру, герой на мапі біля входу: %s" % str(game.hud.last_banner.get("text", "")))
	game.enter_location("oleshky")
	await _frames(2)
	check(game.state == game.State.MAP and not game.combat.active and str(game.hud.last_banner.get("text", "")) == "Олешківські піски: ще зарано. Відкриється з 2-го рівня героя.", "і в закрите поле")
	game.enter_city("sich")
	await _frames(2)
	game.enter_location("zmii_cave")
	await _frames(2)
	check(game.state == game.State.MAP and not game.combat.active, "з міста теж не пускає: герой виходить на мапу")
	game.enter_location("rapids")
	await _frames(2)
	check(game.state == game.State.PLAYING and game.combat.active and game.combat.loc_id == "rapids", "у поле на три рівні вище — пускає")
	game.enter_map()
	await _frames(2)
	# ---- Мапа ----
	var mv = game.hud.map_view
	var locked := []
	for id in Data.place_ids():
		if mv.is_locked(id):
			locked.append(id)
	check(mv.is_locked("zmii_cave") and mv.is_locked("oleshky") and not mv.is_locked("rapids") and not mv.is_locked("wild_field") and not mv.is_locked("bashta") and not mv.is_locked("hlybyny"),
		"мапа малює закритим Змієву печеру й Олешківські піски, а Дніпрові пороги, Дике Поле, Башту й Глибини — ні (закритих: %d)" % locked.size())
	check(mv.is_locked("varta") == (p.level < int(game.Acts.spot("varta")["level"])) and mv.LOCKED_RING == Color(mv.INK, 0.4) and mv.LOCKED_ICON == Color(1, 1, 1, 0.45) and mv.LOCKED_LABEL == Color(mv.INK, 0.5), "один вигляд для закритого місця й закритого місця занять")
	# ---- Панель ----
	var panel: Control = MP.build("oleshky", w, p, func(_id): pass)
	var t: String = _texts_under(panel)
	check("Відкриється з 2-го рівня героя." in t and not "Вирушити" in t and "Олешківські піски" in t, "панель закритого поля: «Відкриється з 2-го рівня героя.», кнопки входу нема")
	panel.free()
	panel = MP.build("zmii_cave", w, p, func(_id): pass)
	t = _texts_under(panel)
	check("Відкриється з 7-го рівня героя." in t and not "Вирушити" in t, "панель закритої печери: «Відкриється з 7-го рівня героя.»")
	panel.free()
	panel = MP.build("rapids", w, p, func(_id): pass)
	check("Вирушити" in _texts_under(panel), "панель відкритого поля — з кнопкою «Вирушити»")
	panel.free()
	# ---- Узяте раніше: старе завдання в закрите місце ----
	w.quests.append({"id": 990, "city": "sich", "loc": "zmii_cave", "type": "dungeon", "target": "zmii_cave", "count": 1, "progress": 0, "text": "Очисти: Змієва печера", "gold": 1, "xp": 1, "loyalty": 1, "lvl": 7})
	game.enter_map()
	await _frames(2)
	check(not mv.is_locked("zmii_cave"), "мапа: місце, куди веде вже взяте, не бліде")
	panel = MP.build("zmii_cave", w, p, func(_id): pass)
	check("Вирушити" in _texts_under(panel), "і панель пускає")
	panel.free()
	game.enter_location("zmii_cave")
	await _frames(2)
	check(game.state == game.State.PLAYING and game.combat.loc_id == "zmii_cave", "узяте до цієї версії завдання доводиться до кінця: у печеру пускає")
	game._on_dungeon_cleared("zmii_cave")
	await _frames(1)
	check(w.is_done(w.quests[-1]), "печеру зачищено — завдання виконано")
	game.enter_map()
	await _frames(2)
	check(mv.is_locked("zmii_cave"), "виконане — і печера знову закрита")
	w.quests.clear()
	# ---- Дошка оголошень і розшук: сірі ----
	p.level = BS.MIN_LEVEL
	w.hero_level = p.level
	w.boards["sich"] = [{"id": 991, "city": "sich", "loc": "zmii_cave", "type": "dungeon", "target": "zmii_cave", "count": 1, "progress": 0, "text": "Очисти: Змієва печера", "gold": 1, "xp": 1, "loyalty": 1, "lvl": 7},
		{"id": 992, "city": "sich", "loc": "rapids", "type": "kill", "target": "mavka", "count": 3, "progress": 0, "text": "Знищ мавок (Дніпрові пороги)", "gold": 1, "xp": 1, "loyalty": 1, "lvl": 4},
		{"id": 993, "city": "sich", "loc": "perekop", "type": "kill", "target": "mavka", "count": 3, "progress": 0, "text": "Знищ мавок (Перекоп)", "gold": 1, "xp": 1, "loyalty": 1, "lvl": 6}]
	var qv: Control = UiCity._quests(game, "sich")
	t = _texts_under(qv)
	check(t.count(UiCity.HALL_WAIT % 7) == 1 and t.count("Взяти") == 2 and "Очисти: Змієва печера" in t, "дошка: завдання в Змієву печеру висить сірим із «Ще зарано: приходь із 7-го рівня», решта — «Взяти»")
	var grey_ok := false
	for l in qv.find_children("*", "Label", true, false):
		if l.text == "Очисти: Змієва печера":
			grey_ok = l.get_theme_color("font_color") == game.UI.MUTED
	check(grey_ok, "рядок закритого завдання сірий")
	qv.free()
	game.enter_city("sich")
	await _frames(2)
	game.city_do("take", 991)
	await _frames(1)
	check(w.quests.is_empty(), "«Ще зарано» не береться й через city_do")
	var bs: Dictionary = BS.state(w)
	bs["age"] = 0
	bs["boards"]["sich"] = {"born": 0, "list": [{"id": 61, "city": "sich", "kind": "vovkulaka", "name": "Сірий Лютий", "loc": "kamiani_mohyly", "affixes": ["fiery", "iron"], "gold": 1, "glory": 6, "killed": false}]}
	var bv: Control = UiCity._bounty_tab(game, "sich")
	t = _texts_under(bv)
	check((UiCity.HALL_WAIT % 5) in t and not "Взяти" in t and "Сірий Лютий" in t, "розшук: ціль у Кам'яних Могилах (з 5-го) висить сірою з відмовою")
	bv.free()
	game.city_do("bounty_take", 61)
	await _frames(1)
	check(bs["active"].is_empty(), "і не береться")
	# ---- Наставник ----
	p.change_class("cossack")
	game._sync_class()
	p.job_level = int(p.class_info()["change_at"])
	p.level = 27
	w.hero_level = 27
	var mv2: Control = UiCity._mentors(game, "sich")
	t = _texts_under(mv2)
	check((UiCity.HALL_WAIT % 28) in t and (UiCity.HALL_WAIT % 29) in t, "наставники на Січі: запорожець — «приходь із 28-го», характерник — «приходь із 29-го»")
	mv2.free()
	game.city_do("spec_start", "zaporozhets")
	await _frames(1)
	check(w.spec_trial.is_empty(), "наставник випробування не дає")
	p.level = 29
	w.hero_level = 29
	mv2 = UiCity._mentors(game, "sich")
	t = _texts_under(mv2)
	check(not "Ще зарано" in t and t.count("Випробування") >= 3, "з 29-го всі три випробування на Січі можна взяти")
	mv2.free()
	game.hud.close_dialogue()
	game.leave_city()
	await _frames(2)
	game.queue_free()
	await _frames(2)


func _suite_place_levels() -> void:
	suite("Рівні місць і ступені золота")
	var Far = load("res://scripts/game/far_service.gd")
	var Q = load("res://scripts/game/quest_engine.gd")
	var Uniques = load("res://scripts/data/uniques.gd")
	var Way = load("res://scripts/game/way_service.gd")
	var EBs = load("res://scripts/game/events_board.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	# ---- Хто росте з героєм ----
	var bad_fields := []
	var bad_caves := []
	var levels := {}
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		if L["type"] == "field":
			levels[int(L["level"])] = true
			if L.has("scale"):
				bad_fields.append(id)
		elif L.has("boss") and not L.get("endless", false) and not L.has("peril") and not L.get("scale", false):
			bad_caves.append(id)
		elif (L.get("endless", false) or L.has("peril")) and L.has("scale"):
			bad_caves.append(id)
	check(bad_fields.is_empty(), "жодне поле не має «scale»: %s" % str(bad_fields))
	check(bad_caves.is_empty(), "кожна печера з босом росте з героєм; Башта, Глибини й надважкі печери — ні: %s" % str(bad_caves))
	# ---- Рівні полів: від 1 до 80 без прогалин понад два рівні, нижче 20-го — не більше одного ----
	var lv: Array = levels.keys()
	lv.sort()
	var gaps := []
	var prev := 0
	for l in lv + [80]:
		var limit := 2 if l < 20 else 3
		if prev > 0 and l - prev > limit:
			gaps.append("%d→%d" % [prev, l])
		prev = l
	check(int(lv[0]) == 1 and int(lv[-1]) >= 77 and gaps.is_empty(), "поля закривають рівні 1–80: прогалин нема (%s), рівні %s" % [str(gaps), str(lv)])
	var fixed_ok := true
	var grow_ok := true
	var any = _new_player()
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		for h in [1, int(L["level"]), int(L["level"]) + 30, 99]:
			any.level = h
			if L["type"] == "field":
				fixed_ok = fixed_ok and Data.loc_level(L, h) == int(L["level"]) and not Far.mods(L, any).has("level")
			elif L.get("scale", false):
				grow_ok = grow_ok and Data.loc_level(L, h) == maxi(int(L["level"]), h)
	any.free()
	check(fixed_ok, "поле на будь-якому рівні героя б'ється на своєму рівні")
	check(grow_ok, "печера з босом б'ється на max(рівень печери, рівень героя)")
	# ---- Місія підтягує бій у нижчому полі до свого рівня ----
	var w = WorldState.new()
	var hero = _new_player()
	hero.level = 50
	Q.start(w, "lykho_1")
	var fm: Dictionary = Q.fight_mods(w, hero, "tarkhankut")
	check(int(Data.place("tarkhankut")["level"]) < 48 and int(fm.get("level", 0)) == int(Q.step("lykho_1")["min_level"]) and int(fm.get("base_level", 0)) == int(Data.place("tarkhankut")["level"]), "місія в нижчому полі: бій на рівні місії (%s)" % str(fm.get("level", "")))
	hero.free()
	# ---- Мета зачистки: одне правило для всіх полів, не більше far.goal_max ----
	var QS = load("res://scripts/game/quick_service.gd")
	var goal_bad := []
	var gw = WorldState.new()
	var gh = _new_player()
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		if L["type"] != "field":
			continue
		var want: int = int(L["goal"]) if L.has("goal") else mini(Far.GOAL_MAX, Data.FIELD_GOAL_BASE + int(L["level"]) * Data.FIELD_GOAL_PER_LEVEL)
		for h in [1, int(L["level"]), int(L["level"]) + 30, 99]:
			gh.level = h
			var raised: Dictionary = Q.raise_mods(id, h + 5, gh)
			var night: Dictionary = Far.night_mods(L, gh)
			if Data.field_goal(L) != want or QS.kills(L) != want or (not raised.is_empty() and int(raised["goal"]) != want) or night.has("goal") or Far.mods(L, gh).has("goal") or (not L.has("goal") and want > Far.GOAL_MAX):
				goal_bad.append("%s@%d" % [id, h])
	gh.free()
	check(goal_bad.is_empty() and Far.GOAL_MAX == 110, "мета зачистки поля не більша за %d на будь-якому рівні героя, однакова в бою, швидкому поході, місії й уночі: %s" % [Far.GOAL_MAX, str(goal_bad)])
	check(Data.place("ridne_selo").has("goal") and Data.field_goal(Data.place("ridne_selo")) == int(Data.place("ridne_selo")["goal"]) and QS.kills(Data.place("ridne_selo")) == int(Data.place("ridne_selo")["goal"]), "явна мета «goal» у записі місця й далі головна (Рідне село: %d)" % Data.field_goal(Data.place("ridne_selo")))
	check(Data.field_goal(Data.place("smolensk_road")) == 110 and Data.field_goal(Data.place("mozhaisk")) == 110 and Data.field_goal(Data.place("kamianets_walls")) == 110, "Смоленський шлях, Можайські болота й Кам'янецькі мури: 110 нечисті, а не 405, 420 і 210")
	# ---- Ступені золота йдуть за рівнями босів ----
	var band := func(lvl: int) -> int:
		return 1 if lvl <= 17 else (2 if lvl <= 32 else (3 if lvl <= 50 else (4 if lvl <= 63 else 5)))
	var tier_bad := []
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		if L["type"] == "dungeon" and L.get("scale", false):
			if GameDB.boss_tier(str(L["boss"])) != band.call(int(L["level"])):
				tier_bad.append("%s %d → %d" % [L["boss"], int(L["level"]), GameDB.boss_tier(str(L["boss"]))])
		elif L.has("peril") and GameDB.boss_tier(str(L["boss"])) != Uniques.max_tier():
			tier_bad.append(str(L["boss"]))
	check(tier_bad.is_empty(), "ступінь боса за рівнем його печери (до 17-го — 1, 21–32 — 2, 38–50 — 3, 54–63 — 4, 70–80 — 5, надважкі — 6): %s" % str(tier_bad))
	var chain_tiers := []
	for arc in CHAIN_ARCS:
		var loc := str(Q.step(str(arc[2])).get("objective", {}).get("loc", ""))
		if Data.is_place(loc) and Data.place(loc).has("boss"):
			chain_tiers.append(GameDB.boss_tier(str(Data.place(loc)["boss"])))
	var sorted_tiers := chain_tiers.duplicate()
	sorted_tiers.sort()
	check(chain_tiers.size() >= 15 and chain_tiers == sorted_tiers, "уздовж ланцюжка історії ступінь боса не спадає: %s" % str(chain_tiers))
	var item_bad := []
	var own := {}
	var t_slots := {}
	for id in Uniques.ids():
		var D: Dictionary = Uniques.def(id)
		for b in D["bosses"]:
			own[b] = int(own.get(b, 0)) + 1
			if GameDB.boss_tier(b) != int(D["tier"]):
				item_bad.append("%s/%s" % [id, b])
		var t := int(D["tier"])
		if not t_slots.has(t):
			t_slots[t] = {}
		t_slots[t][str(D["type"]) if D["slot"] == "weapon" else str(D["slot"])] = true
	check(item_bad.is_empty(), "ступінь кожної золотої речі — ступінь її босів: %s" % str(item_bad))
	var lonely := []
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		if L.has("boss") and not L.get("endless", false) and int(own.get(str(L["boss"]), 0)) < 1:
			lonely.append(str(L["boss"]))
	var spread_ok := true
	for t in range(1, Uniques.max_tier() + 1):
		spread_ok = spread_ok and t_slots.has(t) and t_slots[t].size() >= 4
	check(lonely.is_empty() and spread_ok, "кожен бос лігва має свою золоту річ, у кожному ступені щонайменше чотири види речей: %s" % str(lonely))
	# ---- Покриття ступенів: зброя для кожної лінії класів у ступенях 1–5, усі клітинки у двох верхніх ----
	# Лінія — головний клас (козак, волхв, стрілець) зі своєю зброєю й головною рисою (SetService.main_stat).
	var Classes = load("res://scripts/data/classes.gd")
	var lines := {"cossack": "str", "volkhv": "spi", "strilets": "agi"}
	var cover_bad := []
	for t in range(1, Uniques.TOP_COMMON_TIER + 1):
		var have: Dictionary = t_slots.get(t, {})
		for ln in lines:
			var any_w := false
			for wt in Classes.info(ln)["weapons"]:
				any_w = any_w or have.has(wt)
			if not any_w:
				cover_bad.append("%d: зброя лінії %s" % [t, ln])
		if t >= Uniques.TOP_COMMON_TIER - 1:
			for s in Data.slots():
				if s != "weapon" and not have.has(s):
					cover_bad.append("%d: %s" % [t, s])
	check(cover_bad.is_empty(), "у кожному ступені 1–%d є золота зброя для козака, волхва й стрільця, у двох верхніх — річ для кожної клітинки: %s" % [Uniques.TOP_COMMON_TIER, str(cover_bad)])
	# Боси двох верхніх ступенів найчастіше дають щось кожній лінії: її зброю або річ із її головною рисою
	var fav_bad := []
	for b in own:
		if GameDB.boss_tier(b) < Uniques.TOP_COMMON_TIER - 1 or GameDB.boss_tier(b) > Uniques.TOP_COMMON_TIER:
			continue
		for ln in lines:
			var found := false
			for id in Uniques.ids():
				var D: Dictionary = Uniques.def(id)
				if not b in D["bosses"]:
					continue
				if D["slot"] == "weapon":
					found = found or str(D["type"]) in Classes.info(ln)["weapons"]
				else:
					found = found or D["affixes"].has(lines[ln])
			if not found:
				fav_bad.append("%s: %s" % [b, ln])
	check(fav_bad.is_empty(), "кожен бос ступенів %d–%d найчастіше дає щось козакові, волхвові й стрільцю: %s" % [Uniques.TOP_COMMON_TIER - 1, Uniques.TOP_COMMON_TIER, str(fav_bad)])
	# ---- Ступінь золота для героя: той, що дають боси його рівня (ярмарок і бос тижня) ----
	var floors: Dictionary = Uniques.tier_floors()
	var floors_ok: bool = floors.size() == Uniques.TOP_COMMON_TIER and not floors.has(Uniques.max_tier())
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		if L["type"] == "dungeon" and L.get("scale", false):
			floors_ok = floors_ok and int(L["level"]) >= int(floors.get(GameDB.boss_tier(str(L["boss"])), 999))
	check(floors_ok and floors == {1: 7, 2: 21, 3: 38, 4: 54, 5: 70}, "межі ступенів — найнижчий рівень босів кожного ступеня: %s" % str(floors))
	var BossS = load("res://scripts/game/boss_service.gd")
	var FairS = load("res://scripts/game/fair_service.gd")
	var edge_bad := []
	for pair in [[1, 1], [20, 1], [21, 2], [37, 2], [38, 3], [53, 3], [54, 4], [69, 4], [70, 5], [79, 5], [99, 5], [140, 5]]:
		var got: Array = [Uniques.hero_tier(pair[0]), FairS.top_tier(pair[0]), BossS.weekly_tier(pair[0])]
		if got != [pair[1], pair[1], pair[1]]:
			edge_bad.append("%d → %s" % [pair[0], str(got)])
	for lvl in range(1, 100):
		var want := 1
		for t in floors:
			if lvl >= int(floors[t]):
				want = maxi(want, int(t))
		if Uniques.hero_tier(lvl) != want:
			edge_bad.append("%d" % lvl)
	check(edge_bad.is_empty(), "герой до 20-го рівня — перший ступінь, з 21-го — другий, з 38-го — третій, з 54-го — четвертий, з 70-го — п'ятий; ярмарок і бос тижня так само: %s" % str(edge_bad))
	# Ярмарок і бос тижня на межі смуг справді дають ступінь босів рівня героя
	var CSv = load("res://scripts/game/challenge_service.gd")
	var now0 = CSv.now_override
	var fair_bad := []
	var fh = _new_player()
	fh.change_class("strilets")
	for lvl in [20, 21, 53, 54, 69, 70, 79]:
		fh.level = lvl
		var want: int = Uniques.hero_tier(lvl)
		for wk in 6:
			CSv.now_override = 1800000000 + wk * 7 * 86400
			for e in FairS.stock(fh):
				if e["kind"] == "unique" and (int(e["tier"]) > want or int(e["tier"]) < maxi(1, want - 1)):
					fair_bad.append("%d: %s %d" % [lvl, e["id"], int(e["tier"])])
	CSv.now_override = now0
	check(fair_bad.is_empty(), "ярмарок привозить золото ступеня босів рівня героя й на один нижчого (герой 70-го — п'ятий ступінь, не четвертий): %s" % str(fair_bad))
	var week_bad := []
	var ww = WorldState.new()
	for lvl in [20, 21, 54, 69, 70]:
		for i in 25:
			fh.level = lvl  # досвід із боса міг підняти рівень (річ рахується вже після досвіду)
			fh.xp = 0
			fh.inventory = []
			ww.boss_hunt = {}
			var rw: Dictionary = BossS.on_win(ww, fh, "week", 100.0)
			for it in rw["items"]:
				if it.has("unique") and int(Uniques.def(str(it["unique"]))["tier"]) > Uniques.hero_tier(lvl):
					week_bad.append("%d: %s" % [lvl, it["unique"]])
	var top70 := false
	fh.level = 70
	for i in 200:
		var uid: String = load("res://scripts/game/loot_service.gd").pick(fh, BossS.weekly_tier(70), "pushkar")
		top70 = top70 or int(Uniques.def(uid)["tier"]) == 5
	fh.free()
	check(week_bad.is_empty() and top70, "бос тижня дає золото не вище ступеня босів рівня героя, а героєві 70-го — і п'ятого: %s" % str(week_bad))
	# ---- Правила далеких країв тримаються за край ----
	var far_ok := true
	for id in Data.place_ids():
		far_ok = far_ok and Far.is_far(Data.place(id)) == Data.place(id).has("region")
	var dlow = _new_player()
	dlow.level = 99
	var cave: String = Way._dungeon(dlow)
	dlow.free()
	var far_lvl: int = w.hero_level
	w.hero_level = 99  # подія «Далекі краї» показує лише відкриті героєві далекі місця
	var far_place: String = EBs.place("far", w, "sich")
	w.hero_level = far_lvl
	check(far_ok and Data.place(far_place).has("region") and cave != "" and not Data.place(cave).has("region") and Far.open_level("pivden") == 5, "далеке місце — те, що має край: подія «Далекі краї», печера «Шляху козака» (%s), відкриття краю" % cave)
	# ---- Нагороди: річ на рівень вища за місце кроку ----
	var reward_bad := []
	for t in ["story", "legend_steps"]:
		for sid in GameDB.ids(t):
			var st: Dictionary = GameDB.row(t, sid)
			if not st.get("reward", {}).has("item"):
				continue
			var loc := str(st.get("objective", {}).get("loc", ""))
			if Data.is_place(loc) and int(st["reward"]["item"]["ilvl"]) != int(Data.place(loc)["level"]) + 1:
				reward_bad.append(sid)
	check(reward_bad.is_empty(), "річ у нагороду історії й переказу — на рівень вища за місце кроку: %s" % str(reward_bad))
	# ---- Наявна золота річ дістає головний бонус нового ступеня ----
	var old_it: Dictionary = Uniques.make("shablia_sirka", 40)
	old_it["base"]["flat_dmg"] = float(old_it["base"]["flat_dmg"]) / Uniques.tier_mult(5) * Uniques.tier_mult(4)  # як було за четвертого ступеня
	old_it["up"] = 3
	var saved := {"player": {"inventory": [old_it], "equipment": {"weapon": Uniques.make("bulava_mazepy", 50)}}, "world": {"shops": {}}}
	var n1: int = SaveSystem.refresh_golden(saved)
	var n2: int = SaveSystem.refresh_golden(saved)
	check(n1 == 1 and n2 == 0 and saved["player"]["inventory"][0]["base"] == Uniques.make("shablia_sirka", 40)["base"] and int(saved["player"]["inventory"][0]["up"]) == 3 and saved["player"]["inventory"][0]["affixes"] == Uniques.make("shablia_sirka", 40)["affixes"], "золота річ зі старого збереження: головний бонус за нинішнім ступенем, заточка й властивості ті самі")
	# ---- Довідник ----
	var titles := {}
	for sx in WS.sections():
		for e in sx["entries"]:
			titles[str(e["title"])] = str(e["text"])
	check(titles.has("Рівень місця") and "сталий рівень" in titles["Рівень місця"] and "росте разом із героєм" in titles["Рівень місця"] and "«21+»" in str(titles.get("Мапа й дорога", "")), "довідник пояснює: поле сталого рівня, печера з босом росте з героєм, «21+» на мапі")
	check("«Сотницька» — боси 7–17-го рівня" in str(titles.get("Ступені золота", "")) and "«Характерницька» — боси 70–80-го рівня" in str(titles.get("Ступені золота", "")), "довідник: ступені золота за рівнями босів")



func _suite_far_lands_game() -> void:
	suite("Далекі краї: у грі")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var p = game.player
	var c = game.combat
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones"]:
		game.world.hints[k] = true
	p.change_class("cossack")
	p.level = 60
	p.stats["str"] = 120
	p.stats["vit"] = 150
	p.recalc()
	p.hp = p.max_hp
	_quests_set(game.world, "story", {"chapter": 4, "step": 0, "stage": "active", "progress": 0})
	# Поле далекого краю має сталий рівень: і героєві 60-го рівня там нечисть 5-го
	game.enter_location("oleshky")
	await _frames(3)
	check(c.is_field() and int(c.loc["level"]) == 5 and not c.loc.has("base_level") and not c.loc.has("hero_level") and not c.loc.has("std_hp") and c.field_goal == 65 and c.ground.biome == "sand", "Олешківські піски: поле 5-го рівня й для героя 60-го, мета 65, піщана земля")
	var e0 = null
	for e in c.get_tree().get_nodes_in_group("enemies"):
		if e.kind in Data.place("oleshky")["enemies"]:
			e0 = e
			break
	check(e0 != null and e0.level == 5, "нечисть поля — рівно його рівня")
	# Сила нечисті — звичайна мірка її рівня; юрба мала й не росте з рівнем героя
	var std_foe = null
	for e in c.get_tree().get_nodes_in_group("enemies"):
		if not e.elite and not e.is_boss and e.level == 5:
			std_foe = e
			break
	var plain_foe = load("res://scripts/entities/enemy.gd").new()
	if std_foe != null:
		plain_foe.setup(std_foe.kind, 5, false)
	var pl_hp: float = float(c.plague_mods["hp"]) if c.plague > 0 else 1.0
	check(std_foe != null and is_equal_approx(std_foe.raw_hp, plain_foe.max_hp) and is_equal_approx(std_foe.max_hp, plain_foe.max_hp * pl_hp), "нечисть краю має звичайну силу свого рівня, без окремої мірки")
	plain_foe.free()
	check(c._field_cap() == c.FIELD_ALIVE_BASE + mini(5, c.PACE_MAX) / c.FIELD_ALIVE_STEP and c._field_cap() <= 8, "юрба в полі мала (%d водночас) і рахується від рівня поля, а не героя" % c._field_cap())
	var crowd_max := 0
	for i in 400:
		p.hp = p.max_hp
		p.invuln = 1.0
		crowd_max = maxi(crowd_max, c.alive_enemy_count())
		await process_frame
	check(crowd_max <= c._field_cap() + 1 and crowd_max >= 3, "на арені не більше нечисті, ніж дозволяє межа (%d)" % crowd_max)
	# Зона удару зникає разом із ворогом, що її кинув (раніше спрацьовувала й кликала вже зниклого ворога)
	c.spawn_enemy("zarazhenyi", 40, false, p.global_position + Vector2(500, 0))
	var caster = c._last_enemy()
	var fired := [false]
	var zone = caster._telegraph("circle", p.global_position + Vector2(1200, 0), 0.3, 1.0)
	zone.on_fire = func(): fired[0] = true
	caster.queue_free()
	await _frames(30)
	check(not is_instance_valid(zone) and not fired[0], "зона удару зниклого ворога скасовується й не б'є")
	# Злидень краде гривні й повертає, коли його здолати
	_clear_enemies(game)
	await _frames(1)
	p.gold = 1000
	c.spawn_enemy("zlyden", 40, false, p.global_position + Vector2(60, 0))
	var z = c._last_enemy()
	z.on_hit(p)
	var stolen: int = z.loot_gold
	check(stolen > 0 and p.gold == 1000 - stolen, "злидень поцупив %d грн" % stolen)
	var g_before: int = p.gold
	z.take_damage(z.max_hp * 5.0, Vector2.ZERO)
	await _frames(3)
	check(p.gold >= g_before + stolen, "здолав злидня — крадене повернулось")
	# Юрба не росте безмежно з рівнем героя
	_clear_enemies(game)
	p.level = 99
	p.recalc()
	p.hp = p.max_hp
	game.enter_location("savur_mohyla")
	await _frames(2)
	check(c._pace_level() == mini(int(Data.place("savur_mohyla")["level"]), c.PACE_MAX) and int(c.loc["level"]) == int(Data.place("savur_mohyla")["level"]) and c.field_goal == 110, "на 99-му рівні поле лишається свого рівня, темп юрби — за ним (%d), мета %d" % [c._pace_level(), c.field_goal])
	var most := 0
	for i in 900:
		p.hp = p.max_hp
		p.invuln = 1.0
		await process_frame
		most = maxi(most, c.alive_enemy_count())
	check(most <= 7 + c.PACE_MAX, "на арені щонайбільше %d нечисті (було %d)" % [7 + c.PACE_MAX, most])
	game.enter_map()
	await _frames(2)
	# Нові боси: прийоми, друга фаза, перемога
	p.level = 50
	p.recalc()
	for pair in [["zmiinyi", "morskyi_tsar"], ["bakhmut_kopalni", "shubin"], ["pidhirtsi", "bila_pani"]]:
		game.enter_location(pair[0])
		await _frames(3)
		_clear_enemies(game)
		await _frames(1)
		c.room = int(c.loc["rooms"])
		c._spawn_room()
		await _frames(2)
		var boss = null
		for e in c.get_tree().get_nodes_in_group("enemies"):
			if e.is_boss:
				boss = e
		check(boss != null and boss.kind == pair[1] and int(boss.level) == p.level, "%s: у залі чекає %s (є: %s, рівень %s, кімната %d із %d)" % [pair[0], pair[1], boss.kind if boss else "нікого", str(boss.level) if boss else "-", c.room, int(c.loc.get("rooms", 0))])
		if boss == null:
			continue
		var tele0: int = c.effects.get_child_count()
		for step in 3:
			boss.ability_step = step
			boss._boss_ability(p)
			await _frames(2)
		check(c.effects.get_child_count() > tele0, "%s: прийоми бос малює на землі" % pair[1])
		for i in 90:
			p.hp = p.max_hp
			p.invuln = 1.0
			await process_frame
		boss.take_damage(boss.max_hp * 0.55, Vector2.ZERO)
		check(boss.phase2, "%s: друга фаза на половині здоров'я" % pair[1])
		var hits := 0
		while is_instance_valid(boss) and not boss.dead and hits < 200:
			boss.take_damage(boss.max_hp, Vector2.ZERO)
			p.hp = p.max_hp
			await process_frame
			hits += 1
		_clear_enemies(game)
		await _frames(4)
		check(game.world.cleared.get(pair[0], 0) > 0 or c.room_cleared, "%s: печеру пройдено" % pair[0])
		game.enter_map()
		await _frames(2)
	# Мапа: значки, позначки рівня, панель краю
	var wm = game.hud.map_view
	check(wm._loc_icon(Data.place("zmiinyi")) == "island" and wm._loc_icon(Data.place("oleshky")) == "dune" and wm._loc_icon(Data.place("bakhmut_kopalni")) == "mine" and wm.ICON_ORDER.has("izba"), "особливі значки нових місць")
	var built: Control = load("res://scripts/ui/map_panel.gd").build("pidhirtsi", game.world, p, func(_x): pass)
	var ptext := ""
	for n in built.find_children("*", "Label", true, false):
		ptext += n.text + "\n"
	built.free()
	check("Волинь і Поділля" in ptext and "з 32-го рівня" in ptext and ("Печера росте з тобою: нечисть і бос тут твого %d-го рівня" % p.level) in ptext and "Тобі тут: " in ptext and "витримаєш" in ptext, "панель далекої печери: край, рівень відкриття, підказка")
	var built3: Control = load("res://scripts/ui/map_panel.gd").build("oleshky", game.world, p, func(_x): pass)
	var ptext3 := ""
	for n in built3.find_children("*", "Label", true, false):
		ptext3 += n.text + "\n"
	built3.free()
	check("Чорномор'я і Крим  •  Рівень місцевості: 5" in ptext3 and not "росте" in ptext3, "панель поля краю: край і сталий рівень, без «росте»")
	var low = load("res://scripts/entities/player.gd").new()
	low._ready()
	low.level = 5
	low.recalc()
	var built2: Control = load("res://scripts/ui/map_panel.gd").build("zmiinyi", game.world, low, func(_x): pass)
	var ptext2 := ""
	for n in built2.find_children("*", "Label", true, false):
		ptext2 += n.text + "\n"
	built2.free()
	low.free()
	check("небезпечно" in ptext2 and "коли доростеш до 47-го рівня" in ptext2, "новачкові панель каже, що рано")
	game.queue_free()
	await _frames(2)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)

