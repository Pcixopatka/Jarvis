## Історія — один ланцюжок із 18 ланок (розділи й перекази між ними), кожна ланка зі своїм рівнем героя.
func _suite_chain() -> void:
	suite("Ланцюжок історії: 18 ланок і рівні")
	var Q = load("res://scripts/game/quest_engine.gd")
	var SS = load("res://scripts/game/story_service.gd")
	var LS = load("res://scripts/game/legend_service.gd")
	var TS = load("res://scripts/game/tower_service.gd")
	var DS = load("res://scripts/game/depth_service.gd")
	var Way = load("res://scripts/data/way_data.gd")
	# ---- Порядок: перший крок ланки чекає на останній крок попередньої ----
	var bad := []
	for i in CHAIN_ARCS.size():
		var A: Array = CHAIN_ARCS[i]
		var first: String = A[1]
		var want: Array = [] if i == 0 else [CHAIN_ARCS[i - 1][2]]
		# друге «after» (буває) — останній крок історії перед ланкою: для свіжого героя він і так пройдений раніше
		var extra_ok: bool = Q.after(first).size() == want.size() or (Q.after(first).size() == 2 and Q.kind_of(str(Q.after(first)[1])) == "story" and GameDB.quest_ancestors(Q.graph()["steps"]).get(str(want[0]), {}).has(str(Q.after(first)[1])))
		if Q.after(first).slice(0, 1) != want or not extra_ok or int(Q.step(first).get("min_level", 0)) != int(A[3]) or Q.level_needed(first) != int(A[3]):
			bad.append(first)
		if Q.kind_of(first) == "legend" and (int(GameDB.row("quest_lines", Q.line_of(first))["min_level"]) != int(A[3]) or not bool(GameDB.row("quest_lines", Q.line_of(first)).get("story", false))):
			bad.append("лінія " + Q.line_of(first))
		var last: Dictionary = Q.step(str(A[2]))
		var lloc := str(last["objective"]["loc"])
		if i > 0 and int(Data.place(lloc)["level"]) != int(A[4]):
			bad.append("%s: місце %s рівня %d" % [A[2], lloc, int(Data.place(lloc)["level"])])
	check(bad.is_empty(), "18 ланок у затвердженому порядку: «after», рівень першого кроку й лінії, рівень фінального місця: %s" % str(bad))
	check(Q.after("saga_dev") == ["kremlin"] and Q.level_needed("saga_dev") == 90, "сага чекає на Кремль і 90-й рівень, як і була")
	# ---- Повний порядок кроків: рівні не спадають; кожен крок має свій рівень ----
	var order := []
	for id in Q.graph()["topo"]:
		if Q.kind_of(id) in ["story", "legend"]:
			order.append(id)
	var mono := true
	var prev := 0
	var no_level := []
	for id in order:
		if not Q.step(id).has("min_level"):
			no_level.append(id)
		var lv: int = int(Q.step(id).get("min_level", 0))
		mono = mono and lv >= prev
		prev = lv
	check(no_level.is_empty() and mono and order.size() == 63, "кожен крок ланцюжка має свій «min_level», уздовж ланцюжка рівні не спадають (%d кроків, без рівня: %s)" % [order.size(), str(no_level)])
	var prolog_ok := true
	for st in SS.Story.steps(0):
		prolog_ok = prolog_ok and int(st["min_level"]) == 1
	check(prolog_ok and Q.step("oath")["if"] == "trial=0" and Q.step("to_baturyn")["if"] == "trial=2", "пролог без рівня, що спинив би новачка; гілки класів як були")
	# ---- Крок із босом — рівня своєї печери: місія й печера відкриваються разом ----
	var boss_bad := []
	var boss_n := 0
	for id in order:
		var o: Dictionary = Q.step(id)["objective"]
		var bl: Dictionary = Data.place(str(o.get("loc", "")))
		if bl.get("type", "") == "dungeon" and bl.has("boss"):
			boss_n += 1
			if int(Q.step(id)["min_level"]) != int(bl["level"]) or Data.open_from(str(o["loc"])) != int(Q.step(id)["min_level"]):
				boss_bad.append(id)
	for A in CHAIN_ARCS.slice(1, CHAIN_ARCS.size()):
		var lo := str(Q.step(str(A[2]))["objective"].get("loc", ""))
		if Data.place(lo).get("type", "") == "dungeon" and int(Q.step(str(A[2]))["min_level"]) != int(A[4]):
			boss_bad.append(str(A[2]))
	check(boss_bad.is_empty() and boss_n == 19 and int(Q.step("lair")["min_level"]) == 7 and int(Q.step("tower")["min_level"]) == 38 and int(Q.step("kremlin")["min_level"]) == 80, "крок із босом — рівня своєї печери (Змій 7, Кощій 38, Кремль 80; кроків %d): %s" % [boss_n, str(boss_bad)])
	# ---- Два фінали розведено ----
	var kz: Dictionary = Q.step("kozhumiaka_2")["objective"]
	var kb: Dictionary = Data.place("kyrylova_borozna")
	check(kz["type"] == "clear" and kz["loc"] == "kyrylova_borozna" and kb["type"] == "field" and kb["biome"] == "steppe" and int(kb["level"]) == 9 and not kb.get("scale", false), "Кожум'яка кінчається зачисткою Кирилової борозни (поле 9-го рівня в степу)")
	var dv: Dictionary = Q.step("dovbush")["objective"]
	check(dv["type"] == "clear" and dv["loc"] == "dnister_kruchi" and Q.step("dovbush")["choices"].size() == 2 and "голка" in str(Q.step("dovbush")["end"]), "Розділ III: скриня Довбуша — у Дністровських кручах, яйце й голка й вибір лишились")
	var finals := {}
	var dup := []
	for A in CHAIN_ARCS:
		var loc := str(Q.step(str(A[2]))["objective"].get("loc", ""))
		if finals.has(loc):
			dup.append(loc)
		finals[loc] = true
	var cave_users := {}
	for id in order:
		var o: Dictionary = Q.step(id)["objective"]
		if str(o["type"]) == "dungeon":
			cave_users[str(o["loc"])] = cave_users.get(str(o["loc"]), 0) + 1
	check(dup.is_empty() and int(cave_users.get("zmii_cave", 0)) == 1 and int(cave_users.get("dovbush_cave", 0)) == 1, "жодне лігво не фінал двічі: Змієва печера — лише Розділ I, Печера Довбуша — лише переказ")
	# ---- Свіжий герой: щоразу рівно одна місія історії, фінал не дається до 80-го ----
	var w = WorldState.new()
	var p = _new_player()
	var one := true
	var refused_kremlin := false
	var guard := 0
	while not Q.is_done(w, "kremlin") and guard < 1000:
		guard += 1
		w.hero_level = p.level
		var links: Array = SS.chain(w)
		if links.is_empty():
			var wl: Array = SS.chain_waiting(w)
			if wl.is_empty():
				break
			if str(wl[0]) == "kremlin" and p.level == 79:
				refused_kremlin = Q.stage(w, "kremlin") == "level" and SS.city_dialogue(w, "chernihiv").is_empty()
			p.level = Q.level_needed(str(wl[0])) - (1 if str(wl[0]) == "kremlin" and p.level < 79 else 0)
			continue
		one = one and links.size() == 1
		var id: String = str(links[0])
		if id == "choose":
			Q.set_choice(w, "trial", 0)
		Q.complete(w, id)
	check(Q.is_done(w, "kremlin") and one and refused_kremlin and p.level == 80, "свіжий герой: щоразу відкрита рівно одна місія історії; Кремль на 79-му — відмова, на 80-му — дають")
	# ---- Випробування спеціалізацій — у місцях до 34-го рівня ----
	var far := []
	for spec in GameDB.ids("spec_trials"):
		var loc := str(GameDB.row("spec_trials", spec)["objective"].get("loc", ""))
		if loc != "" and int(Data.place(loc)["level"]) > 34:
			far.append("%s→%s" % [spec, loc])
	var Spec = load("res://scripts/game/spec_service.gd")
	var ws = WorldState.new()
	var sp = _new_player()
	sp.level = 30
	ws.spec_trial = {"spec": "znakhar", "stage": "active", "progress": 0}
	var tm: Dictionary = Q.raise_mods("bryansk_forest", Spec.fight_level(ws, sp, "bryansk_forest"), sp)
	check(int(tm.get("level", 0)) == 30 and int(tm["base_level"]) == 15 and Spec.fight_level(ws, sp, "polissia") == 0, "бій випробування — на рівні героя (Брянські ліси 15-го → 30-й), деінде без змін")
	sp.free()
	check(far.is_empty() and GameDB.row("spec_trials", "zaporozhets")["objective"]["loc"] == "berestechko" and GameDB.row("spec_trials", "kharakternyk")["objective"]["loc"] == "vii_church", "випробування ведуть у місця, де герой 28–33-го рівня впорається: %s" % str(far))
	# ---- Башта й Глибини ----
	check(TS.OPEN_AFTER == "tower" and TS.OPEN_LEVEL == 38 and TS.level_of(1) == 38 and int(Data.place("bashta")["level"]) == 38 and int(GameDB.row("events", "tower")["level"]) == 38, "Башта: після Кощія, з 38-го, перший поверх 38-го рівня")
	check(DS.OPEN_AFTER == "kremlin" and DS.OPEN_LEVEL == 80 and DS.level_of(1) == 80 and int(Data.place("hlybyny")["level"]) == 80 and int(GameDB.row("events", "depths")["level"]) == 80, "Глибини: після Кремля, з 80-го, перша глибина 80-го рівня")
	check("38-го" in str(Data.place("bashta")["desc"]) and "80-го" in str(Data.place("hlybyny")["desc"]), "описи Башти й Глибин називають нові рівні")
	# ---- Доручення Башти й Глибин ----
	var ti: Dictionary = Q.step("tower_intro")
	var di: Dictionary = Q.step("depths_intro")
	check(Q.kind_of("tower_intro") == "side" and Q.mark("tower_intro") == "!" and Q.after("tower_intro") == ["tower"] and Q.level_needed("tower_intro") == 38 and ti["objective"]["stat"] == "tower" and int(ti["objective"]["count"]) == 1
		and ti["start"].size() >= 4 and ti["start"].size() <= 6, "доручення «%s»: після Кощія, з 38-го, мета — перший поверх" % ti["title"])
	check(Q.kind_of("depths_intro") == "side" and Q.mark("depths_intro") == "!" and Q.after("depths_intro") == ["kremlin"] and Q.level_needed("depths_intro") == 80 and di["objective"]["stat"] == "depth" and int(di["objective"]["count"]) == 1
		and di["start"].size() >= 4 and di["start"].size() <= 6, "доручення «%s»: після Кремля, з 80-го, мета — перша глибина" % di["title"])
	var wt = WorldState.new()
	wt.hero_level = 40
	Q.place_at(wt, "tower_intro")
	wt.stats["tower"] = 3
	var tp = _new_player()
	load("res://scripts/game/side_service.gd").on_dialogue_done(wt, tp, "side_start", "tower_intro")
	check(Q.stage(wt, "tower_intro") == "turnin", "хто вже має поверх, той виконує доручення, щойно взяв")
	tp.free()
	# ---- «Шлях козака»: спеціалізація перед Баштою ----
	var ids: Array = Way.steps().map(func(x): return str(x["id"]))
	check(ids.find("spec") == ids.size() - 2 and ids[-1] == "tower" and "38-го" in str(Way.steps()[-1]["how"]) and not "15-го" in str(Way.steps()[-1]["how"]), "шлях: спершу спеціалізація (28–33-й рівень), Башта (з 38-го) — останньою")
	# ---- Міста не вищі за ланку, що в них починається ----
	var city_bad := []
	for id in order:
		var c := str(Q.step(id).get("city", ""))
		if c == "":
			continue
		var cap: int = maxi(int(Q.step(id)["min_level"]), 3 if Q.step(id)["chapter"] == "prolog" else 0) if Q.kind_of(id) == "story" else int(Q.step(id)["min_level"])
		if int(Data.city(c)["level"]) > cap:
			city_bad.append("%s(%d)>%s(%d)" % [c, int(Data.city(c)["level"]), id, cap])
	check(city_bad.is_empty() and int(Data.city("sich")["level"]) == 1 and int(Data.city("kapyshche")["level"]) <= 3 and int(Data.city("baturyn")["level"]) <= 3, "міста не вищі за рівень ланки, що в них починається; Січ, Капище й Батурин — для прологу: %s" % str(city_bad))
	p.free()
	_chain_story_checks()


## Історія одним ланцюжком — словами: назви кроків історії, передачі між ланками, рядки, що стали неправдою,
## назва в замку Башти, у ратуші й журналі, запис довідника «Сюжетна черга».
func _chain_story_checks() -> void:
	var Q = load("res://scripts/game/quest_engine.gd")
	var SS = load("res://scripts/game/story_service.gd")
	var TS = load("res://scripts/game/tower_service.gd")
	var DS = load("res://scripts/game/depth_service.gd")
	var JS = load("res://scripts/game/journal_service.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	# ---- Кожен крок історії має коротку назву ----
	var untitled := []
	var titles := {}
	for id in GameDB.ids("story"):
		var t := str(GameDB.row("story", id).get("title", ""))
		var words: int = t.split(" ", false).size()
		if words < 2 or words > 4 or titles.has(t) or t.contains("рівень"):
			untitled.append("%s «%s»" % [id, t])
		titles[t] = true
		if Q.title(id) != t:
			untitled.append(id + ": назва місії не з «title»")
	check(GameDB.ids("story").size() == 34 and untitled.is_empty() and GameDB.STORY_SCHEMA["title"].get("required", false), "кожен із 34 кроків історії має свою назву на 2–4 слова (вона й назва місії): %s" % str(untitled))
	# ---- Рядки, що стали неправдою в ланцюжку ----
	var all_text := []
	for id in GameDB.ids("story"):
		for k in ["start", "end"]:
			for l in GameDB.row("story", id)[k]:
				all_text.append(str(l[1]))
	for id in GameDB.ids("legend_steps"):
		for k in ["start", "end"]:
			for l in GameDB.row("legend_steps", id)[k]:
				all_text.append(str(l[1]))
	var joined := "\n".join(all_text)
	check(not "Шлях до Кремля відкритий" in joined and not "Тоді час іти на Кремль" in joined and not "Досить чекати" in joined and not "гетьманові" in joined,
		"нема рядків, що стали неправдою: «шлях до Кремля відкритий» (Чаклун), «час іти на Кремль» (Кощій), «досить чекати» (рада), «гетьманові» (Морський цар)")
	# ---- Передачі між ланками: кінець ланки каже, до кого йти, початок наступної — звідки прийшов ----
	var miss := []
	for i in CHAIN_HANDOFFS.size():
		var H: Array = CHAIN_HANDOFFS[i]
		if not str(CHAIN_ARCS[i][2]) in H[0] or str(CHAIN_ARCS[i + 1][1]) != str(H[2]):
			miss.append("таблиця %d" % i)
		for last in H[0]:
			var end: Array = Q.step(str(last))["end"]
			if not end.slice(maxi(0, end.size() - 3)).any(func(l): return str(H[1]) in str(l[1])):
				miss.append("%s: «%s»" % [last, H[1]])
		var start: Array = Q.step(str(H[2]))["start"]
		if not start.slice(0, 2).any(func(l): return str(H[3]) in str(l[1])):
			miss.append("%s: «%s»" % [H[2], H[3]])
	check(CHAIN_HANDOFFS.size() == CHAIN_ARCS.size() - 1 and miss.is_empty(), "17 передач між ланками: кінець ланки веде до наступного, початок наступної знає, звідки герой: %s" % str(miss))
	# ---- Після Кощія: чому ще не Москва; рада спершу лічить зроблене ----
	var tower_end := " ".join(Q.step("tower")["end"].map(func(l): return str(l[1])))
	var named := []
	for word in ["Шубін", "Морський цар", "Лихо", "Оковський ліс", "Ідолище", "Карачун", "упир"]:
		if not word in tower_end:
			named.append(word)
	var rada: Array = Q.step("rada")["start"]
	var go_at := -1
	for j in rada.size():
		if "йдемо на Москву" in str(rada[j][1]):
			go_at = j
	check(named.is_empty() and "Я першою" in str(Q.step("tower")["end"][-1][1]) and go_at >= 2 and "Лиха нема" in str(rada[1][1]), "після Кощія названо сім лих, що тримають землі за спиною; рада спершу лічить зроблене, тоді «йдемо на Москву»: %s" % str(named))
	# ---- Назва кроку історії — у замку Башти, порадах, ратуші й журналі ----
	var w = WorldState.new()
	check(TS.lock_text(w, 1).contains("«%s»" % Q.step("tower")["title"]) and DS.lock_text(w, 1).contains("«%s»" % Q.step("kremlin")["title"]) and not TS.lock_text(w, 1).contains("рівень 38+"), "замки Башти й Глибин називають місію її назвою: %s" % TS.lock_text(w, 1))
	var p = _new_player()
	for id in Q.graph()["topo"]:
		if id == "rada":
			break
		if Q.kind_of(id) in ["story", "legend"] and not Q.is_finished(w, id):
			if id == "choose":
				Q.set_choice(w, "trial", 0)
			Q.complete(w, id)
	p.level = 60
	w.hero_level = 60
	var jrow := {}
	for r in JS.sections(w, p)[0]["rows"]:
		if r.has("wait"):
			jrow = r
	check(Q.stage(w, "rada") == "level" and str(jrow.get("text", "")).begins_with("★ %s: Поговори: " % Q.step("rada")["title"]) and str(jrow["text"]).ends_with("потрібен рівень 72"), "журнал: крок історії, якому бракує рівня, — з назвою, як переказ: %s" % str(jrow.get("text", "")))
	p.free()
	# ---- Довідник: «Сюжетна черга» ----
	var arcs: Array = WS.chain_arcs()
	var arcs_ok: bool = arcs.size() == CHAIN_ARCS.size()
	for i in mini(arcs.size(), CHAIN_ARCS.size()):
		arcs_ok = arcs_ok and str(arcs[i]["first"]) == str(CHAIN_ARCS[i][1]) and int(arcs[i]["level"]) == int(CHAIN_ARCS[i][3])
	var ce: Dictionary = WS.chain_entry()
	var in_basics := false
	for e in WS._entries("basics"):
		in_basics = in_basics or str(e["title"]) == "Сюжетна черга"
	var found := false
	for e in WS.search("сюжетна черга"):
		found = found or str(e["entry"]["title"]) == "Сюжетна черга"
	var text := str(ce["text"])
	var levels_ok := true
	for A in arcs:
		levels_ok = levels_ok and ("%s: з %d-го рівня" % [A["title"], int(A["level"])]) in text
	check(arcs_ok and levels_ok and in_basics and found and "18 ланок" in str(ce["sub"]) and "«%s»" % Q.title("tower") in text and "«%s»" % Q.title("kremlin") in text and "з 38-го" in text and "з 80-го" in text,
		"довідник «Сюжетна черга»: 18 ланок у порядку рушія, кожна з рівнем першої місії; Башта після Кощія, Глибини після фіналу")


## Старі герої після перестановки ланцюжка: поступ (id кроків) лишається. Історія — один ланцюжок, перекази
## вплетено між розділами (_suite_chain); тут — що бачить герой, який грав старий порядок.
func _suite_mission_reorder() -> void:
	suite("Місії: старі герої після перестановки")
	var Q = load("res://scripts/game/quest_engine.gd")
	var SS = load("res://scripts/game/story_service.gd")
	var SgS = load("res://scripts/game/saga_service.gd")
	var DS = load("res://scripts/game/depth_service.gd")
	var gp := GameDB.quest_graph_problems(GameDB.table("quest_lines"), {"story": GameDB.table("story"), "legend_steps": GameDB.table("legend_steps"), "saga": GameDB.table("saga"), "side": GameDB.table("side")})
	check(gp.is_empty(), "ланцюжок — справний граф: %s" % str(gp.slice(0, 3)))
	# Пройшов стару історію, переказів не чіпав
	var wa = WorldState.new()
	wa.hero_level = 60
	_quests_set(wa, "story", {"chapter": 6, "step": 0, "stage": "done", "choices": {"trial": 0}}, false, false)
	check(SS.finished(wa) and Q.is_done(wa, "kremlin") and not DS.unlocked(wa, 60) and DS.unlocked(wa, 80) and Q.stage(wa, "saga_dev") == "level" and SgS.teaser(wa) != "", "стару історію пройдено: вона пройдена й далі, Глибини — з 80-го, сага чекає свого рівня")
	check(Q.stage(wa, "kozhumiaka_1") == "offer" and Q.mark("kozhumiaka_1") == "★" and Q.stage(wa, "dovbush_1") == "offer" and Q.stage(wa, "shubin_1") == "offer" and Q.stage(wa, "solovei_1") == "locked",
		"неграні перекази — відкриті місії зі зіркою там, де їхня попередня ланка вже пройдена: %s" % str(Q.missions(wa)))
	check(Q.stage(wa, "tower_intro") == "offer" and Q.stage(wa, "depths_intro") == "level", "доручення Башти відкрите, Глибин — чекає 80-го")
	wa.hero_level = 95
	check(Q.stage(wa, "saga_dev") == "offer" and SgS.unlocked(wa), "сага відкривається, як і була")
	# Посередині старої історії: здане лишається, лічильник активного кроку цілий
	var wb = WorldState.new()
	wb.hero_level = 60
	_quests_set(wb, "story", {"chapter": 3, "step": 2, "stage": "active", "progress": 3, "choices": {"trial": 1}}, false, false)
	check(Q.is_done(wb, "walls") and Q.is_done(wb, "sorcerer") and Q.is_done(wb, "west_call") and Q.stage(wb, "opryshky") == "active" and Q.progress(wb, "opryshky") == 3, "здане лишається, активний крок і його лічильник цілі")
	check(Q.stage(wb, "dovbush") == "locked" and Q.stage(wb, "kozhumiaka_1") == "offer" and Q.stage(wb, "dovbush_1") == "offer" and Q.stage(wb, "bila_pani_1") == "locked", "відкрито перекази, чия попередня ланка пройдена: %s" % str(Q.missions(wb)))
	wb.hero_level = 10
	check(Q.stage(wb, "opryshky") == "active" and Q.stage(wb, "dovbush_1") == "level" and "dovbush_1" in Q.waiting(wb) and Q.stage(wb, "kozhumiaka_1") == "offer", "почате не закривається рівнем; нове з вищим рівнем чекає: %s" % str(Q.waiting(wb)))
	var w2 = WorldState.new()
	w2.from_dict(wb.to_dict())
	w2.hero_level = 10
	check(Q.progress(w2, "opryshky") == 3 and Q.waiting(w2) == Q.waiting(wb), "після збереження — те саме")


## Місії в грі: ратуша (позначка, відмова до рівня), вкладка ратуші, мапа (зірки, «!», бліді), доручення в ратуші й журналі.
func _suite_mission_game() -> void:
	suite("Місії в грі: позначки й відмова до рівня")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var Q = load("res://scripts/game/quest_engine.gd")
	var JS = load("res://scripts/game/journal_service.gd")
	var Leg = load("res://scripts/data/legends.gd")
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var w = game.world
	var p = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "way", "levelup"]:
		w.hints[k] = true
	# ---- Ланка після Розділу I — переказ про Кожум'яку в Києві; герою 1-го рівня кобзар відмовляє ----
	Q.place_at(w, "kozhumiaka_1")
	game.enter_city("kyiv")
	await _frames(3)
	var rows: Array = game.hall_rows("kyiv")
	var kinds := []
	for r in rows:
		kinds.append(str(r["kind"]))
	var koz: Dictionary = rows[0] if not rows.is_empty() else {}
	check(kinds == ["wait"] and str(koz["line"]) == "kozhumiaka_1" and int(koz["need"]) == 8 and str(koz["what"]) == "★ Переказ «%s». %s" % [Leg.line("kozhumiaka")["title"], Q.title("kozhumiaka_1")] and str(koz["name"]) == load("res://scripts/data/story.gd").npc_name("kobzar"), "у Києві кобзар уже тут, але чекає рівня: %s" % str(rows))
	var tc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	var txt: String = _texts_under(game.hud.screen_root)
	check(tc.get_tab_title(0) == "Ратуша" and "Ще зарано:\nприходь із 8-го рівня" in txt and "Чекає, поки підростеш" in txt and not "Поговорити" in txt, "ратуша: відмова з рівнем замість «Поговорити», вкладка без числа")
	check(not _hall_talk(game, "legend") and game.hud.dialogue_root == null, "до відмови не підійдеш")
	game.enter_map()
	await _frames(2)
	var mv = game.hud.map_view
	check(mv.dim_stars.has("kyiv") and not mv.stars.has("kyiv") and mv.story_target == "", "мапа: бліда зірка над Києвом, іншої мети історії нема")
	# ---- 8-й рівень: кобзар говорить; переказ — ланка історії, тож зірка ----
	p.level = 8
	game.enter_city("kyiv")
	await _frames(3)
	rows = game.hall_rows("kyiv")
	tc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	check(rows.size() == 1 and str(rows[0]["kind"]) == "legend" and str(rows[0]["mark"]) == "★" and str(rows[0]["what"]).begins_with("★ Переказ «") and tc.get_tab_title(0) == "Ратуша (★ 1)", "з 8-го рівня кобзар говорить; вкладка «%s»" % tc.get_tab_title(0))
	game.enter_map()
	await _frames(2)
	check(mv.stars.has("kyiv") and mv.story_target == "kyiv", "мапа: зірка над Києвом")
	# ---- Наступна ланка — знову розділ історії: кошовий на Січі ----
	Q.complete(w, "kozhumiaka_1")
	Q.complete(w, "kozhumiaka_2")
	p.level = 10
	game.enter_city("sich")
	await _frames(3)
	rows = game.hall_rows("sich")
	tc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	var story_row := {}
	for r in rows:
		if str(r["kind"]) == "story":
			story_row = r
	check(not story_row.is_empty() and str(story_row["what"]).begins_with("★ Історія") and str(tc.get_tab_title(0)).contains("(★ "), "сюжетна місія в ратуші й на вкладці — зірка: %s / %s" % [str(story_row.get("what", "")), tc.get_tab_title(0)])
	# ---- Доручення в грі (вигадана лінія поверх таблиць бази) ----
	var lines := {}
	for k in GameDB.ids("quest_lines"):
		lines[k] = GameDB.row("quest_lines", k)
	lines["dor"] = {"kind": "side", "title": "Доручення кобзаря"}
	var steps: Dictionary = GameDB.quest_steps().duplicate()
	steps["probe"] = _side_step(["village"], "Двоє заражених", {"type": "stat", "stat": "kill", "count": 2, "loc": "wild_field", "text": "Поклади двох ворогів"}, {"reward": {"gold": 77}})
	steps["probe_far"] = _side_step(["village"], "Далека справа", {"type": "visit", "loc": "kyiv", "text": "Їдь до Києва"}, {"min_level": 30})
	Q.use_graph(Q.make_graph(lines, steps))
	game.enter_city("sich")
	await _frames(3)
	rows = game.hall_rows("sich")
	var side_row := {}
	var far_row := {}
	for r in rows:
		if str(r["kind"]) == "side":
			side_row = r
		if str(r["kind"]) == "wait" and str(r["line"]) == "probe_far":
			far_row = r
	check(str(side_row.get("what", "")) == "! Доручення. Двоє заражених" and int(far_row.get("need", 0)) == 30 and str(far_row.get("what", "")) == "! Доручення. Далека справа", "доручення в ратуші — «!», далеке чекає 30-го рівня: %s" % str(rows))
	check(_hall_talk(game, "side", "probe"), "до доручення можна підійти")
	await _frames(2)
	var guard := 0
	while game.hud.dialogue_root != null and is_instance_valid(game.hud.dialogue_root) and guard < 6:
		game.hud.dialogue_root.finished.emit(-1)
		await _frames(2)
		guard += 1
	check(Q.stage(w, "probe") == "active", "доручення взято")
	game._record("kill")
	game._record("kill")
	check(Q.stage(w, "probe") == "turnin", "мету «stat» виконано подіями гри (Game._record)")
	var dsec := {}
	for sec in JS.sections(w, p):
		if str(sec["title"]) == "Доручення":
			dsec = sec
	var drow := {}
	for r in dsec.get("rows", []):
		if str(r["text"]).begins_with("! Двоє заражених"):
			drow = r
	check(not drow.is_empty() and bool(drow["ready"]) and str(drow["text"]).begins_with("! Двоє заражених: Повертайся"), "журнал: розділ «Доручення», можна здати")
	var gold0: int = p.gold
	game.enter_city("sich")
	await _frames(3)
	check(_hall_talk(game, "side", "probe"), "той, хто дав, чекає з нагородою")
	await _frames(2)
	guard = 0
	while game.hud.dialogue_root != null and is_instance_valid(game.hud.dialogue_root) and guard < 6:
		game.hud.dialogue_root.finished.emit(-1)
		await _frames(2)
		guard += 1
	check(Q.is_done(w, "probe") and p.gold == gold0 + 77, "доручення здано: +77 грн")
	Q.use_graph({})
	game.queue_free()
	await _frames(2)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


## Міграція збережень v11 → v12: старі номери кроків → id кроків рушія (через заморожений порядок).
func _suite_quest_migration() -> void:
	suite("Рушій завдань: старі збереження")
	var Q = load("res://scripts/game/quest_engine.gd")
	var SS = load("res://scripts/game/story_service.gd")
	var LSv = load("res://scripts/game/legend_service.gd")
	var SgS = load("res://scripts/game/saga_service.gd")
	var cases := [
		# [опис, story, legends, saga, рівень, очікувані здані (частина), активні {id: [етап, лічильник]}, відкриті]
		["нова гра", {}, {}, {}, 1, [], {}, ["village"]],
		["початок: бій за село", {"chapter": 0, "step": 0, "stage": "active", "progress": 0}, {}, {}, 1, [], {"village": ["active", 0]}, []],
		["набирається сили", {"chapter": 0, "step": 2, "stage": "active", "progress": 7}, {}, {}, 4, ["village", "flee"], {"trial": ["active", 7]}, []],
		["обирає дорогу", {"chapter": 0, "step": 3, "stage": "active", "progress": 0}, {}, {}, 4, ["trial"], {"choose": ["active", 0]}, []],
		["козак: присяга", {"chapter": 0, "step": 4, "stage": "active", "progress": 3, "choices": {"trial": 0, "choose": 0}}, {}, {}, 5, ["choose"], {"oath": ["active", 3]}, []],
		["волхв: випробування", {"chapter": 0, "step": 6, "stage": "turnin", "progress": 1, "choices": {"trial": 1, "choose": 0}}, {}, {}, 5, ["to_carpathians"], {"volkhv_trial": ["turnin", 1]}, []],
		["волхв: назад на Січ", {"chapter": 0, "step": 7, "stage": "offer", "progress": 0, "choices": {"trial": 1, "choose": 0, "volkhv_trial": 0}}, {}, {}, 5, ["volkhv_trial"], {}, ["back_to_sich"]],
		["стрілець: до Батурина", {"chapter": 0, "step": 8, "stage": "active", "progress": 0, "choices": {"trial": 2, "choose": 0}}, {}, {}, 5, ["choose"], {"to_baturyn": ["active", 0]}, []],
		["стрілець: випробування", {"chapter": 0, "step": 9, "stage": "active", "progress": 5, "choices": {"trial": 2, "choose": 0}}, {}, {}, 5, ["to_baturyn"], {"strilets_trial": ["active", 5]}, []],
		["розділ I, половина вбивств", {"chapter": 1, "step": 4, "stage": "active", "progress": 6, "choices": {"trial": 0, "oath": 1, "potion": 1}}, {}, {}, 9, ["oath", "recruit", "potion"], {"camp": ["active", 6]}, []],
		["між розділами", {"chapter": 2, "step": 0, "stage": "offer", "progress": 0, "choices": {"trial": 2, "camp": 1}}, {}, {}, 10, ["lair", "back_to_sich_s"], {}, []],
		["здати в Кам'янці", {"chapter": 3, "step": 4, "stage": "turnin", "progress": 1, "choices": {"trial": 1, "dovbush": 1}}, {}, {}, 17, ["dovbush"], {"tower": ["turnin", 1]}, []],
		["історію пройдено, сага закрита", {"chapter": 6, "step": 0, "stage": "done", "progress": 0, "choices": {"trial": 0, "rada": 1}}, {}, {}, 60, ["kremlin", "oath"], {}, []],
		["перекази: не почато, почато, пройдено", {"chapter": 6, "step": 0, "stage": "done", "choices": {"trial": 2}},
			{"kozhumiaka": {"step": 0, "stage": "offer", "progress": 0}, "vii": {"step": 1, "stage": "active", "progress": 3}, "drakula": {"step": 2, "stage": "turnin", "progress": 0}, "shubin": {"step": 2, "stage": "done", "progress": 0}},
			{}, 35, ["vii_1", "drakula_2", "shubin_1", "shubin_2"], {"vii_2": ["active", 3], "drakula_3": ["turnin", 0]}, ["kozhumiaka_1"]],
		["сага посередині", {"chapter": 6, "step": 0, "stage": "done", "choices": {"trial": 0}}, {}, {"step": 2, "stage": "active"}, 120, ["saga_dev", "saga_khala"], {"saga_velnias": ["active", 0]}, []],
		["сага чекає розмови", {"chapter": 6, "step": 0, "stage": "done", "choices": {"trial": 0}}, {}, {"step": 4, "stage": "offer"}, 140, ["saga_baba"], {}, ["saga_chornoboh"]],
		["сагу пройдено", {"chapter": 6, "step": 0, "stage": "done", "choices": {"trial": 0}}, {}, {"step": 5, "stage": "done"}, 140, ["saga_chornoboh"], {}, []],
	]
	for c in cases:
		var m: Dictionary = SaveSystem.quests_from_v11(c[1], c[2], c[3])
		var w = WorldState.new()
		w.missions = m
		w.hero_level = int(c[4])
		var ok := true
		for id in c[5]:
			ok = ok and Q.is_done(w, id)
		var act := {}
		for id in m["active"]:
			act[id] = [str(m["active"][id]["stage"]), int(m["active"][id]["progress"])]
		var opened := []  # відкриті без запису: чекають розмови або почались самі (перекази — лише ті, що в старому стані; без доручень)
		for id in Q.missions(w):
			if (Q.kind_of(id) == "legend" and not c[2].has(Q.line_of(id))) or Q.kind_of(id) == "side":
				continue
			if Q.stage(w, id) == "offer" or (not m["active"].has(id) and Q.stage(w, id) == "active"):
				opened.append(id)
		ok = ok and act == c[6] and opened == c[7]
		check(ok, "міграція: %s (активні %s, відкриті %s)" % [c[0], str(act), str(opened)])
	# Між розділами I і II стара гра вела до Києва, а тепер між ними — переказ про Кожум'яку: він і відкритий
	var wbw = WorldState.new()
	wbw.missions = SaveSystem.quests_from_v11({"chapter": 2, "step": 0, "stage": "offer", "progress": 0, "choices": {"trial": 2, "camp": 1}}, {}, {})
	wbw.hero_level = 10
	check(Q.stage(wbw, "kozhumiaka_1") == "offer" and Q.stage(wbw, "kyiv_call") == "locked" and SS.chain(wbw) == ["kozhumiaka_1"], "між розділами: наступна ланка — переказ про Кожум'яку")
	# Пролог за гілками: пропущене не здано, а пройдене
	var wc = WorldState.new()
	wc.missions = SaveSystem.quests_from_v11({"chapter": 1, "step": 0, "stage": "offer", "choices": {"trial": 0}}, {}, {})
	check(Q.is_done(wc, "oath") and Q.is_skipped(wc, "to_carpathians") and Q.is_skipped(wc, "back_to_sich_s") and SS.chapter_index(wc) == 1 and SS.current(wc)["id"] == "recruit", "козак після прологу: гілки волхва й стрільця пропущено, далі Розділ I")
	var wv = WorldState.new()
	wv.missions = SaveSystem.quests_from_v11({"chapter": 1, "step": 0, "stage": "offer", "choices": {"trial": 1}}, {}, {})
	check(Q.is_skipped(wv, "oath") and Q.is_done(wv, "back_to_sich") and Q.is_skipped(wv, "to_baturyn") and SS.current(wv)["id"] == "recruit", "волхв після прологу")
	# Історію пройдено старою грою без вибору дороги (герой до класів): сюжет усе одно пройдений
	var wn = WorldState.new()
	wn.missions = SaveSystem.quests_from_v11({"chapter": 6, "step": 0, "stage": "done"}, {}, {})
	check(SS.finished(wn) and SS.chapter_index(wn) == 6 and Q.is_skipped(wn, "oath") and Q.is_done(wn, "kremlin"), "пройдена історія без вибору дороги")
	# Вибори переходять як є (і «choose», який стара гра писала за кроком)
	var wch = WorldState.new()
	wch.missions = SaveSystem.quests_from_v11({"chapter": 3, "step": 3, "stage": "turnin", "progress": 0, "choices": {"trial": 2, "choose": 0, "potion": 0, "camp": 1, "crypt": 0, "samples": 1}}, {}, {})
	check(Q.choices(wch) == {"trial": 2, "choose": 0, "potion": 0, "camp": 1, "crypt": 0, "samples": 1} and SS.chronicle(wch).size() == 5 and is_equal_approx(SS.effect(wch, "discount_chyhyryn"), 0.25) and SS.effect(wch, "plague_resist") == 0.0, "вибори, літопис і наслідки після міграції")
	# Повне збереження v11: світ без старих полів, гра відкриває той самий крок
	var p = _new_player()
	var old := {"version": 11, "player": p.to_dict(), "meta": {}, "world": {"loyalty": {}, "story": {"chapter": 2, "step": 3, "stage": "active", "progress": 2, "choices": {"trial": 0, "potion": 1, "camp": 0, "crypt": 1}},
		"legends": {"vii": {"step": 1, "stage": "active", "progress": 3}}, "saga": {}}}
	var md: Dictionary = SaveSystem.migrate(old.duplicate(true))
	var wl = WorldState.new()
	wl.from_dict(md["world"])
	wl.hero_level = 15
	check(md["version"] == SaveSystem.SAVE_VERSION and not md["world"].has("story") and not md["world"].has("legends") and not md["world"].has("saga") and md["world"].has("missions"), "v11 → v12: поля story / legends / saga стали missions")
	check(SS.current(wl)["id"] == "samples" and SS.stage(wl) == "active" and Q.progress(wl, "samples") == 2 and LSv.stage(wl, "vii") == "active" and Q.progress(wl, "vii_2") == 3 and not SgS.unlocked(wl) and SS.objective_line(wl).ends_with("2/5"), "після міграції — той самий крок і лічильники")
	# Слоти: розділ і «пройдено» читаються з нового стану
	SaveSystem.save(md, SaveSystem.slot_path(5))
	var sm: Dictionary = SaveSystem.slot_summaries()[4]
	check(int(sm["chapter"]) == 2 and not sm["done"], "картка слота: розділ II")
	SaveSystem.delete(SaveSystem.slot_path(5))
	p.free()

func _suite_quest_db() -> void:
	suite("База завдань")
	var Story = load("res://scripts/data/story.gd")
	var Saga = load("res://scripts/data/saga.gd")
	var Leg = load("res://scripts/data/legends.gd")
	var WayD = load("res://scripts/data/way_data.gd")
	var Ach = load("res://scripts/data/achievements.gd")
	var Spec = load("res://scripts/game/spec_service.gd")
	var Stone = load("res://scripts/game/stone_service.gd")
	var Way = load("res://scripts/game/way_service.gd")
	var CS = load("res://scripts/game/challenge_service.gd")
	var LS = load("res://scripts/game/legend_service.gd")
	var SgS = load("res://scripts/game/saga_service.gd")
	var probs := GameDB.problems()
	check(probs.is_empty(), "у базі нема проблем%s" % ("" if probs.is_empty() else ": " + "; ".join(probs.slice(0, 5))))
	var expect := {"speakers": 32, "story_chapters": 6, "story": 34, "quest_lines": 16, "legend_steps": 29, "saga": 5, "way": 19, "daily": 20, "weekly": 18, "achievements": 95, "spec_trials": 10}
	var count_bad := []
	for t in expect:
		if GameDB.ids(t).size() != int(expect[t]):
			count_bad.append("%s %d" % [t, GameDB.ids(t).size()])
	check(count_bad.is_empty(), "у таблицях завдань стільки записів, скільки було в коді: %s" % str(count_bad))
	# ---- Порядок і номери сталі ----
	check(Story.step_ids()[0] == "village" and Story.step_ids()[-1] == "kremlin" and Story.chapter_count() == 6 and Story.steps(0).size() == 11 and Story.steps(5).size() == 1
		and Story.chapter_title(0) == "Пролог. Попіл рідного села" and Story.chapter_title(5) == "Розділ V. Кремль", "кроки й розділи історії в порядку історії")
	check(Leg.order() == ["kozhumiaka", "dovbush", "solovei", "vii", "bila_pani", "shubin", "morskyi_tsar", "lykho", "lisovyi_did", "idolyshche", "karachun", "drakula"] and Leg.steps("dovbush").size() == 3, "перекази в тому самому порядку")
	check(Saga.steps().map(func(x): return x["id"]) == ["saga_dev", "saga_khala", "saga_velnias", "saga_baba", "saga_chornoboh"] and WayD.steps()[0]["id"] == "first_fight" and WayD.steps()[-2]["id"] == "spec" and WayD.steps()[-1]["id"] == "tower" and Ach.achievements()[0]["id"] == "first_blood" and Ach.achievements()[-1]["id"] == "hetman", "сага, шлях і досягнення в тому самому порядку")
	var nums := {"speakers": ["hero", 8501, "doroha", 8532], "story_chapters": ["prolog", 8451, "kreml", 8456], "story": ["village", 8601, "kremlin", 8634], "quest_lines": ["story", 8701, "saga", 8714],
		"legend_steps": ["kozhumiaka_1", 9251, "drakula_3", 9279], "saga": ["saga_dev", 8801, "saga_chornoboh", 8805], "way": ["first_fight", 8851, "spec", 8869], "daily": ["kill", 8901, "ring", 8920],
		"weekly": ["kill", 8951, "muster", 8968], "achievements": ["first_blood", 9001, "hetman", 9095], "spec_trials": ["zaporozhets", 9201, "molfar", 9210]}
	var num_bad := []
	for t in nums:
		var n: Array = nums[t]
		if int(GameDB.row(t, n[0])["num"]) != n[1] or int(GameDB.row(t, n[2])["num"]) != n[3] or GameDB.by_num(t, n[1]) != n[0] or GameDB.by_num(t, n[3]) != n[2]:
			num_bad.append(t)
	check(num_bad.is_empty() and GameDB.by_num("story", 8701) == "" and GameDB.row("quest_lines", "kozhumiaka")["num"] == 8702, "номери завдань ті самі, що їм дали, і шукаються: %s" % str(num_bad))
	# ---- Типи ----
	var lair: Dictionary = Story.step("lair")
	var potion: Dictionary = Story.step("potion")
	var samples: Dictionary = Story.step("samples")
	check(typeof(lair["num"]) == TYPE_INT and typeof(lair["reward"]["gold"]) == TYPE_INT and typeof(lair["reward"]["loyalty"]["sich"]) == TYPE_INT and typeof(lair["reward"]["item"]["ilvl"]) == TYPE_INT
		and typeof(Story.step("legend")["objective"]["count"]) == TYPE_INT and typeof(Story.step("legend")["objective"]["chance"]) == TYPE_FLOAT and lair["end"][6].size() == 3, "числа кроку — цілі, шанс — дробовий, репліка з умовою — три рядки")
	check(typeof(potion["choices"][0]["effects"]["discount_chyhyryn"]) == TYPE_FLOAT and typeof(samples["choices"][0]["effects"]["potion_max"]) == TYPE_INT and samples["choices"][0]["effects"]["potion_max"] == 1, "наслідок вибору: знижка дробова, зілля ціле (як було в коді)")
	check(typeof(Ach.daily()[0]["goal"][0]) == TYPE_INT and Ach.daily()[0]["goal"] == [30, 60] and typeof(Leg.line("vii")["min_level"]) == TYPE_INT and typeof(Saga.min_level()) == TYPE_INT and typeof(WayD.steps()[0]["check"]["n"]) == TYPE_INT, "мети викликів, рівні ліній і умови шляху — цілі")
	# ---- Лише для читання й без копій ----
	check(lair.is_read_only() and lair["end"].is_read_only() and lair["end"][0].is_read_only() and potion["choices"][0].is_read_only() and Story.steps(1).is_read_only() and Leg.order().is_read_only() and Leg.steps("vii").is_read_only()
		and Saga.steps().is_read_only() and Ach.daily().is_read_only() and Ach.achievements()[0].is_read_only() and WayD.steps()[0]["check"].is_read_only() and Spec.trial("molfar")["start"].is_read_only() and Story.npc("kobzar").is_read_only(), "записи завдань заморожені")
	check(is_same(Story.steps(1)[5], lair) and is_same(Story.steps(1), Story.steps(1)) and is_same(Leg.steps("vii")[0], GameDB.row("legend_steps", "vii_1")) and is_same(Saga.steps(), Saga.steps()), "кроки читаються без копій, покажчики складено раз")
	check(Story.position("lair") == Vector2i(1, 5) and Story.position("kremlin") == Vector2i(5, 0) and Story.position("nova") == Vector2i(-1, -1) and Story.step("nova").is_empty() and Story.npc("nova").is_empty() and Story.npc("nova", {"name": "x"})["name"] == "x"
		and Leg.line("nova").is_empty() and Leg.steps("nova").is_empty() and not Leg.has_line("story") and Spec.trial("cossack").is_empty() and not Spec.has_trial("cossack") and Stone.first_kill("mavka").is_empty(), "невідомий крок, мовець, лінія чи бос — порожні")
	# ---- Те, що лежало в коді окремо, тепер у записах ----
	check(Story.step("choose")["choice_key"] == "trial" and Story.step("choose")["choices"].map(func(c): return c["class"]) == ["cossack", "volkhv", "strilets"], "вибір дороги: ключ збереження й класи — у кроці «choose»")
	check(Story.step("oath")["reward"]["banner"] == "Ти — козак Запорозького війська!" and Story.step("kremlin")["reward"]["banner"] == "Тебе обрано гетьманом України!", "напис про новий клас і звання — у нагороді")
	check(Story.chapter(1)["cleanse"].size() == 5 and Story.chapter(5).get("cleanse_all", false) and not Story.chapter(0).has("cleanse"), "що очищає зараза після розділу — у записі розділу")
	check(Stone.first_kill("putinoid") == ["alatyr", "zabuttia"] and Stone.first_kill("vii").is_empty() and not GameDB.mob("zmii")["boss"].has("stones"), "камені за першу перемогу — у записі боса, лише в Путіноїда")
	check(Spec.trial("plastun")["objective"]["type"] == "elite" and Spec.trial("molfar")["item"]["type"] == "staff", "випробування спеціалізації — у своїй таблиці")
	# ---- Умови відкриття: рівень, «після чого», лінія ----
	# Історія — один ланцюжок: кожен крок чекає на попередній крок своєї лінії, а перший крок ланки (розділу чи
	# переказу) — на останній крок попередньої ланки (див. _suite_chain); сага чекає на Кремль
	var link_after := {"kozhumiaka_1": "lair", "kyiv_call": "kozhumiaka_2", "dovbush_1": "sorcerer", "solovei_1": "dovbush_3", "vii_1": "solovei_3", "bila_pani_1": "vii_3",
		"west_call": "bila_pani_2", "shubin_1": "tower", "morskyi_tsar_1": "shubin_2", "lykho_1": "morskyi_tsar_2", "lisovyi_did_1": "lykho_2", "idolyshche_1": "lisovyi_did_2",
		"karachun_1": "idolyshche_3", "drakula_1": "karachun_2", "rada": "drakula_3"}
	# ще й останній крок розділу перед ланкою, коли попередня ланка — переказ: для свіжого героя це те саме (той крок
	# і так раніше), а старий герой, що розказав переказ задовго до розділу, не отримає наступний розділ раніше часу
	var link_extra := {"kyiv_call": "lair", "west_call": "sorcerer", "rada": "tower", "solovei_1": "sorcerer", "vii_1": "sorcerer", "bila_pani_1": "sorcerer",
