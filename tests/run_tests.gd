## Кожен клас вивчає всю свою дорогу за правилами дерева й уживає кожне своє активне вміння в бою.
func _suite_class_skills_fight() -> void:
	suite("Кожен клас уживає свої вміння")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full"]:
		game.world.hints[k] = true
	var gp = game.player
	var Classes = gp.Classes
	game.enter_location("wild_field")
	await _frames(4)
	_clear_enemies(game)
	var c = game.combat
	c.spawn_timer = 1.0e9
	var spot: Vector2 = c.arena.get_center()
	c._spawn_companions([{"type": "dzhura", "downed": false, "level": 20, "xp": 0, "index": 0}])  # побратим, якого піднімає знахар
	var learn_bad := []
	var use_bad := []
	for cls in Classes.ids():
		gp.job = cls
		game._sync_class()
		gp.level = 60
		gp.skills = {}
		gp.skill_points = 400
		var guard := 0
		var progress := true
		while progress and guard < 400:
			guard += 1
			progress = false
			for lc in Classes.lineage(cls):
				for br in Classes.tree(lc):
					for n in br["nodes"]:
						if gp.can_learn_skill(n) and gp.learn_skill(n["id"]):
							progress = true
		for lc in Classes.lineage(cls):
			var pr: Array = gp.tree_progress(lc)
			if pr[0] != pr[1]:
				learn_bad.append("%s/%s %s" % [cls, lc, str(pr)])
		gp.recalc()
		for lc in Classes.lineage(cls):
			for br in Classes.tree(lc):
				for n in br["nodes"]:
					if not n.get("active", false):
						continue
					_clear_enemies(game)
					for k in 3:
						c.spawn_enemy("upyr", 20, false, spot + Vector2(140 + 60 * k, -40 + 40 * k))
						var e = c._last_enemy()
						e.max_hp = 1.0e6
						e.hp = e.max_hp
					gp.global_position = spot
					gp.alive = true
					gp.hp = gp.max_hp * 0.5
					gp.mana = 1000.0  # ціну перевіряє інший тест: тут — чи вміння діє
					for cn in c.companion_nodes:
						cn.alive = false
						cn.hp = 0.0
					gp.skill_timers[n["id"]] = 0.0
					gp.use_skill(n["id"])
					if float(gp.skill_timers.get(n["id"], 0.0)) <= 0.0:
						use_bad.append("%s/%s" % [cls, n["id"]])
					await process_frame
	check(learn_bad.is_empty(), "кожен клас вивчає всю свою дорогу за правилами дерева: %s" % str(learn_bad))
	check(use_bad.is_empty(), "кожне активне вміння дороги вживається в бою (перезарядка пішла): %s" % str(use_bad))
	game.queue_free()
	await _frames(2)


## Бій починається в кожному місці мапи: нечисть з'являється, земля й шум — краєвиду місця.
func _suite_world_fights() -> void:
	suite("Бій у кожному місці")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	for k in game.world.hints.keys() + ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full"]:
		game.world.hints[k] = true
	var Sounds = load("res://scripts/data/sounds.gd")
	var bad := []
	var n := 0
	for id in Data.place_ids():
		n += 1
		seed(900 + n)
		game.combat.custom_loc = {}
		game.player.level = Data.open_from(id)  # герой того рівня, з якого в місце пускають (бій — на рівні місця, як і героєві 1-го)
		game.enter_location(id)
		game.player.hp = game.player.max_hp
		await _frames(2)
		var c = game.combat
		var foes: Array = c.get_tree().get_nodes_in_group("enemies")
		var L: Dictionary = Data.place(id)
		var ok: bool = c.active and c.loc_id == id and str(c.loc["name"]) == str(L["name"]) and c.ground.biome == L["biome"] and not foes.is_empty()
		ok = ok and foes.all(func(e): return e.kind in L["enemies"] or e.kind == L.get("boss", "") or e.is_boss or e.elite)
		ok = ok and Sounds.ambient_for(str(c.loc["biome"])) == str(GameDB.row("biomes", L["biome"])["ambient"])
		if not ok:
			bad.append(id)
		game.enter_map()
		await _frames(1)
	check(bad.is_empty() and n == 68, "бій починається в кожному з %d місць: нечисть місця, земля й шум краєвиду%s" % [n, ("" if bad.is_empty() else ": " + str(bad))])
	game.queue_free()
	await _frames(2)


## Звитяга має стелю: коли всі лінії повні, нових очок нема, смуга лише стоїть повна.
func _suite_valor_cap() -> void:
	suite("Звитяги: стеля")
	var Valor = load("res://scripts/data/valor.gd")
	var Classes = load("res://scripts/data/classes.gd")
	var AccountScript = load("res://scripts/game/account.gd")
	var WorldState = load("res://scripts/game/world_state.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var top: int = Valor.max_valor()
	check(top == Valor.order().size() * Valor.LINE_MAX and top > 0, "стеля звитяги — усі лінії повні: %d" % top)
	var full := {}
	for id in Valor.order():
		full[id] = Valor.LINE_MAX
	var banners := [0]
	var count := func(text: String, _col: Color) -> void:
		if text.begins_with("Звитяга"):
			banners[0] += 1
	var events = root.get_node("Events")
	events.banner.connect(count)
	# ---- Остання смуга перед стелею ----
	var p = _new_player()
	p.change_class("cossack")
	p.level = Classes.BASE_LEVEL_MAX
	p.xp = 0
	p.valor = top - 1
	p.valor_xp = 0
	p.valor_spent = {}
	p.recalc()
	p.add_xp(p.valor_next())
	check(p.valor == top and p.valor_points() == top and banners[0] == 1 and p.valor_xp <= p.valor_next(), "остання смуга дає рівно одне очко й доводить до стелі")
	# ---- На стелі ----
	p.valor_spent = full.duplicate()
	p.recalc()
	p.add_xp(p.valor_next() * 1000)
	check(p.valor == top and p.valor_points() == 0 and p.valor_xp == p.valor_next() and banners[0] == 1, "на стелі досвід не дає очок і банера, смуга стоїть повна (звитяга %d, смуга %d / %d)" % [p.valor, p.valor_xp, p.valor_next()])
	# ---- Смерть на стелі ----
	var bar: int = p.valor_next()
	var lost: int = p.death_xp_loss(1.0)
	check(lost > 0 and p.valor_xp == bar - lost and p.valor == top, "смерть на стелі забирає частку смуги (%d)" % lost)
	p.add_xp(lost * 3)
	check(p.valor == top and p.valor_xp == bar and banners[0] == 1, "після смерті смуга знову наповнюється до краю, без нового очка")
	# ---- Старе збереження понад стелю ----
	var d: Dictionary = p.to_dict()
	d["valor"] = top + 1
	d["valor_xp"] = bar * 7
	d["valor_spent"] = full.duplicate()
	var q = _new_player()
	q.from_dict(d)
	check(q.valor == top and q.valor_points() == 0 and q.valor_spent == full and q.valor_xp == q.valor_next(), "збереження зі звитягою %d: стеля %d, вільних очок 0, вкладені очки на місці" % [top + 1, q.valor])
	# ---- Рекорд роду понад стелю ----
	var acc = AccountScript.new()
	acc.from_dict({"stats": {"valor": top + 1, "kills": 5}, "records": {"valor": {"value": top + 7, "slot": 0, "who": "Козак", "day": "2026-11-01"}, "level": {"value": 99}}, AccountScript.XP_GOLD_KEY: 1})
	check(int(acc.stats["valor"]) == top and int(acc.records["valor"]["value"]) == top and int(acc.stats["kills"]) == 5 and int(acc.records["level"]["value"]) == 99, "завантажений рід: лічильник і рекорд звитяги опущено до стелі, решту не чіпано")
	var acc2 = AccountScript.new()
	var w = WorldState.new()
	w.stats = {"valor": top + 3}
	acc2.absorb_from_world(w)
	check(int(acc2.stats["valor"]) == top, "старе збереження героя: перенесений у рід рекорд звитяги теж до стелі")
	events.banner.disconnect(count)
	p.free()
	q.free()
	# ---- Довідник ----
	var vtext := ""
	for sec in WS.sections():
		for e in sec["entries"]:
			if str(e["title"]) == "Звитяги":
				vtext = str(e["text"])
	check(("Найбільша звитяга %d" % top) in vtext and "стоїть повна" in vtext, "довідник називає стелю звитяги")
	# ---- Екран героя ----
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup"]:
		game.world.hints[k] = true
	var h = game.player
	h.change_class("cossack")
	h.level = Classes.BASE_LEVEL_MAX
	h.stat_points = 0
	h.skill_points = 0
	h.perk_points = 0
	game.enter_map()
	await _frames(2)
	var texts := func() -> Array:
		_reveal_tabs(game)
		var out := []
		for l in game.hud.screen_root.find_children("*", "Label", true, false):
			if "Звитяга" in l.text:
				out.append(l.text)
		return out
	var cases := [[top, full, "найвища", ""], [top, {"dmg": Valor.LINE_MAX - 2, "hp": Valor.LINE_MAX, "ward": Valor.LINE_MAX, "skill": Valor.LINE_MAX, "luck": Valor.LINE_MAX}, "найвища", "вільних очок: 2"], [top - 1, {"dmg": Valor.LINE_MAX - 1, "hp": Valor.LINE_MAX, "ward": Valor.LINE_MAX, "skill": Valor.LINE_MAX, "luck": Valor.LINE_MAX}, "до наступної", ""]]
	for cs in cases:
		h.valor = int(cs[0])
		h.valor_spent = cs[1].duplicate()
		h.valor_xp = h.valor_next() if h.valor >= top else 0
		h.recalc()
		game.open_character()
		await _frames(2)
		var got: Array = texts.call()
		var head := ""
		for t in got:
			if str(t).begins_with("Звитяга %d   •" % h.valor):
				head = t
		var no_next: bool = got.all(func(t): return not "до наступної" in str(t))
		if h.valor >= top:
			var pts_ok: bool = (str(cs[3]) in head) if str(cs[3]) != "" else not "вільних очок" in head
			check(head.begins_with("Звитяга %d   •   найвища" % top) and pts_ok and no_next and got.any(func(t): return str(t) == "Звитяга %d: найвища" % top), "екран героя на стелі: «%s», наступної не обіцяє" % head)
		else:
			check("до наступної" in head and "вільних очок: 0" in head and not got.any(func(t): return "найвища" in str(t)), "екран героя до стелі: «%s»" % head)
		game.close_character()
		await _frames(2)
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false


func _suite_hero_mechanics() -> void:
	suite("Механіки героя: уміння, шаблони дії, сили, зброя")
	var HM = load("res://scripts/mechanics/hero_mechanic.gd")
	var SM = load("res://scripts/mechanics/skill_mechanic.gd")
	var AM = load("res://scripts/mechanics/act_mechanic.gd")
	var PM = load("res://scripts/mechanics/power_mechanic.gd")
	var WM = load("res://scripts/mechanics/weapon_mechanic.gd")
	var Loader = load("res://scripts/mechanics/loader.gd")
	var Uniques = load("res://scripts/data/uniques.gd")
	# Посилання кожної родини ведуть на файл від основи родини, і кожен файл комусь потрібен
	var refs := {"skill": [], "act": [], "power": [], "weapon": []}
	var bad := []
	for id in GameDB.ids("skills"):
		var n: Dictionary = GameDB.row("skills", id)
		if not n.get("active", false):
			continue
		if n.has("act"):
			var ar := "act/" + str(n["act"]["type"])
			if not ar in refs["act"]:
				refs["act"].append(ar)
			if AM.script_of(str(n["act"]["type"])) == null:
				bad.append(ar)
		else:
			var ref := str(n.get("mechanic", ""))
			refs["skill"].append(ref)
			if ref != "skill/" + str(id) or SM.script_of(ref) == null or not Loader.extends_base(SM.script_of(ref), HM.HERO_BASE):
				bad.append("%s → %s" % [id, ref])
	for id in GameDB.ids("powers"):
		var ref := str(GameDB.power(id).get("mechanic", ""))
		refs["power"].append(ref)
		if ref != "power/" + str(id) or PM.script_of(ref) == null:
			bad.append("%s → %s" % [id, ref])
	for id in GameDB.ids("weapons"):
		var ref := str(GameDB.weapon(id).get("mechanic", ""))
		refs["weapon"].append(ref)
		if ref != "weapon/" + str(id) or WM.script_of(ref) == null:
			bad.append("%s → %s" % [id, ref])
	check(bad.is_empty() and refs["skill"].size() == 33 and refs["act"].size() == 7 and refs["power"].size() == 7 and refs["weapon"].size() == 7, "33 уміння з власною дією, 7 шаблонів, 7 сил і 7 видів зброї: кожне посилання веде на файл від основи своєї родини%s" % ("" if bad.is_empty() else ": " + str(bad)))
	var orphans := []
	for f in refs:
		var listed: Array = refs[f].duplicate()
		listed.sort()
		if GameDB.mechanic_files(f) != listed:
			orphans.append(f)
	check(orphans.is_empty(), "сиріт нема: кожен файл у skill/, act/, power/, weapon/ потрібен якомусь запису%s" % ("" if orphans.is_empty() else ": " + str(orphans)))
	var acts: Array = GameDB.ACT_SCHEMA["fields"]["type"]["values"].map(func(t): return "act/" + t)
	acts.sort()
	check(acts == GameDB.mechanic_files("act"), "перелік шаблонів у схемі збігається з файлами act/")
	check(SM.script_of("power/hrim") == null and PM.script_of("skill/whirl") == null and WM.script_of("skill/whirl") == null and AM.script_of("../skill/whirl") == null and load("res://scripts/mechanics/companion_mechanic.gd").script_of("weapon/mace") == null and SM.script_of("skill/nema_takoho") == null, "механіка чужої родини чи неіснуючий файл не підходить")
	check(GameDB.MECHANIC_BASES["skill"] == SM.BASE_PATH and GameDB.MECHANIC_BASES["act"] == AM.BASE_PATH and GameDB.MECHANIC_BASES["power"] == PM.BASE_PATH and GameDB.MECHANIC_BASES["weapon"] == WM.BASE_PATH, "родини героя записано в GameDB.MECHANIC_BASES")
	# Хуки: рушій бачить лише написані
	var hb := func(ref: String, base: String) -> int: return HM.hooks_of(Loader.script_of(ref, base), base)
	check(hb.call("skill/tin", SM.BASE_PATH) == (1 << HM.TICK) | (1 << HM.ON_ROLL) | (1 << HM.AGGRO) | (1 << HM.TINT) | (1 << HM.CAST) and hb.call("skill/whirl", SM.BASE_PATH) == (1 << HM.TICK_LATE) | (1 << HM.CAST) | (1 << HM.COOLDOWN) and hb.call("skill/vyly", SM.BASE_PATH) == (1 << HM.CAST) and hb.call("power/vidlunnia", PM.BASE_PATH) == (1 << HM.ON_CAST) and hb.call("weapon/sabre", WM.BASE_PATH) == 0 and hb.call("weapon/mace", WM.BASE_PATH) == (1 << HM.FINISHER_HIT) | (1 << HM.DAMAGE_MULT), "рушій бачить лише хуки, які механіка написала")
	# Герой без вивчених активних умінь не має механік умінь і нічого не платить щокадру
	var bare = PlayerScript.new()
	bare.skills = {}
	bare._ready()
	var skill_m := 0
	for ref in bare._mechs:
		skill_m += 1 if str(ref).begins_with("skill/") or str(ref).begins_with("act/") or str(ref).begins_with("power/") else 0
	var busy := 0
	for i in HM.EVENTS:
		busy += bare._hooks[i].size()
	check(skill_m == 0 and busy == 0 and bare.weapon_mech != null and bare.weapon_mech.ref == "weapon/sabre", "герой без вивчених умінь і золота: механік умінь і сил нема, жоден хук не кличеться, у руках — механіка шаблі")
	bare.skills = {"vyly": 2, "hardy": 1, "first_aid": 1, "pidsichka": 1}
	bare.recalc()
	var tick_free: bool = bare._hooks[HM.TICK].is_empty() and bare._hooks[HM.ON_HIT].is_empty()
	var m1 = bare.mech("skill/vyly")
	bare.recalc()
	check(m1 != null and is_same(m1, bare.mech("skill/vyly")) and bare.mech("skill/first_aid") != null and bare.mech("act/cone") != null and bare._by_skill.get("hardy") == null and tick_free, "механіки з'являються, коли вміння вивчено, раз (перерахунок не створює нових); удар вилами не важить щокадру")
	var card_bad := []
	for id in GameDB.ids("skills"):
		var n: Dictionary = GameDB.row("skills", id)
		if n.get("active", false) and bare.SkillInfo.stats(str(id), 1, bare).is_empty() and not str(n.get("act", {}).get("type", "")) == "summon":
			card_bad.append(id)
	check(card_bad.is_empty(), "кожне активне вміння має цифри картки з механіки%s" % ("" if card_bad.is_empty() else ": " + str(card_bad)))
	bare.free()
	# Хибні посилання ловить перевірка
	var raw_s = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("skills")))
	raw_s["vyly"]["mechanic"] = "skill/nema_takoho"
	raw_s["whirl"]["mechanic"] = "power/hrim"
	raw_s["taran"]["mechanic"] = "skill/taran"
	raw_s["first_aid"].erase("mechanic")
	var miss := _missed(GameDB.validate("skills", raw_s), ["skills/vyly: «mechanic» посилається на res://scripts/mechanics/skill/nema_takoho.gd, а такого файлу нема", "skills/whirl: «mechanic» має бути \"skill/<файл>\"", "skills/taran: «mechanic» і «act» разом", "skills/first_aid: уміння з коду потребує «mechanic»", "механіка res://scripts/mechanics/skill/vyly.gd нікому не потрібна", "механіка res://scripts/mechanics/skill/first_aid.gd нікому не потрібна"])
	check(miss.is_empty(), "перевірка ловить хибні посилання вмінь і сиріт%s" % ("" if miss.is_empty() else ": не впіймала " + str(miss)))
	var raw_p = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("powers")))
	raw_p["hrim"]["mechanic"] = "power/nema_takoho"
	raw_p["perun"]["mechanic"] = "weapon/sabre"
	raw_p["yadro"].erase("mechanic")
	miss = _missed(GameDB.validate("powers", raw_p), ["powers/hrim: «mechanic» посилається на res://scripts/mechanics/power/nema_takoho.gd", "powers/perun: «mechanic» має бути \"power/<файл>\"", "powers/yadro: немає обов'язкового поля «mechanic»", "механіка res://scripts/mechanics/power/hrim.gd нікому не потрібна"])
	check(miss.is_empty(), "перевірка ловить хибні посилання сил%s" % ("" if miss.is_empty() else ": не впіймала " + str(miss)))
	var raw_w = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("weapons")))
	raw_w["mace"]["mechanic"] = "weapon/nema_takoho"
	raw_w["bow"].erase("shot_range")
	raw_w["staff"]["stat"] = "agi"
	miss = _missed(GameDB.validate("weapons", raw_w), ["weapons/mace: «mechanic» посилається на res://scripts/mechanics/weapon/nema_takoho.gd", "механіка res://scripts/mechanics/weapon/mace.gd нікому не потрібна", "weapons/bow: зброя дальнього бою («ranged») потребує «shot_range»", "weapons/staff: «stat» «agi» не згоджується з «agi»"])
	check(miss.is_empty(), "перевірка ловить хибні посилання й правила зброї%s" % ("" if miss.is_empty() else ": не впіймала " + str(miss)))
	check(Data.weapon_stat("staff") == "spi" and Data.weapon_stat("bow") == "agi" and Data.weapon_stat("mace") == "str", "яка характеристика дає силу удару — дані запису зброї")
	# Справжній бій: кожна механіка створюється й діє без помилок скриптів
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full"]:
		game.world.hints[k] = true
	var gp = game.player
	var Classes = gp.Classes
	game.enter_location("wild_field")
	await _frames(4)
	_clear_enemies(game)
	var c = game.combat
	c.spawn_timer = 1.0e9
	var spot: Vector2 = c.arena.get_center()
	var foes := func():
		_clear_enemies(game)
		for k in 3:
			c.spawn_enemy("upyr", 20, false, spot + Vector2(110 + 50 * k, -30 + 30 * k))
			var e = c._last_enemy()
			e.max_hp = 1.0e6
			e.hp = e.max_hp
			e.damage = 1.0
	var used := {}
	var cast_bad := []
	for cls in ["zaporozhets", "plastun", "kharakternyk", "samopalnyk", "sahaidachnyk", "opryshok", "sokolnyk", "znakhar", "perun_zhrets", "molfar"]:
		gp.job = cls
		game._sync_class()
		gp.level = 60
		gp.skills = {}
		for lc in Classes.lineage(cls):
			for br in Classes.tree(lc):
				for n in br["nodes"]:
					gp.skills[n["id"]] = int(n["max"])
		gp.recalc()
		for id in gp.learned_actives():
			foes.call()
			for x in c.companion_nodes:
				x.queue_free()
			c.companion_nodes.clear()
			c._spawn_companions([{"type": "dzhura", "downed": false, "level": 20, "xp": 0, "index": 0}])
			var cn = c.companion_nodes[0]
			cn.alive = false  # повалений: його підніме знахар
			cn.visible = false
			cn.hp = 0.0
			gp.global_position = spot
			gp.alive = true
			gp.hp = gp.max_hp * 0.5
			gp.mana = gp.max_mana
			gp.skill_timers[id] = 0.0
			gp.use_skill(id)
			if float(gp.skill_timers.get(id, 0.0)) <= 0.0:
				cast_bad.append("%s/%s" % [cls, id])
			used[id] = true
			await _frames(20)
	var ac := 0
	for id in Classes.actives():
		ac += 1 if used.has(id) else 0
	check(cast_bad.is_empty() and ac == Classes.actives().size(), "кожне активне вміння (%d) спрацювало в бою своєю механікою%s" % [ac, "" if cast_bad.is_empty() else ": " + str(cast_bad)])
	# Кожна сила золотої речі й кожен вид зброї: серія, завершальний, заряджений удар, перекид, уміння
	gp.job = "zaporozhets"
	game._sync_class()
	gp.recalc()
	var pow_bad := []
	for pid in GameDB.ids("powers"):
		var uid := ""
		for u in GameDB.ids("golden"):
			if uid == "" and str(GameDB.row("golden", u)["power"]) == pid:
				uid = str(u)
		var it: Dictionary = Uniques.make(uid, 40)
		gp.assign_uid(it)
		gp.equipment[it["slot"]] = it
		gp.recalc()
		foes.call()
		gp.global_position = spot
		gp.hp = gp.max_hp * 0.3
		gp.invuln = 0.0
		for k in 4:
			gp.attack_timer = 0.0
			gp.attack()
			await _frames(3)
		gp.charged_strike(1.0)
		gp.dodge_timer = 0.0
		gp.dodge()
		gp.skill_timers["zemnyi"] = 0.0
		gp.mana = gp.max_mana
		gp.use_skill("zemnyi")
		await _frames(150)
		if gp.mech("power/" + pid) == null or not gp.u_pow.has(pid):
			pow_bad.append(pid)
		gp.equipment.erase(it["slot"])
	check(pow_bad.is_empty(), "кожна сила золотої речі має свою механіку в бою%s" % ("" if pow_bad.is_empty() else ": " + str(pow_bad)))
	var wpn_bad := []
	for w in GameDB.ids("weapons"):
		var it: Dictionary = Data.gen_item(40, 2, "weapon", str(w))
		gp.assign_uid(it)
		gp.equipment["weapon"] = it
		gp.recalc()
		foes.call()
		gp.global_position = spot
		var hp0 := 0.0
		for e in c.enemies_now():
			hp0 += e.hp
		for k in 4:
			gp.attack_timer = 0.0
			gp.combo_timer = 1.0
			gp.attack()
			await _frames(12)
		gp.charged_strike(1.0)
		await _frames(30)
		var hp1 := 0.0
		for e in c.enemies_now():
			hp1 += e.hp
		if gp.weapon_mech == null or gp.weapon_mech.ref != "weapon/" + str(w) or hp1 >= hp0:
			wpn_bad.append(w)
	check(wpn_bad.is_empty(), "кожен вид зброї б'є своєю механікою: серія й заряджений удар%s" % ("" if wpn_bad.is_empty() else ": " + str(wpn_bad)))
	game.queue_free()
	await _frames(2)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


