## База даних гри (data/*.json через GameDB): перевірка, типи чисел, лише читання, невідомі id, номери.
func _suite_game_db() -> void:
	suite("База даних")
	var probs := GameDB.problems()
	check(probs.is_empty(), "у базі нема проблем%s" % ("" if probs.is_empty() else ": " + "; ".join(probs.slice(0, 5))))
	var ids := GameDB.mob_ids()
	check(ids.size() == 56 and GameDB.boss_ids().size() == 25 and ids.has("mavka") and ids.has("rival"), "56 видів нечисті, 25 босів")
	# Числа: JSON дає всі числа дробовими, база мусить повернути цілі там, де поле ціле
	var types_ok := true
	var nums := {}
	var boss_nums := {}
	for id in ids:
		var R: Dictionary = GameDB.mob(id)
		var st: Dictionary = R["stats"]
		types_ok = types_ok and typeof(R["num"]) == TYPE_INT and typeof(st["xp"]) == TYPE_INT
		for f in ["hp", "speed", "damage", "radius"]:
			types_ok = types_ok and typeof(st[f]) == TYPE_FLOAT
		types_ok = types_ok and typeof(R["color"]) == TYPE_COLOR and typeof(R["attack"]["windup"]) == TYPE_FLOAT
		nums[R["num"]] = id
		if R.has("boss"):
			types_ok = types_ok and typeof(R["boss"]["num"]) == TYPE_INT and (not R["boss"].has("tier") or typeof(R["boss"]["tier"]) == TYPE_INT)
			boss_nums[R["boss"]["num"]] = id
	check(types_ok, "цілі поля цілі, дробові дробові, колір — Color")
	check(GameDB.mob("mavka")["stats"]["xp"] / 2 == 1 and "%d" % GameDB.mob("upyr")["stats"]["xp"] == "6" and {3: "так"}.has(GameDB.mob("mavka")["stats"]["xp"]), "ціле xp поводиться як ціле: ділення, %d, ключ словника")
	check(GameDB.boss_tier("dev") == 6 and typeof(GameDB.boss_tier("dev")) == TYPE_INT and GameDB.boss_tier("mavka") == 0, "ступінь боса цілий; у звичайної нечисті 0")
	# Номери записів: сталі, унікальні, пошук за номером
	check(nums.size() == ids.size() and boss_nums.size() == 25, "номери нечисті й босів не повторюються")
	check(GameDB.mob("mavka")["num"] == 1001 and GameDB.mob("karachun")["num"] == 1055 and GameDB.mob("rival")["num"] == 1056 and GameDB.mob("zmii")["boss"]["num"] == 2001 and GameDB.mob("drakula")["boss"]["num"] == 2025, "номери записів ті самі, що їм дали")
	check(GameDB.mob_by_num(1001) == "mavka" and GameDB.mob_by_num(1056) == "rival" and GameDB.boss_by_num(2001) == "zmii" and GameDB.boss_by_num(1001) == "" and GameDB.mob_by_num(999) == "", "пошук нечисті й боса за номером")
	var by_num_ok := true
	for n in nums:
		by_num_ok = by_num_ok and GameDB.mob_by_num(n) == nums[n]
	for n in boss_nums:
		by_num_ok = by_num_ok and GameDB.boss_by_num(n) == boss_nums[n]
	check(by_num_ok, "кожен номер веде до свого запису")
	# Лише для читання
	var R0: Dictionary = GameDB.mob("mavka")
	check(R0.is_read_only() and R0["stats"].is_read_only() and R0["attack"].is_read_only() and R0["wiki"].is_read_only() and GameDB.mob("upyr")["boss"]["wiki"].is_read_only() and ids.is_read_only(), "записи бази заморожені")
	check(is_same(GameDB.mob("mavka"), GameDB.mob("mavka")), "база віддає той самий запис, а не копію")
	# Невідомий вид: порожній запис, назви з запасним словом, типові числа в бою
	var none: Dictionary = GameDB.mob("nova_nevidoma")
	check(none.is_empty() and none.is_read_only() and not GameDB.has_mob("nova_nevidoma") and not GameDB.has_boss("nova_nevidoma"), "невідомий вид: порожній запис лише для читання")
	check(GameDB.mob_name("nova_nevidoma") == "" and GameDB.mob_name("nova_nevidoma", "Бос") == "Бос" and GameDB.boss_name("nova_nevidoma", "x") == "x" and GameDB.boss_tier("nova_nevidoma") == 0 and GameDB.hit_status("nova_nevidoma") == "" and GameDB.mechanic("nova_nevidoma") == "" and GameDB.mechanic("nova_nevidoma", true) == "" and not GameDB.is_phase2_boss("nova_nevidoma") and GameDB.mob_wiki("nova_nevidoma").is_empty() and load("res://scripts/data/sounds.gd").death("nova_nevidoma") == "enemy_die", "невідомий вид: порожні назви, жодних станів, загальний голос")
	var EnemyS = load("res://scripts/entities/enemy.gd")
	var odd = EnemyS.new()
	odd.setup("nova_nevidoma", 1, false)
	check(is_equal_approx(odd.max_hp, 30.0 * Data.enemy_hp_scale(1)) and odd.radius == 16.0 and odd.windup_max == 0.35 and odd.xp_value == 3 and not odd.ranged, "невідомий вид у бою має типові числа")
	odd.free()
	# Кожна нечисть стає до бою на 1-му й 99-му рівні, а бос — і босом
	var setup_ok := true
	var bad := []
	for id in ids:
		var R: Dictionary = GameDB.mob(id)
		for lvl in [1, 99]:
			for boss in ([false, true] if R.has("boss") else [false]):
				var e = EnemyS.new()
				e.setup(id, lvl, boss)
				var ok: bool = e.max_hp > 0.0 and e.hp == e.max_hp and e.damage > 0.0 and typeof(e.xp_value) == TYPE_INT and e.color == R["color"]
				ok = ok and e.is_boss == (boss or id == "zmii") and e.windup_max == (0.55 if e.is_boss else float(R["attack"]["windup"]))
				ok = ok and e.radius == float(R["stats"]["radius"]) * (2.0 if boss and id != "zmii" else 1.0)
				ok = ok and e.ranged == bool(R["attack"].get("ranged", false) or (e.is_boss and R["attack"].get("as_boss", {}).get("ranged", false)))
				if not ok:
					bad.append("%s:%d:%s" % [id, lvl, boss])
				setup_ok = setup_ok and ok
				e.free()
	check(setup_ok, "кожна нечисть стає до бою на 1-му й 99-му рівні, бос — і босом%s" % ("" if bad.is_empty() else ": " + str(bad)))
	# Файл у єдиному вигляді (tools/data_format.gd) і з'являється в збірці
	var text := FileAccess.get_file_as_string(GameDB.path_of("mobs"))
	var raw: Dictionary = JSON.parse_string(text)
	check(load("res://tools/data_format.gd").format_table("mobs", raw) == text and not "\\u0" in text and text.ends_with("}\n"), "mobs.json у єдиному вигляді: справжні літери, сталий порядок полів")
	var presets := FileAccess.get_file_as_string("res://export_presets.cfg")
	check(presets.count('include_filter="data/*"') == 2, "обидва пресети збірки беруть data/ до гри")
	check(GameDB.validate("mobs", raw).is_empty(), "сирий файл проходить перевірку")
	# Перевірка ловить зламаний запис
	var broken: Dictionary = raw.duplicate(true)
	broken["mavka"]["stats"]["hp"] = "багато"
	broken["mavka"]["colour"] = [1, 0, 0]
	broken["upyr"].erase("color")
	broken["upyr"]["stats"]["xp"] = 6.5
	broken["upyr"]["num"] = 1001
	broken["chort"]["hit_status"] = "fire"
	broken["chort"]["color"] = [1.5, 0, 0]
	broken.erase("pushkar")
	broken["vii"].erase("boss")
	broken["zmii"]["boss"]["num"] = 2002
	broken["Bad Id"] = {"num": 1999, "stats": {}, "color": [0, 0, 0], "attack": {"windup": 0.3}}
	var found := GameDB.validate("mobs", broken)
	var expect := ["mobs/mavka.stats.hp", "«colour»", "mobs/upyr: немає обов'язкового поля «color»", "mobs/upyr.stats.xp: має бути цілим", "номер 1001", "номер боса 2002", "«fire»", "mobs/chort.color", "«pushkar», якої немає", "«vii» тут бос", "mobs/Bad Id: id", "mobs/Bad Id.stats: немає обов'язкового поля «hp»"]
	var missed := []
	for x in expect:
		var hit := false
		for p in found:
			hit = hit or x in str(p)
		if not hit:
			missed.append(x)
	check(missed.is_empty(), "перевірка ловить кожну ваду зламаного запису%s" % ("" if missed.is_empty() else ": не впіймала " + str(missed)))
	# Нормалізація: ціле з JSON стає int, дробове — float
	var norm: Array = GameDB._normalize_rows("mobs", JSON.parse_string('{"t": {"num": 7, "stats": {"hp": 30, "speed": 1.5, "damage": 2, "xp": 3.0, "radius": 10}, "color": [1, 0.5, 0], "attack": {"windup": 1}}}'))
	var T: Dictionary = norm[0]["t"]
	check(norm[1].is_empty() and typeof(T["num"]) == TYPE_INT and typeof(T["stats"]["xp"]) == TYPE_INT and typeof(T["stats"]["hp"]) == TYPE_FLOAT and typeof(T["attack"]["windup"]) == TYPE_FLOAT and T["color"] == Color(1, 0.5, 0), "нормалізація зводить числа до типів схеми")
	check(not GameDB.validate("mobs", {}).is_empty(), "порожня база не проходить: на нечисть посилається вся гра")
	# Механіки: запис посилається на файл механіки, файл — на основу Mechanic, сиріт нема
	var M = load("res://scripts/mechanics/mechanic.gd")
	var refs := {}
	var n_refs := [0, 0]
	var resolve_ok := true
	for id in ids:
		for b in [false, true]:
			var ref: String = GameDB.mechanic(id, b)
			if ref != "":
				refs[ref] = id
				n_refs[1 if b else 0] += 1
				resolve_ok = resolve_ok and M.script_of(ref) != null and ref.begins_with("boss/" if b else "mob/")
	check(resolve_ok and n_refs == [30, 25], "механіки: 30 звичайних і 25 босових посилань, усі ведуть на файл механіки своєї теки (%s)" % str(n_refs))
	var every_boss := true
	for b in GameDB.boss_ids():
		every_boss = every_boss and GameDB.mechanic(b, true) == "boss/" + b
	check(every_boss, "кожен бос має свою механіку boss/<вид>")
	var files: Array = GameDB.mechanic_files("mob") + GameDB.mechanic_files("boss")
	var listed: Array = refs.keys()
	files.sort()
	listed.sort()
	check(files == listed, "кожен файл механіки потрібен якомусь запису, і кожне посилання має файл")
	check(GameDB.mechanic("koshchii", true) == "boss/koshchii" and GameDB.mechanic("koshchii") == "" and GameDB.mechanic("chort") == "mob/chort" and GameDB.mechanic("chort", true) == "" and GameDB.mechanic("mavka") == "" and GameDB.mechanic("vovkulaka") == "mob/vovkulaka" and GameDB.mechanic("vovkulaka", true) == "boss/vovkulaka", "механіка звичайної форми й боса — окремі поля")
	check(M.extends_base(M.script_of("boss/vii")) and M.extends_base(M.script_of("mob/stallo")) and not M.extends_base(load("res://scripts/core/game_db.gd")) and M.script_of("mob/nema_takoho") == null, "механіка походить від Mechanic; чужий скрипт чи відсутній файл — не механіка")
	check(M.has_hook("mob/chort", "chase") and not M.has_hook("mob/chort", "ability") and M.has_hook("mob/stallo", "ability") and M.has_hook("mob/khiisi", "ability") and M.has_hook("boss/vii", "tick") and M.has_hook("boss/shubin", "tick") and M.has_hook("boss/vovkulaka", "chase") and M.has_hook("boss/vovkulaka", "ability") and not M.has_hook("boss/zmii", "phase2") and M.has_hook("boss/koshchii", "on_lethal") and not M.has_hook("mob/pishchalnyk", "tick"), "рушій бачить лише ті хуки, які механіка (чи її предок) написала")
	check(is_same(M.script_of("boss/vii"), M.script_of("boss/vii")) and is_same(M.script_of("boss/vii"), load(M.path_of("boss/vii"))), "скрипт механіки вантажиться раз і береться з кешу")
	var plain = EnemyS.new()
	plain.setup("mavka", 5, false)
	var up_minion = EnemyS.new()
	up_minion.setup("upyr", 5, false)
	var up_boss = EnemyS.new()
	up_boss.setup("upyr", 5, true)
	var ch1 = EnemyS.new()
	ch1.setup("chort", 5, false)
	var ch2 = EnemyS.new()
	ch2.setup("chort", 5, false)
	var lead = EnemyS.new()
	lead.setup("pesyholovets", 5, true)
	check(plain.mechanic == null and plain._mh == 0 and up_minion.mechanic == null and up_boss.mechanic != null and up_boss._mech_boss, "нечисть без механіки її не має; упир-бос має механіку боса")
	check(ch1.mechanic != ch2.mechanic and ch1.mechanic.get_script() == ch2.mechanic.get_script() and ch1.mechanic.e == ch1 and ch1._trick == false, "кожен чорт має свій об'єкт механіки з одного скрипту")
	check(lead.is_boss and lead.mechanic != null and not lead._mech_boss and lead.mechanic.get_script() == M.script_of("mob/pesyholovets"), "ватажок без запису боса тримає механіку звичайної форми")
	for x in [plain, up_minion, up_boss, ch1, ch2, lead]:
		x.free()
	# Перевірка ловить хибні посилання на механіки
	var bm: Dictionary = raw.duplicate(true)
	bm["chort"]["mechanic"] = "mob/nema_takoho"
	bm["koshchii"]["boss"]["mechanic"] = "mob/koshchii"
	bm["mavka"]["mechanic"] = "boss/zmii"
	var mfound := GameDB.validate("mobs", bm)
	var mexpect := ["mobs/chort: «mechanic» посилається на res://scripts/mechanics/mob/nema_takoho.gd, а такого файлу нема", "mobs/koshchii: «boss.mechanic» має бути", "mobs/mavka: «mechanic» має бути", "механіка res://scripts/mechanics/mob/chort.gd нікому не потрібна", "механіка res://scripts/mechanics/boss/koshchii.gd нікому не потрібна"]
	var mmissed := []
	for x in mexpect:
		var hit := false
		for p in mfound:
			hit = hit or x in str(p)
		if not hit:
			mmissed.append(x)
	check(mmissed.is_empty(), "перевірка ловить хибні посилання на механіки й сиріт%s" % ("" if mmissed.is_empty() else ": не впіймала " + str(mmissed) + " / " + str(mfound)))

func _suite_data() -> void:
	suite("Дані")
	for id in Data.place_ids():
		var L: Dictionary = Data.place(id)
		for e in L["enemies"]:
			check((GameDB.mob_name(e) != "") and (GameDB.quest_item(e) != ""), "%s: невідомий ворог %s" % [id, e])
		if L["type"] == "dungeon":
			check(GameDB.has_boss(L["boss"]) and int(L["rooms"]) >= 2, "%s: бос або кімнати" % id)
	var Classes = load("res://scripts/data/classes.gd")
	for cls in Classes.tree_ids():
		var skill_ids = {}
		for b in Classes.tree(cls):
			for n in b["nodes"]:
				check(not skill_ids.has(n["id"]), "%s: дубль вміння %s" % [cls, n["id"]])
				skill_ids[n["id"]] = true
				if n.get("active", false):
					check(Classes.actives().has(n["id"]) and Classes.cooldown(n["id"]) > 0.0 and Classes.label(n["id"]) != "" and int(n.get("cost", 0)) > 0 and (n.has("what") or n.has("act")), "%s: активне %s має кнопку, перезарядку й ціну" % [cls, n["id"]])
		for b in Classes.tree(cls):
			for n in b["nodes"]:
				for r in n["req"]:
					check(skill_ids.has(r), "%s: вміння %s вимагає невідоме %s" % [cls, n["id"], r])
		var info: Dictionary = Classes.info(cls)
		for wt in info["weapons"]:
			check(Data.has_weapon(wt), "%s: зброя %s існує" % [cls, wt])
		for nx in info["next"]:
			check(Classes.has_class(nx), "%s → %s" % [cls, nx])
	var perk_ids = {}
	for b in Data.perk_branches():
		for t in b["tiers"]:
			for pk in t:
				check(not perk_ids.has(pk["id"]), "дубль перка " + pk["id"])
				perk_ids[pk["id"]] = true
	# Речі всіх слотів, рідкостей і типів зброї
	for slot in Data.slots():
		for r in 4:
			var types: Array = Data.weapon_ids() if slot == "weapon" else [""]
			for t in types:
				var it = Data.gen_item(5, r, slot, t)
				var st = Data.item_stats(it)
				check(it["affixes"].size() == r, "%s/%d: кількість бонусів" % [slot, r])
				check(not st.is_empty(), "%s: порожні бонуси" % slot)
				for k in st:
					check(st[k] >= 0.0 and GameDB.table("bonuses").has(k), "%s: бонус %s" % [slot, k])
				check(Data.sell_price(it) > 0, "%s: ціна" % slot)
	var it = Data.gen_item(3, 1, "weapon", "sabre")
	var prev = 0
	for up in Data.MAX_UPGRADE:
		it["up"] = up
		var c = Data.sharpen_cost(it)
		check(c > prev, "ціна заточки росте")
		prev = c
	for i in 200:
		check(Data.roll_rarity(5, 2) >= 2, "мінімальна рідкість")
	# Рідкість: легендарних із рівнем більшає, але повільно; частки сходяться в одиницю
	var share_sum := 0.0
	for r in 4:
		share_sum += Data.rarity_share(75, r)
	check(is_equal_approx(share_sum, 1.0) and is_equal_approx(Data.rarity_share(75, 0, 2), 0.0) and is_equal_approx(Data.rarity_share(75, 2, 2) + Data.rarity_share(75, 3, 2), 1.0), "частки рідкостей сходяться в одиницю, нижчих за найменшу нема")
	check(Data.rarity_share(1, 3) > 0.01 and Data.rarity_share(75, 3) > Data.rarity_share(20, 3) and Data.rarity_share(20, 3) > Data.rarity_share(1, 3) and Data.rarity_share(99, 3) < 0.05, "легендарна з рядової нечисті: від %.1f%% на 1-му рівні до %.1f%% на 99-му" % [Data.rarity_share(1, 3) * 100.0, Data.rarity_share(99, 3) * 100.0])
	check(Data.rarity_share(75, 3, 2) > 0.1 and Data.rarity_share(75, 3, 2) < 0.25 and Data.rarity_share(75, 3, 1) > Data.rarity_share(75, 3), "бос і еліта дають легендарну частіше: з боса %.0f%% речей на 75-му рівні" % (Data.rarity_share(75, 3, 2) * 100.0))
	var rolled := [0, 0, 0, 0]
	for i in 4000:
		rolled[Data.roll_rarity(75)] += 1
	check(absf(float(rolled[3]) / 4000.0 - Data.rarity_share(75, 3)) < 0.015 and absf(float(rolled[2]) / 4000.0 - Data.rarity_share(75, 2)) < 0.04, "кидок рідкості відповідає часткам (легендарних %d із 4000)" % rolled[3])
	# Завдання
	var w = WorldState.new()
	for city in Data.city_ids():
		for i in 10:
			var q: Dictionary = w._gen_quest(city)
			check(q["type"] in ["kill", "fetch", "dungeon", "escort"], "тип завдання")
			check(int(q["count"]) > 0 and int(q["gold"]) > 0 and int(q["xp"]) > 0 and int(q["loyalty"]) > 0, "нагорода/кількість")
			check(Data.is_place(q["loc"]), "локація завдання")
		var b: Array = w.board(city)
		check(b.size() == 3, "дошка %s має 3 завдання" % city)


# ======================= 2. Козак =======================

func _suite_player() -> void:
	suite("Козак")
	var p = _new_player()
	check(p.equipment.has("weapon"), "стартова зброя")
	check(p.level == 1 and p.hp == p.max_hp, "початковий стан")
	var lv_before = p.level
	p.add_xp(500)
	check(p.level > lv_before, "рівень росте від досвіду")
	var gained = p.level - 1
	check(p.stat_points == gained * Data.STAT_POINTS_PER_LEVEL, "очки характеристик")
	check(p.perk_points == p.level / 2, "Загартування: очко за кожні 2 рівні")
	check(p.job_level > 1 and p.skill_points == p.job_level - 1, "очки вмінь — з майстерності (%d)" % p.job_level)
	var dmg = p.damage
	check(p.add_stat("str") and p.damage > dmg, "сила збільшує шкоду")
	# Усі вміння й перки до максимуму
	p.skill_points = 99
	p.perk_points = 99
	var Classes = load("res://scripts/data/classes.gd")
	for i in 8:
		for b in Classes.tree("cossack"):
			for n in b["nodes"]:
				p.learn_skill(n["id"])
		for b in Data.perk_branches():
			for t in b["tiers"]:
				for pk in t:
					p.learn_perk(pk["id"])
	for b in Classes.tree("cossack"):
		for n in b["nodes"]:
			check(p.sk(n["id"]) == n["max"], "вміння %s на максимумі" % n["id"])
	check(not p.learn_skill("fireball"), "козак не вчить вміння волхва")
	for b in Data.perk_branches():
		for t in b["tiers"]:
			for pk in t:
				check(p.pk(pk["id"]) == pk["max"], "перк %s на максимумі" % pk["id"])
	check(not p.learn_skill("whirl"), "не можна перевищити максимум")
	check(p.armor <= 0.75 and p.crit_chance <= 0.8 and p.skill_cd_mult >= 0.3, "межі показників")
	# Дерево Загартування розраховане на 99 рівень: очок (49) менше, ніж вузлів, — є з чого вибирати
	var perk_total := 0
	for b in Data.perk_branches():
		for t in b["tiers"]:
			for pk in t:
				perk_total += int(pk["max"])
	check(perk_total > Classes.BASE_LEVEL_MAX / Classes.HARDEN_EVERY, "Загартування: вузлів (%d) більше за очки на 99 рівні" % perk_total)
	check(Data.perk_branches().size() == 3, "Загартування: три гілки")
	# Нові перки діють
	var q0 = _new_player()
	q0.perk_points = 99
	var hp0: float = q0.max_hp
	var dmg0: float = q0.damage
	var pot0: int = q0.potion_max()
	for i in 5:
		q0.learn_perk("h_body")
		q0.learn_perk("h_hand")
	check(q0.pk("h_body") == 5 and q0.max_hp > hp0 * 1.19 and q0.damage > dmg0 * 1.14, "Міцна кістка й Важкий удар")
	q0.learn_perk("h_skin")
	q0.learn_perk("h_blood")
	q0.learn_perk("purse")
	q0.learn_perk("kobzar")
	q0.learn_perk("h_gold")
	q0.learn_perk("h_eye")
	q0.learn_perk("h_flask")
	check(q0.gold_mult > 1.07 and q0.potion_max() == pot0 + 1 and q0.regen >= 0.5, "Торгова жилка, баклага, Живуча кров")
	q0.learn_perk("luck")
	q0.learn_perk("luck")
	check(q0.learn_perk("h_crit") and q0.crit_mult == 2.25, "Жорстокий крит")
	for i in 3:
		q0.learn_perk("sich")
	check(q0.pk("sich") == 0, "Загартований закритий, поки гілка «Тіло» не набрала 8 очок")
	for i in 3:
		q0.learn_perk("varenyk")
		q0.learn_perk("h_potion")
		q0.learn_perk("h_roll")
	var str0: int = q0.stat("str")
	check(q0.learn_perk("sich") and q0.stat("str") == str0 + 2, "Загартований: +2 до характеристик за ранг")
	# Спорядження
	var helm = Data.gen_item(5, 2, "head")
	check(p.add_item(helm), "річ у торбу")
	var hp_before = p.max_hp
	check(p.equip(helm["uid"]) and p.max_hp > hp_before, "шапка додає здоров'я")
	check(p.unequip(helm["uid"]) and is_equal_approx(p.max_hp, hp_before), "зняття повертає показники")
	# Заточка
	var w: Dictionary = p.equipment["weapon"]
	p.gold = 100000
	for i in 40:
		p.sharpen(w["uid"])
		check(w["up"] >= 0 and w["up"] <= Data.MAX_UPGRADE, "заточка в межах")
	w["up"] = Data.MAX_UPGRADE
	check(p.sharpen(w["uid"]) == "max" and w["up"] == Data.MAX_UPGRADE, "межа заточки")
	w["up"] = Data.SHARPEN_RISK_FROM - 1
	p.recalc()
	p.gold = 0
	var up_before: int = w["up"]
	if up_before < Data.MAX_UPGRADE:
		check(p.sharpen(w["uid"]) == "nogold" and w["up"] == up_before, "без гривень не точить")
	# Серіалізація
	var d = p.to_dict()
	var q = _new_player()
	q.from_dict(d)
	check(q.level == p.level and q.gold == p.gold and q.skills == p.skills and q.perks == p.perks, "to_dict/from_dict")
	check(q.equipment["weapon"]["up"] == w["up"] and q.inventory.size() == p.inventory.size(), "спорядження після відновлення")
	check(is_equal_approx(q.damage, p.damage), "показники після відновлення")
	p.free()
	q.free()


# ======================= 3. Збереження =======================

func _suite_save() -> void:
	suite("Збереження")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	check(SaveSystem.load_data(TEST_SAVE).is_empty(), "немає збереження — порожньо")
	var p = _new_player()
	p.gold = 777
	var w = WorldState.new()
	w.add_loyalty("kyiv", 120)
	w.hints["map"] = true
	check(SaveSystem.save({"player": p.to_dict(), "world": w.to_dict(), "meta": {"playtime": 5.0}}, TEST_SAVE), "запис")
	var d = SaveSystem.load_data(TEST_SAVE)
	check(d.get("version", 0) == SaveSystem.SAVE_VERSION, "версія")
	check(d["player"]["gold"] == 777 and d["world"]["loyalty"]["kyiv"] == 120, "дані після читання")
	# Друге збереження створює .bak; псуємо основний файл — має підхопитися резервний
	p.gold = 888
	SaveSystem.save({"player": p.to_dict(), "world": w.to_dict(), "meta": {}}, TEST_SAVE)
	var f = FileAccess.open(TEST_SAVE, FileAccess.WRITE)
	f.store_string("це вже не збереження")
	f.close()
	d = SaveSystem.load_data(TEST_SAVE)
	check(not d.is_empty() and d["player"]["gold"] == 777, "відновлення з резервної копії")
	# Міграції
	var v2 = {"version": 2, "player": p.to_dict(), "world": {"loyalty": {}}}
	var m = SaveSystem.migrate(v2)
	check(m.get("version", 0) == SaveSystem.SAVE_VERSION and m.has("meta") and m["world"].has("hints"), "міграція v2 → поточна")
	check(m["player"]["xp_next"] == Data.xp_for_level(m["player"]["level"]), "міграція перераховує поріг досвіду")
	var v6 = SaveSystem.migrate({"version": 6, "player": p.to_dict(), "world": {"story": {"chapter": 1, "step": 3, "stage": "active", "progress": 0}}})
	check(v6["world"]["missions"]["active"].has("samples") and not v6["world"].has("story"), "міграція v7: розділ зсувається через пролог (далі v12: розділ II, крок 3 — «samples»)")
	var v6d = SaveSystem.migrate({"version": 6, "player": {}, "world": {"story": {"chapter": 2, "step": 0, "stage": "done"}}})
	check(v6d["world"]["missions"]["done"].has("kremlin") and v6d["world"]["missions"]["active"].is_empty(), "завершений сюжет не зсувається")
	var v8a = SaveSystem.migrate({"version": 8, "player": p.to_dict(), "world": {"story": {"chapter": 0, "step": 3, "stage": "active", "progress": 0, "choices": {"trial": 0}}}})
	check(v8a["world"]["missions"]["active"].has("oath") and v8a["world"]["missions"]["done"].has("choose"), "міграція v9: присяга зсувається за кроком «Обери дорогу»")
	var v8b = SaveSystem.migrate({"version": 8, "player": p.to_dict(), "world": {"story": {"chapter": 0, "step": 2, "stage": "turnin", "progress": 10, "choices": {}}}})
	check(v8b["world"]["missions"]["active"].get("choose", {}).get("stage", "") == "active" and v8b["world"]["missions"]["done"].has("trial"), "міграція v9: хто чекав вибору — йде до Мирона й Зореслави")
	var v8c = SaveSystem.migrate({"version": 8, "player": p.to_dict(), "world": {"story": {"chapter": 2, "step": 1, "stage": "active", "progress": 0}}})
	check(v8c["world"]["missions"]["active"].has("crypt"), "міграція v9: пізні розділи не чіпає")
	check(SaveSystem.migrate({"version": 1, "player": {}, "world": {}}).is_empty(), "v1 не підтримується")
	check(SaveSystem.migrate({"version": 99, "player": {}, "world": {}}).is_empty(), "майбутня версія відхиляється")
	var w2 = WorldState.new()
	w2.from_dict(m["world"])
	check(w2.last_city == "sich" and w2.quests.is_empty(), "світ із мінімальних даних")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	check(not SaveSystem.exists(TEST_SAVE), "видалення")
	p.free()


