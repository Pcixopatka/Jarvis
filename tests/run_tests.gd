	var d_old: Dictionary = bytes_to_var(var_to_bytes(d10_copy))
	d_old["player"]["inventory"].append(bytes_to_var(var_to_bytes(acc.chest["items"][0])))
	var m_old := SaveSystem.migrate(d_old)
	var last: Dictionary = m_old["player"]["inventory"][m_old["player"]["inventory"].size() - 1]
	check(is_equal_approx(float(last["affixes"]["xp"]), float(marked["affixes"]["xp"])) and absf(float(m_old["player"]["equipment"]["head"]["affixes"]["xp"]) * top - LIMIT) < 0.01, "річ зі скрині в старому герої не зменшується вдруге, а його власні речі перераховано")
	var mm := SaveSystem.migrate(bytes_to_var(var_to_bytes(m_old)))
	check(var_to_str(mm["player"]) == var_to_str(m_old["player"]), "мігроване збереження вдруге не міняється")
	# скриня вже перерахована, а новий старий герой перераховується окремо
	var ch_before: String = var_to_str(game.account.chest)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.write_var(TEST_SAVE, bytes_to_var(var_to_bytes(d10_copy)))
	check(game.load_game() and absf(top_of.call(game.player.equipment["head"], "xp") - LIMIT) < 0.01 and var_to_str(game.account.chest) == ch_before, "інший старий герой перерахувався, а скриня, уже перерахована, лишилась як була")
	# скриня з позначкою, а в ній ще не перерахована річ (такої не буває, бо позначку пише лише перерахована скриня)
	# не чіпаємо; стара скриня без позначки перераховується рівно раз
	var acc2 = AccountS.new()
	var raw := {"chest": {"gold": 0, "items": [_old_xp_item("boots", 69.02)], "stones": {}}}
	acc2.from_dict(raw)
	var once := float(acc2.chest["items"][0]["affixes"]["xp"])
	var acc3 = AccountS.new()
	acc3.from_dict(bytes_to_var(var_to_bytes(acc2.to_dict())))
	check(absf(once * top - LIMIT) < 0.01 and is_equal_approx(float(acc3.chest["items"][0]["affixes"]["xp"]), once), "стара скриня перерахована рівно раз")
	# .bak: основного файла нема, копія версії 10
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.write_var(TEST_SAVE, bytes_to_var(var_to_bytes(d10_copy)))
	SaveSystem.write_var(TEST_SAVE, bytes_to_var(var_to_bytes(d10_copy)))
	DirAccess.remove_absolute(ProjectSettings.globalize_path(TEST_SAVE))
	var from_bak := SaveSystem.load_data(TEST_SAVE)
	check(not from_bak.is_empty() and absf(float(from_bak["player"]["equipment"]["head"]["affixes"]["xp"]) * top - LIMIT) < 0.01, "копія .bak версії 10 теж перераховується")
	# код перенесення роду зі старим героєм і старою скринею
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var profile := {"v": 1, "account": {"chest": {"gold": 0, "items": [_old_xp_item("amulet", 69.02, 165.3)], "stones": {}}}, "heroes": [{"slot": 1, "data": bytes_to_var(var_to_bytes(d10_copy))}]}
	var code: String = ST.pack(profile)
	var un: Dictionary = ST.unpack(code)
	check(un["ok"] and ST.apply(un["profile"], {1: TEST_SAVE}, TEST_ACCOUNT), "код роду зі старими речами прийнято")
	check(game.load_game() and absf(top_of.call(game.player.equipment["head"], "xp") - LIMIT) < 0.01 and absf(top_of.call(game.account.chest["items"][0], "gold") - LIMIT) < 0.01, "після перенесення кодом і герой, і скриня перераховані")
	game.save_game()
	check(game.load_game() and absf(top_of.call(game.player.equipment["head"], "xp") - LIMIT) < 0.01 and absf(top_of.call(game.account.chest["items"][0], "gold") - LIMIT) < 0.01, "і вдруге не зменшуються")
	for path in [TEST_SAVE, TEST_ACCOUNT]:
		for suffix in [ST.BACKUP, ST.NONE]:
			if FileAccess.file_exists(path + suffix):
				DirAccess.remove_absolute(path + suffix)
	# ---- 8. Перекування й оновлення ----
	var cw = WorldState.new()
	cw.camp = {"buildings": {"kuznia": 3}}
	var cp = _new_player()
	cp.level = 99
	cp.gold = 100000000
	cp.resources = {"wood": 0, "iron": 100000, "herbs": 100000, "trophy": 100000}
	var rf := Data.gen_item(140, 3, "head")
	cp.add_item(rf)
	var rf_over := 0
	var rf_hits := 0
	seed(3)
	for k in 300:
		var a: String = str(rf["affixes"].keys()[k % rf["affixes"].size()])
		var got: String = CR.reforge(cw, cp, int(rf["uid"]), a)
		if got in ["xp", "gold"]:
			rf_hits += 1
			if float(rf["affixes"][got]) > cap + 1e-6:
				rf_over += 1
	check(rf_hits > 5 and rf_over == 0, "перекування на досвід чи гривні (%d разів) не дає більше стелі" % rf_hits)
	var rn := Data.gen_item(1, 3, "head")
	rn["affixes"] = {"xp": cap + 5.0, "gold": 0.5}
	cp.add_item(rn)
	check(CR.renew(cw, cp, int(rn["uid"])) and int(rn["ilvl"]) == 99 and float(rn["affixes"]["xp"]) <= cap + 1e-9 and float(rn["affixes"]["gold"]) <= cap + 1e-9 and float(rn["affixes"]["gold"]) > 0.5, "оновлення речі не дає більше стелі")
	var ug: Dictionary = Uniques.make("oberih_berehyni", 40)
	cp.add_item(ug)
	check(CR.renew(cw, cp, int(ug["uid"])) and is_equal_approx(float(ug["affixes"]["xp"]), float(Uniques.make("oberih_berehyni", 99)["affixes"]["xp"])) and float(ug["affixes"]["xp"]) <= cap + 1e-9, "оновлення золотої речі: досвід за новими правилами")
	# ---- 9. Показ ----
	check(Data.fmt_stat("xp", cap * top) == "+16.7% досвіду" and Data.fmt_stat("gold", cap * top) == "+16.7% гривень" and Data.fmt_stat("xp", 3.04) == "+3.0% досвіду", "рядок властивості з одним знаком після коми: %s" % Data.fmt_stat("xp", cap * top))
	check(Data.fmt_stat("dmg_pct", 12.4) == "+12% шкоди" and Data.fmt_stat("crit", 2.46) == "+2.5% шансу криту" and Data.fmt_stat("hp", 120.4) == "+120 здоров'я" and Data.fmt_stat("str", 7.0) == "+7 до Сили" and Data.fmt_stat("skill_power", 9.6) == "+10% сили вмінь", "інші властивості показуються як раніше")
	var shown := _old_xp_item("head", cap, cap)
	shown["affixes"]["dmg_pct"] = 12.4
	var worse := _old_xp_item("head", cap * 0.5)
	worse["up"] = 0
	var card = UIK.item_card(shown, worse)
	var lt := []
	for l in card.find_children("*", "Label", true, false):
		lt.append(l.text)
	card.free()
	check("+16.7% досвіду" in lt and "+16.7% гривень" in lt and "+27% шкоди" in lt and Data.fmt_stat("crit", 5.25 * top) in lt, "картка речі в порівнянні: %s" % str(lt))
	var card2 = UIK.item_card(worse, shown)
	var lt2 := []
	for l in card2.find_children("*", "Label", true, false):
		lt2.append(l.text)
	card2.free()
	var lost_ok := false
	for t in lt2:
		lost_ok = lost_ok or (str(t).begins_with("Втратиш:") and "+16.7% гривень" in str(t) and "+27% шкоди" in str(t))
	check("+3.8% досвіду" in lt2 and lost_ok, "порівняння показує втрачене з одним знаком: %s" % str(lt2))
	# ---- 10. Інші властивості не змінились ----
	var old_f := {
		"dmg_pct": func(l, q): return (randf_range(3, 6) + 0.4 * l) * q,
		"crit": func(l, q): return (randf_range(1.5, 3.5) + 0.15 * l) * q,
		"aspd": func(l, q): return (randf_range(3, 6) + 0.3 * l) * q,
		"hp": func(l, q): return (randf_range(8, 16) + 3.0 * l) * q,
		"armor": func(l, q): return (randf_range(1.5, 3.0) + 0.2 * l) * q,
		"regen": func(l, q): return (randf_range(0.3, 0.7) + 0.05 * l) * q,
		"lifesteal": func(l, q): return (randf_range(0.8, 1.6) + 0.05 * l) * q,
		"speed": func(l, q): return (randf_range(2, 4) + 0.2 * l) * q,
		"skill_power": func(l, q): return (randf_range(4, 7) + 0.4 * l) * q,
		"skill_cd": func(l, q): return (randf_range(2, 4) + 0.2 * l) * q,
		"pickup": func(_l, q): return randf_range(10, 20) * q,
	}
	var diff := []
	for id in old_f:
		for lvl in [1, 7, 50, 99, 140]:
			for r in 5:
				seed(lvl * 31 + r)
				var nv: float = Data._roll_value(id, lvl, r)
				seed(lvl * 31 + r)
				var ov: float = old_f[id].call(lvl, 1.0 + 0.15 * r)
				if nv != ov:
					diff.append("%s %d %d" % [id, lvl, r])
	for id in ["str", "agi", "vit", "spi"]:
		for lvl in [1, 50, 99]:
			seed(lvl)
			var nv: float = Data._roll_value(id, lvl, 3)
			seed(lvl)
			if nv != float(randi_range(1, 1 + lvl / 3 + 3 / 2)):
				diff.append(id)
	check(diff.is_empty(), "інші властивості кидаються за тими самими формулами: %s" % str(diff))
	var u_ok := true
	for st_id in ["dmg_pct", "hp", "crit", "skill_power", "armor"]:
		u_ok = u_ok and is_equal_approx(Uniques.value(st_id, 80, 1.1), 1.6 * (float(GameDB.bonus(st_id)["mid"][0]) + float(GameDB.bonus(st_id)["mid"][1]) * 80) * 1.1)
	check(u_ok, "золоті речі: інші властивості ті самі")
	# ---- Довідник ----
	var prop_txt := ""
	for sec in WS.sections():
		for e in sec["entries"]:
			if str(e["title"]) == "Властивості":
				prop_txt = str(e["text"])
	check("не перевищують 16,7% навіть при заточці +10" in prop_txt and not ("—" in prop_txt), "довідник: досвід і гривні на одній речі не більше 16,7%% при +10")
	game.queue_free()
	await _frames(3)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


# ======================= Перекування золотих і наборних речей =======================

func _suite_reforge_rare() -> void:
	suite("Перекування золотих і наборних речей")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var Sets = load("res://scripts/data/sets.gd")
	var Uniques = load("res://scripts/data/uniques.gd")
	var CR = load("res://scripts/game/craft_service.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var cap: float = Data.XP_GOLD_CAP
	var top := 1.0 + Data.UPGRADE_BONUS * Data.MAX_UPGRADE
	var cw = WorldState.new()
	cw.camp = {"buildings": {"kuznia": 3}}
	var cw1 = WorldState.new()
	cw1.camp = {"buildings": {"kuznia": 1}}
	var new_cp := func():
		var p = _new_player()
		p.level = 99
		p.gold = 1000000000
		p.resources = {"wood": 100000, "iron": 100000, "herbs": 100000, "trophy": 100000}
		return p
	var cp = new_cp.call()
	# одна властивість замінена новою, решта ті самі й з тими самими значеннями
	var one_swapped := func(before: Dictionary, after: Dictionary, victim: String, fresh: String) -> bool:
		if fresh == "" or after.has(victim) or not after.has(fresh) or before.has(fresh) or after.size() != before.size():
			return false
		for k in before:
			if k != victim and (not after.has(k) or float(after[k]) != float(before[k])):
				return false
		return true
	var set_id: String = Sets.ids()[0]
	var gid := "oberih_berehyni"
	var probe_set: Dictionary = Sets.make(set_id, "head", 60)
	var probe_gold: Dictionary = Uniques.make(gid, 40)
	check(CR.can_reforge(cw, probe_set) and CR.can_reforge(cw, probe_gold), "наборна й золота речі перековуються в кузні 3")
	check(not CR.can_reforge(cw1, probe_set) and not CR.can_reforge(cw1, probe_gold), "у кузні 1 перекування ще нема, як і для звичайних")
	# ---- Наборна річ ----
	var pieces := []
	for slot in ["head", "body", "belt", "boots"]:
		var sp: Dictionary = Sets.make(set_id, slot, 60)
		cp.add_item(sp)
		cp.equip(int(sp["uid"]))
		pieces.append(sp)
	var cnt_before: String = var_to_str(Sets.count(cp.equipment))
	var fx_before: String = var_to_str(Sets.fx(cp.equipment))
	check(int(Sets.count(cp.equipment).get(set_id, 0)) == 4, "вдягнено чотири речі набору")
	var sp0: Dictionary = pieces[0]
	var name0: String = str(sp0["name"])
	var sb: Dictionary = sp0["affixes"].duplicate()
	var sv: String = str(sb.keys()[0])
	var s_fresh: String = CR.reforge(cw, cp, int(sp0["uid"]), sv)
	check(one_swapped.call(sb, sp0["affixes"], sv, s_fresh), "наборна річ: замінено одну властивість (%s → %s), решта ті самі" % [sv, s_fresh])
	check(str(sp0.get("set", "")) == set_id and str(sp0["name"]) == name0 and Sets.is_set(sp0), "наборна річ лишилась у наборі: ключ і назва на місці")
	check(var_to_str(Sets.count(cp.equipment)) == cnt_before and var_to_str(Sets.fx(cp.equipment)) == fx_before, "рахунок речей набору й бонус набору ті самі")
	# оновлення наборної речі: як у звичайної, властивості не нижчають, ключ набору лишається
	var sp1: Dictionary = pieces[1]
	var sb1: Dictionary = sp1["affixes"].duplicate()
	var sv1: String = str(sb1.keys()[0])
	var s_fresh1: String = CR.reforge(cw, cp, int(sp1["uid"]), sv1)
	var s_after: Dictionary = sp1["affixes"].duplicate()
	var s_ok: bool = CR.renew(cw, cp, int(sp1["uid"])) and int(sp1["ilvl"]) == 99 and str(sp1.get("set", "")) == set_id and sp1["affixes"].keys() == s_after.keys()
	for k in s_after:
		s_ok = s_ok and float(sp1["affixes"][k]) >= float(s_after[k])
	check(s_fresh1 != "" and s_ok and var_to_str(Sets.count(cp.equipment)) == cnt_before, "перекована наборна річ після оновлення: ті самі властивості, не нижчі, у наборі")
	# ---- Золота річ ----
	var g: Dictionary = Uniques.make(gid, 40)
	g["up"] = 5
	cp.add_item(g)
	var gb: Dictionary = g["affixes"].duplicate()
	var gv := "hp"
	var g_fresh: String = CR.reforge(cw, cp, int(g["uid"]), gv)
	check(one_swapped.call(gb, g["affixes"], gv, g_fresh), "золота річ: замінено одну властивість (%s → %s), решта ті самі" % [gv, g_fresh])
	check(str(g.get("unique", "")) == gid and Uniques.is_unique(g) and Uniques.power_id(g) == str(Uniques.def(gid)["power"]), "золота річ лишилась золотою, з особливою силою")
	var def_aff: Dictionary = Uniques.def(gid)["affixes"]
	var check_renew := func(it: Dictionary, levels: int, want_lvl: int, label: String) -> void:
		var pre: Dictionary = it["affixes"].duplicate()
		var pre_keep := {}
		for k in it:
			if not k in ["ilvl", "base", "affixes", "spent"]:
				pre_keep[k] = it[k]
		var gold0: int = int(cp.gold)
		var spent0: int = int(it.get("spent", 0))
		var cost: Dictionary = CR.renew_cost(it, want_lvl)
		var ok: bool = CR.renew(cw, cp, int(it["uid"]), levels)
		check(ok and int(it["ilvl"]) == want_lvl and gold0 - int(cp.gold) == int(cost["gold"]) and int(it["spent"]) - spent0 == int(cost["gold"]), "%s: рівень %d, гроші списано рівно раз (%d грн)" % [label, want_lvl, int(cost["gold"])])
		check(it["affixes"].keys() == pre.keys() and not it["affixes"].has(gv), "%s: набір властивостей той самий, прибрана перекуванням не вернулась" % label)
		check(float(it["affixes"][g_fresh]) >= float(pre[g_fresh]), "%s: перекована властивість не нижча (%.3f → %.3f)" % [label, float(pre[g_fresh]), float(it["affixes"][g_fresh])])
		var def_ok := true
		for a in it["affixes"]:
			if def_aff.has(a):
				def_ok = def_ok and is_equal_approx(float(it["affixes"][a]), Uniques.value(a, want_lvl, float(def_aff[a])))
		check(def_ok, "%s: властивості з опису дорівнюють Uniques.value нового рівня" % label)
		var keep_ok := var_to_str(it["base"]) == var_to_str(Uniques.make(gid, want_lvl)["base"])
		for k in pre_keep:
			keep_ok = keep_ok and it.has(k) and var_to_str(it[k]) == var_to_str(pre_keep[k])
		check(keep_ok, "%s: головний показник нового рівня, заточка й решта речі як були" % label)
	check_renew.call(g, 1, 41, "золота річ, оновлення на один рівень")
	check_renew.call(g, 0, 99, "золота річ, оновлення до свого рівня")
	# без перекування оновлення дає те саме, що й раніше
	var g2: Dictionary = Uniques.make(gid, 40)
	cp.add_item(g2)
	CR.renew(cw, cp, int(g2["uid"]), 1)
	var same1: bool = var_to_str(g2["affixes"]) == var_to_str(Uniques.make(gid, 41)["affixes"]) and var_to_str(g2["base"]) == var_to_str(Uniques.make(gid, 41)["base"])
	CR.renew(cw, cp, int(g2["uid"]))
	var same2: bool = var_to_str(g2["affixes"]) == var_to_str(Uniques.make(gid, 99)["affixes"]) and var_to_str(g2["base"]) == var_to_str(Uniques.make(gid, 99)["base"])
	check(same1 and same2, "золота річ без перекування після оновлення та сама, що Uniques.make на тому ж рівні")
	# ---- Стеля досвіду й гривень ----
	var plain_ids := []
	for id in Uniques.ids():
		var D: Dictionary = Uniques.def(id)
		if str(D["slot"]) != "weapon" and not D["affixes"].has("xp") and not D["affixes"].has("gold"):
			plain_ids.append(id)
	var cap_hits := 0
	var cap_over := 0
	seed(11)
	for n in 12:
		var cpn = new_cp.call()
		var src: Dictionary = Uniques.make(str(plain_ids[n % plain_ids.size()]), 1 + n) if n % 3 != 2 else Sets.make(set_id, "amulet", 1 + n)
		cpn.add_item(src)
		var got := ""
		for k in 60:
			var keys: Array = src["affixes"].keys()
			got = CR.reforge(cw, cpn, int(src["uid"]), str(keys[keys.size() - 1]))
			if got in ["xp", "gold"]:
				break
		if not got in ["xp", "gold"]:
			continue
		cap_hits += 1
		if float(src["affixes"][got]) > cap + 1e-9:
			cap_over += 1
		if n % 2 == 0:
			src["affixes"][got] = cap + 5.0  # стара річ із завеликим значенням
		CR.renew(cw, cpn, int(src["uid"]), 1)
		CR.renew(cw, cpn, int(src["uid"]))
		if float(src["affixes"][got]) * top > 16.7 + 1e-6:
			cap_over += 1
	check(cap_hits >= 6 and cap_over == 0, "перекування на досвід чи гривні й оновлення (%d речей) не дають більше 16,7%% при +10" % cap_hits)
	# ---- Збереження ----
	var gs: Dictionary = Uniques.make(gid, 50)
	cp.add_item(gs)
	var gs_fresh: String = CR.reforge(cw, cp, int(gs["uid"]), "vit")
	var gs_aff: String = var_to_str(gs["affixes"])
	SaveSystem.save({"player": cp.to_dict(), "world": cw.to_dict(), "meta": {"playtime": 0.0}}, TEST_SAVE)
	var ld: Dictionary = SaveSystem.load_data(TEST_SAVE)
	var lp = _new_player()
	lp.from_dict(ld.get("player", {}))
	var lg: Dictionary = lp.find_item(int(gs["uid"]))
	check(gs_fresh != "" and not lg.is_empty() and var_to_str(lg["affixes"]) == gs_aff and str(lg.get("unique", "")) == gid, "перекована золота річ пережила збереження й завантаження без змін")
	SaveSystem.delete(TEST_SAVE)
	# ---- Кузня на екрані ----
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full", "kleinody"]:
		gw.hints[k] = true
	gp.level = 60
	gp.gold = 10000000
	gp.resources = {"wood": 100000, "iron": 100000, "herbs": 100000, "trophy": 100000}
	_quests_set(gw, "story", {"chapter": 6, "step": 0, "stage": "done", "progress": 0})
	gw.camp["buildings"] = {"kuznia": 3}
	var ui_set: Dictionary = Sets.make(set_id, "belt", 50)
	var ui_gold: Dictionary = Uniques.make(gid, 50)
	gp.add_item(ui_set)
	gp.add_item(ui_gold)
	game.enter_camp()
	await _frames(2)
	var open_forge := func() -> bool:
		for tc in game.hud.screen_root.find_children("*", "TabContainer", true, false):
			for i in tc.get_tab_count():
				if tc.get_tab_title(i) == "Кузня":
					game.camp_tab = i
					tc.current_tab = i
					return true
		return false
	var reforge_buttons := func() -> int:
		var n := 0
		for b in game.hud.screen_root.find_children("*", "Button", true, false):
			if b.is_visible_in_tree() and str(b.text).begins_with("↻ "):
				n += 1
		return n
	check(open_forge.call(), "на хуторі є вкладка «Кузня»")
	await _frames(2)
	for it in [ui_set, ui_gold]:
		game.camp_do("select", int(it["uid"]))
		await _frames(2)
		open_forge.call()
		await _frames(2)
		var nb: int = reforge_buttons.call()
		check(nb == it["affixes"].size(), "кузня: у %s є кнопки перекування (%d)" % ["наборної речі" if it.has("set") else "золотої речі", nb])
	# ---- Довідник ----
	var all_text := ""
	var forge_txt := ""
	for sec in WS.sections():
		for e in sec["entries"]:
			all_text += str(e["text"]) + "\n"
			if str(e["title"]) == "Кування":
				forge_txt = str(e["text"])
	check(not "не перековуються" in all_text and not "сталі властивості" in all_text and "золотої й наборної теж" in forge_txt and not "—" in forge_txt, "довідник: золоті й наборні речі перековуються")
	game.queue_free()
	await _frames(3)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


## Що намальовано в значку: шлях текстури, а для вирізки з аркуша ще й шматок аркуша.
func _tex_key(t: TextureRect) -> String:
	if t == null or t.texture == null:
		return ""
	if t.texture is AtlasTexture:
		return "%s@%s" % [t.texture.atlas.resource_path, str(t.texture.region)]
	return t.texture.resource_path


## Те саме для значка поза деревом сцени: ключ, а сам значок звільнити.
func _key_free(t: TextureRect) -> String:
	var k := _tex_key(t)
	t.free()
	return k


## Значок усередині клітинки (перший TextureRect).
func _cell_tex(cell: Control) -> TextureRect:
	var ts: Array = cell.find_children("*", "TextureRect", true, false)
	return ts[0] if not ts.is_empty() else null


func _suite_artifact_bag_icon() -> void:
	suite("Артефакт у торбі намальований так само, як у крамниці")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var UKit = load("res://scripts/ui/ui_kit.gd")
	var UShop = load("res://scripts/ui/ui_shop.gd")
	var UChar = load("res://scripts/ui/ui_character.gd")
	var UCamp = load("res://scripts/ui/ui_camp.gd")
	var Arts = load("res://scripts/data/artifacts.gd")
	var Gfx = load("res://scripts/world/gfx.gd")
	var Sets = load("res://scripts/data/sets.gd")
	var Uniques = load("res://scripts/data/uniques.gd")
	var generic: String = _key_free(UKit.icon("it_artifact", 48))
	# ---- Кожен артефакт: клітинка торби й клітинка крамниці показують те саме ----
	var same := 0
	var sprites := 0
	var no_sprite := []
	var bad := []
	var by_boss := {}
	for id in Arts.ids():
		var boss: String = str(Arts.def(id)["boss"])
		var shop_ic: TextureRect = UShop._goods_icon("artifact", id, null)
		var want: String = _key_free(UKit.sprite_icon(boss, 48)) if Gfx.has(boss) else generic
		for px in [66, 70]:
			var cell: Button = UKit.item_cell(Arts.make(id), func(): pass, false, px)
			var k: String = _tex_key(_cell_tex(cell))
			if k == _tex_key(shop_ic) and k == want and k != "":
				same += 1
			else:
				bad.append("%s/%d" % [id, px])
			cell.free()
		if Gfx.has(boss):
			sprites += 1
			by_boss[boss] = _tex_key(shop_ic)
		else:
			no_sprite.append(id)
		shop_ic.free()
	check(bad.is_empty() and same == Arts.ids().size() * 2, "кожен артефакт у клітинці торби (66 і 70) має той самий значок, що в крамниці: %d, розбіжності %s" % [same, str(bad)])
	check(sprites >= 6 and sprites + no_sprite.size() == Arts.ids().size(), "спрайт боса мають %d артефактів, без спрайта %s" % [sprites, str(no_sprite)])
	var drawn := []  # артефакти, чий бос має спрайт
	for id in Arts.ids():
		if not id in no_sprite:
			drawn.append(id)
	# ---- Різні боси дають різні значки ----
	var a0: String = drawn[0]
	var a1: String = drawn[1]
	var c0: Button = UKit.item_cell(Arts.make(a0), func(): pass, false, 70)
	var c1: Button = UKit.item_cell(Arts.make(a1), func(): pass, false, 70)
	var k0: String = _tex_key(_cell_tex(c0))
	var k1: String = _tex_key(_cell_tex(c1))
	check(Arts.def(a0)["boss"] != Arts.def(a1)["boss"] and k0 != k1 and k0 != generic and k1 != generic, "два артефакти різних босів у торбі різні: %s і %s" % [k0, k1])
	var uniq := {}
	for b in by_boss:
		uniq[by_boss[b]] = true
	check(uniq.size() == by_boss.size(), "усі %d боси дають різні значки" % by_boss.size())
	# вписаний у клітинку: того самого розміру й на тому самому місці, що й звичайний значок
	var plain0: Button = UKit.item_cell(Data.gen_item(20, 2, "head"), func(): pass, false, 70)
	var t0: TextureRect = _cell_tex(c0)
	var tp: TextureRect = _cell_tex(plain0)
	var fit := t0.custom_minimum_size == tp.custom_minimum_size and t0.position == tp.position and t0.custom_minimum_size == Vector2(48, 48) \
		and t0.stretch_mode == TextureRect.STRETCH_KEEP_ASPECT_CENTERED and t0.expand_mode == TextureRect.EXPAND_IGNORE_SIZE
	var priced: Button = UKit.item_cell(Arts.make(a0), func(): pass, false, 66, false, "123")
	var tpr: TextureRect = _cell_tex(priced)
	check(fit and tpr.custom_minimum_size == Vector2(36, 36) and _tex_key(tpr) == k0, "спрайт боса вписаний у клітинку, як звичайний значок, і з підписом під ним")
	# решта клітинки артефакта як була: тло й рамка за рідкістю, вибір
	var csel: Button = UKit.item_cell(Arts.make(a0), func(): pass, true, 70)
	var col: Color = Data.item_color(Arts.make(a0))
	var sb: StyleBoxFlat = c0.get_theme_stylebox("normal")
	var sbs: StyleBoxFlat = csel.get_theme_stylebox("normal")
	check(sb.bg_color == col.darkened(0.74) and sb.border_color == col.darkened(0.2) and sbs.bg_color == col.darkened(0.5) and c0.find_children("*", "TextureRect", true, false).size() == 1, "тло, рамка й вибір клітинки артефакта не змінились, значок один")
	for n in [c0, c1, plain0, priced, csel]:
		n.free()
	# ---- Без спрайта боса лишається загальний ромб ----
	for id in no_sprite:
		var cn: Button = UKit.item_cell(Arts.make(id), func(): pass, false, 70)
		check(_tex_key(_cell_tex(cn)) == generic, "артефакт %s: спрайта боса нема, у торбі загальний значок, як і в крамниці" % id)
		cn.free()
	var ghost: Dictionary = Arts.make(a0)
	ghost["artifact"] = "nema_takoho"
	var cg: Button = UKit.item_cell(ghost, func(): pass, false, 70)
	check(_tex_key(_cell_tex(cg)) == generic and generic != "" and _key_free(UKit.artifact_icon("nema_takoho", 48)) == generic, "артефакт без спрайта боса має загальний значок і не падає")
	cg.free()
	# ---- Звичайна, золота й наборна речі як були ----
	var kinds := {"звичайна": Data.gen_item(20, 2, "head"), "зброя": Data.gen_item(20, 3, "weapon"), "золота": Uniques.make("oberih_berehyni", 40), "наборна": Sets.make(Sets.ids()[0], "belt", 60)}
	var kinds_ok := true
	for kn in kinds:
		var it: Dictionary = kinds[kn]
		var cell: Button = UKit.item_cell(it, func(): pass, false, 70)
		var t: TextureRect = _cell_tex(cell)
		kinds_ok = kinds_ok and _tex_key(t) == _key_free(UKit.icon(UKit.item_icon_id(it), 48)) and t.custom_minimum_size == Vector2(48, 48) and t.texture_filter == CanvasItem.TEXTURE_FILTER_NEAREST
		cell.free()
	check(kinds_ok, "звичайна річ, зброя, золота й наборна малюються своїми значками, як і раніше")
	# ---- На екрані героя й у скрині ----
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full", "kleinody"]:
		gw.hints[k] = true
	gp.level = 30
	var want_keys := []
	for i in 3:
		gp.add_item(Arts.make(drawn[i]), true)
		want_keys.append(_key_free(UKit.artifact_icon(drawn[i], 48)))
	gp.recalc()
	game.enter_map()
	await _frames(2)
	game.char_tab = 1
	game.open_character()
	await _frames(2)
	var htc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	htc.current_tab = 0  # вкладка «Герой» будується, коли її відкривають
	await _frames(1)
	var hkeys := {}
	for c in _cells(htc.get_tab_control(0), UChar.CELL):
		hkeys[_tex_key(_cell_tex(c))] = true
	var hero_ok := true
	for wk in want_keys:
		hero_ok = hero_ok and hkeys.has(wk)
	check(hero_ok and not hkeys.has(generic), "торба на екрані героя показує артефакти спрайтами їхніх босів, загального ромба нема")
	game.close_character()
	await _frames(2)
	game.account.put_item(Arts.make(drawn[5]), game.world)
	game.camp_tab = 0
	game.enter_camp()
	await _frames(2)
	var ctc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	var chest_i := -1
	for i in ctc.get_tab_count():
		if ctc.get_tab_title(i) == "Скриня":
			chest_i = i
	ctc.current_tab = chest_i
	await _frames(1)
	var ckeys := {}
	for c in _cells(ctc.get_tab_control(chest_i), UCamp.CHEST_CELL):
		ckeys[_tex_key(_cell_tex(c))] = true
	var chest_ok: bool = chest_i >= 0 and ckeys.has(_key_free(UKit.artifact_icon(drawn[5], 48)))
	for wk in want_keys:
		chest_ok = chest_ok and ckeys.has(wk)
	check(chest_ok and not ckeys.has(generic), "у скрині роду й торбі поруч артефакти теж зі спрайтами босів")
	game.queue_free()
	await _frames(3)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


## Приголомшений ворог під ударами: відкидання лишається, але за край арени його не виносить.
func _suite_stun_arena() -> void:
	suite("Приголомшений ворог не вилітає за край арени")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full"]:
		gw.hints[k] = true
	game.enter_location("wild_field")
	await _frames(4)
	_clear_enemies(game)
	var c = game.combat
	var ar: Rect2 = c.arena
	var gap := 40.0  # ближче до краю, ніж відкидає за кілька кадрів
	var spawn := func(pos: Vector2):
		c.spawn_enemy("upyr", 5, false, pos)
		var e = c._last_enemy()
		e.max_hp = 1.0e9
		e.hp = e.max_hp
		return e
	# Чи ворог у межах арени, звуженої на його радіус (з невеликим допуском на округлення)
	var inside := func(e) -> bool:
		var pad := Vector2(e.radius, e.radius) - Vector2(0.01, 0.01)
		return Rect2(ar.position + pad, ar.size - pad * 2.0).has_point(e.position)
	# Б'ємо приголомшеного: щокілька кадрів відкидання додається знову, як від нових ударів
	var pound := func(e, kb: Vector2, frames: int) -> bool:
		var ok := true
		for i in frames:
			gp.hp = gp.max_hp
			gp.invuln = 1.0
			e.stun = 5.0
			if i % 8 == 0:
				e.knockback += kb
			await process_frame
			if not inside.call(e):
				ok = false
		return ok
	check(ar.size.x > 400.0 and ar.size.y > 400.0, "арена бою має розмір")
	# 1. Біля правого краю, сильне відкидання назовні
	var e1 = spawn.call(Vector2(ar.end.x - gap, ar.get_center().y))
	check(await pound.call(e1, Vector2(3000, 0), 60), "приголомшений біля правого краю під ударами назовні лишається в арені")
	check(absf(e1.position.x - (ar.end.x - e1.radius)) < 1.0, "його притиснуло до краю, а не зупинило раніше")
	# 2. Біля лівого краю, відкидання ліворуч
	var e2 = spawn.call(Vector2(ar.position.x + gap, ar.get_center().y + 120.0))
	check(await pound.call(e2, Vector2(-3000, 0), 60), "приголомшений біля лівого краю під ударами назовні лишається в арені")
	# 3. Кут: назовні за обома осями
	var e3 = spawn.call(ar.end - Vector2(gap, gap))
	check(await pound.call(e3, Vector2(2500, 2500), 60), "приголомшений у куті під ударами навскіс лишається в арені")
	check(absf(e3.position.x - (ar.end.x - e3.radius)) < 1.0 and absf(e3.position.y - (ar.end.y - e3.radius)) < 1.0, "у куті його притиснуло до обох країв")
	var e4 = spawn.call(ar.position + Vector2(gap, gap))
	check(await pound.call(e4, Vector2(-2500, -2500), 60), "приголомшений у протилежному куті лишається в арені")
	for e in [e1, e2, e3, e4]:
		e.stun = 0.0
		e.knockback = Vector2.ZERO
	_clear_enemies(game)
	await _frames(2)
	# 4. Посеред арени відкидання й далі штовхає приголомшеного
	var mid := ar.get_center() + Vector2(0, -150)
	var e5 = spawn.call(mid)
	e5.stun = 5.0
	e5.knockback = Vector2(600, 0)
	for i in 10:
		gp.invuln = 1.0
		e5.stun = 5.0
		await process_frame
	check(e5.position.x - mid.x > 40.0 and absf(e5.position.y - mid.y) < 1.0, "посеред арени приголомшеного відкидає, як і раніше")
	check(e5.knockback.length() < 600.0, "відкидання приголомшеного й далі згасає")
	_clear_enemies(game)
	await _frames(2)
	# 5. Не приголомшений біля краю: як і раніше, лишається в арені
	var e6 = spawn.call(Vector2(ar.end.x - gap, ar.get_center().y))
	var ok6 := true
	for i in 60:
		gp.hp = gp.max_hp
		gp.invuln = 1.0
		e6.stun = 0.0
		if i % 8 == 0:
			e6.knockback += Vector2(3000, 0)
		await process_frame
		if not inside.call(e6):
			ok6 = false
	check(ok6, "не приголомшений біля краю під відкиданням лишається в арені")
	_clear_enemies(game)
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


func _suite_mechanics() -> void:
	suite("Механіки нечисті: кожна стає до бою")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gp = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "bag_full",
			"enrage", "pushkar_misfire", "idol_feast", "karachun_wind", "vii_gaze", "velnias_trick", "baba_gold"]:
		game.world.hints[k] = true
	game.enter_location("wild_field")
	await _frames(4)
	_clear_enemies(game)
	await _frames(1)
	var c = game.combat
	var M = load("res://scripts/mechanics/mechanic.gd")
	var spot: Vector2 = gp.global_position + Vector2(0, -300)
	var bad := []
	for id in GameDB.mob_ids():
		for b in [false, true]:
			var ref: String = GameDB.mechanic(id, b)
			if ref == "":
				continue
			gp.hp = gp.max_hp
			gp.invuln = 5.0
			c.spawn_enemy(id, 20, b, spot)
			var e = c._last_enemy()
			var ok: bool = e.kind == id and e.mechanic != null and e.mechanic.get_script() == M.script_of(ref) and e._mech_boss == b
			for round in (2 if b and GameDB.is_phase2_boss(id) else 1):
				for i in (5 if b else 1):
					if not is_instance_valid(e) or e.dead:
						break
					e.ability_timer = 0.0
					e.cast_time = 0.0
					if b:
						e._boss_ability(gp)
					elif e._trick:
						e._minion_ability(gp, 300.0)
					else:
						e.ability_timer = 1.0  # прийому нема: перевіряємо лише, що бій іде
					ok = ok and e.ability_timer > 0.0
				if e._mh & M.VOLLEY:
					var n0: int = c.effects.get_child_count()
					e.mechanic.volley(Vector2.DOWN)
					ok = ok and (c.effects.get_child_count() > n0 or ("feast" in e.mechanic and e.mechanic.feast > 0.0))
				await _frames(3)
				if round == 0 and b and GameDB.is_phase2_boss(id) and is_instance_valid(e):
					e.exposed = 0.0
					e.take_damage(e.max_hp * 0.55 / maxf(0.1, e.dmg_taken_mult), Vector2.ZERO)
					ok = ok and e.phase2
			if not ok:
				bad.append(ref)
			_clear_enemies(game)
			for n in c.effects.get_children():
				n.queue_free()
			await _frames(1)
	check(bad.is_empty(), "кожна механіка (звичайна й босова, до й після люті) стає до справжнього бою й робить свій прийом%s" % ("" if bad.is_empty() else ": " + str(bad)))
	# Заражений гине й лишає хмару; заражена еліта з «чумою» — лише одну
	for affs in [[], ["plague"]]:
		c.spawn_enemy("zarazhenyi", 5, false, spot)
		var z = c._last_enemy()
		if not affs.is_empty():
			z.make_elite(affs)
		var clouds0 := 0
		for n in c.effects.get_children():
			if n.get_script() != null and str(n.get_script().resource_path).ends_with("plague_cloud.gd") and not n.is_queued_for_deletion():
				clouds0 += 1
		z.take_damage(1.0e9, Vector2.ZERO)
		var clouds := 0
		for n in c.effects.get_children():
			if n.get_script() != null and str(n.get_script().resource_path).ends_with("plague_cloud.gd") and not n.is_queued_for_deletion():
				clouds += 1
		check(clouds == clouds0 + 1, "заражений%s гине й лишає одну хмару зарази" % (" з «чумою»" if not affs.is_empty() else ""))
		await _frames(1)
	_clear_enemies(game)
	game.queue_free()
	await _frames(2)


## Шукає в переліку проблем кожен очікуваний шматок; повертає ті, яких не знайшлося.
func _missed(found: Array, expect: Array) -> Array:
	var out := []
	for x in expect:
		var hit := false
		for p in found:
			hit = hit or x in str(p)
		if not hit:
			out.append(x)
	return out


