## Вигаданий крок для рушія: лінія, на кого чекає, мета.
func _qstep(line: String, after: Array, obj: Dictionary, extra: Dictionary = {}) -> Dictionary:
	var r := {"line": line, "giver": "kobzar", "city": "sich", "turn_in": "", "start": [], "end": [], "reward": {}, "objective": obj}
	if not after.is_empty():
		r["after"] = after
	r.merge(extra, true)
	return r


func _suite_quest_engine() -> void:
	suite("Рушій завдань: вигадані лінії")
	var Q = load("res://scripts/game/quest_engine.gd")
	var talk := [["kobzar", "Слухай."]]
	# Головна лінія: m1 → (гілки b1 / b2 за вибором «k») → m2 (з 3-го рівня) → m3 (чекає й на обов'язкову
	# паралельну req); opt — необов'язкова паралельна місія, на неї не чекає ніхто. Побічна лінія side — з 5-го рівня.
	var lines := {"main": {"kind": "story", "story": true}, "par": {"kind": "story", "story": true}, "side": {"kind": "legend", "min_level": 5}}
	var steps := {
		"m1": _qstep("main", [], {"type": "clear", "loc": "wild_field", "text": "Перша мета"}, {"choices": [{"text": "a"}, {"text": "b"}], "choice_key": "k"}),
		"b1": _qstep("main", ["m1"], {"type": "visit", "loc": "kyiv", "text": "Гілка a"}, {"if": "k=0"}),
		"b2": _qstep("main", ["m1"], {"type": "visit", "loc": "lviv", "text": "Гілка b"}, {"if": "k=1"}),
		"m2": _qstep("main", ["b1", "b2"], {"type": "kill", "enemy": "zarazhenyi", "count": 3, "loc": "wild_field", "text": "Три вороги"}, {"min_level": 3, "start": talk}),
		"req": _qstep("par", ["m1"], {"type": "dungeon", "loc": "zmii_cave", "text": "Обов'язкова"}, {"start": talk}),
		"opt": _qstep("par", ["m1"], {"type": "dungeon", "loc": "crypt", "text": "Необов'язкова"}, {"start": talk, "story": false}),
		"m3": _qstep("main", ["m2", "req"], {"type": "clear", "loc": "rapids", "text": "Фінал"}, {"start": talk}),
		"s1": _qstep("side", [], {"type": "kill", "enemy": "zarazhenyi", "count": 2, "loc": "wild_field", "text": "Побічна"}, {"start": talk}),
	}
	check(GameDB.quest_graph_problems(lines, {"story": steps}).is_empty(), "вигаданий граф без проблем: %s" % str(GameDB.quest_graph_problems(lines, {"story": steps})))
	Q.use_graph(Q.make_graph(lines, steps))
	var w = WorldState.new()
	var p = _new_player()
	w.hero_level = 1
	# Позначка сюжету
	check(Q.is_story("m1") and Q.is_story("req") and not Q.is_story("opt") and not Q.is_story("s1"), "«story» кроку й лінії: m1, req — сюжетні; opt (свій false) і s1 (лінія без позначки) — ні")
	# Початок: m1 без розмови активний сам; побічна лінія закрита рівнем
	check(Q.missions(w) == ["m1"] and Q.stage(w, "m1") == "active" and Q.stage(w, "s1") == "level" and Q.level_needed("s1") == 5 and Q.stage(w, "m2") == "locked", "спершу відкрито лише m1; s1 чекає 5-го рівня")
	check(w.missions["done"].is_empty() and w.missions["active"].is_empty(), "крок, що почався сам, у стан не пишеться до першого поступу")
	check(Q.on_event(w, p, "clear", "rapids").is_empty() and Q.stage(w, "m1") == "active", "чужа подія не зараховується")
	Q.set_choice(w, "k", 1)
	var msgs: Array = Q.on_event(w, p, "clear", "wild_field")
	check(Q.is_done(w, "m1") and not msgs.is_empty(), "m1 виконано: без «turn_in» здається одразу")
	# Невдала умова: b1 пропущено, на b2 чекають
	check(Q.stage(w, "b1") == "skip" and Q.is_finished(w, "b1") and not Q.is_done(w, "b1") and Q.stage(w, "b2") == "active", "умова «k=0» не справдилась: b1 пропущено, b2 відкрито")
	# Кілька місій одразу: b2, req, opt
	check(Q.missions(w) == ["b2", "req", "opt"] and Q.stage(w, "req") == "offer" and Q.stage(w, "opt") == "offer", "відкриті водночас: гілка, обов'язкова й необов'язкова місії (%s)" % str(Q.missions(w)))
	Q.on_event(w, p, "visit", "lviv")
	check(Q.is_done(w, "b2") and Q.stage(w, "m2") == "level" and Q.level_needed("m2") == 3, "m2 дочекалась гілки, але просить 3-й рівень")
	w.hero_level = 2
	check(Q.stage(w, "m2") == "level" and not "m2" in Q.missions(w), "на 2-му рівні m2 ще закрито")
	w.hero_level = 3
	check(Q.stage(w, "m2") == "offer" and "m2" in Q.missions(w), "з 3-го рівня m2 пропонують")
	# Дві місії з однаковою метою — кожна зі своїм лічильником
	w.hero_level = 5
	check(Q.stage(w, "s1") == "offer", "з 5-го рівня відкривається й побічна лінія")
	Q.start(w, "m2")
	Q.start(w, "s1")
	Q.on_event(w, p, "kill", "zarazhenyi")
	check(Q.progress(w, "m2") == 1 and Q.progress(w, "s1") == 1, "обидві активні місії рахують свого ворога")
	Q.on_event(w, p, "kill", "zarazhenyi")
	check(Q.progress(w, "m2") == 2 and Q.stage(w, "m2") == "active" and Q.stage(w, "s1") == "turnin" and Q.progress(w, "s1") == 2, "s1 (2 вороги) виконано, m2 (3) ще ні: лічильники окремі")
	Q.on_event(w, p, "kill", "zarazhenyi")
	check(Q.is_done(w, "m2") and Q.progress(w, "s1") == 2 and Q.stage(w, "s1") == "turnin", "третій ворог іде лише в m2")
	# Обов'язкова паралельна місія тримає m3, необов'язкова — ні
	check(Q.stage(w, "m3") == "locked", "m2 здано, але m3 чекає й на обов'язкову req")
	Q.start(w, "req")
	Q.on_event(w, p, "dungeon", "zmii_cave")
	check(Q.is_done(w, "req") and Q.stage(w, "m3") == "offer" and Q.stage(w, "opt") == "offer", "req здано: m3 відкрито, хоч необов'язкову opt ніхто не брав")
	check(Q.missions(w) == ["m3", "opt", "s1"] and Q.missions_of(w, ["legend"]) == ["s1"], "порядок місій: спершу сюжетні, далі решта (%s)" % str(Q.missions(w)))
	check(Q.line_next(w, "main") == "m3" and Q.line_started(w, "side") and not Q.line_finished(w, "main") and Q.line_open(w, "side"), "лінія: наступний крок, почата, пройдена, відкрита")
	Q.start(w, "m3")
	Q.on_event(w, p, "clear", "rapids")
	check(Q.line_finished(w, "main") and not Q.line_finished(w, "par"), "головну лінію пройдено, необов'язкова лишилась")
	# Зміна стану видна одразу (підрахунок не застаріває)
	Q.complete(w, "opt")
	check(Q.line_finished(w, "par") and not "opt" in Q.missions(w), "здане зникає з місій одразу")
	# Збереження: лише id і лічильники
	var w2 = WorldState.new()
	w2.from_dict(w.to_dict())
	w2.hero_level = 5
	check(Q.missions(w2) == ["s1"] and Q.stage(w2, "s1") == "turnin" and Q.progress(w2, "s1") == 2 and Q.chose(w2, "k=1"), "поступ зберігається з героєм")
	# place_at: усі попередники здано, крім пропущених
	var w3 = WorldState.new()
	w3.hero_level = 9
	Q.set_choice(w3, "k", 0)
	Q.place_at(w3, "m3", "active", 0)
	check(Q.is_done(w3, "b1") and Q.stage(w3, "b2") == "skip" and Q.is_done(w3, "req") and not Q.is_done(w3, "opt") and Q.stage(w3, "m3") == "active", "place_at ставить героя на крок")
	Q.use_graph({})
	p.free()
	# Перевірка графа: коло, посилання в нікуди, недосяжний крок, умова не з попередника, повтор id
	var bad := steps.duplicate(true)
	bad["m1"]["after"] = ["m3"]
	bad["s1"]["after"] = ["nema"]
	bad["b1"]["if"] = "k2=0"
	var pr := GameDB.quest_graph_problems(lines, {"story": bad})
	check(_has_problem(pr, ["замикає коло"]) and _has_problem(pr, ["story/s1", "нема кроку «nema»"]) and _has_problem(pr, ["story/m2", "недосяжний"]) and _has_problem(pr, ["story/b1", "«k2»"]), "коло, «after» у нікуди, недосяжні кроки, невідомий вибір: %s" % str(pr))
	bad = steps.duplicate(true)
	bad["b1"]["if"] = "k=0"
	bad["m1"]["if"] = "k=1"
	pr = GameDB.quest_graph_problems(lines, {"story": bad, "saga": {"m2": bad["m2"]}})
	check(_has_problem(pr, ["story/m1", "«if»", "не серед тих, на які цей крок чекає"]) and _has_problem(pr, ["saga/m2", "такий id кроку вже є"]) and not _has_problem(pr, ["story/b1", "«if»"]), "умова читає лише вибір попередника; id не повторюються: %s" % str(pr))
	bad = steps.duplicate(true)
	bad["opt"]["line"] = "nova"
	pr = GameDB.quest_graph_problems(lines, {"story": bad})
	check(_has_problem(pr, ["story/opt", "нема лінії «nova»"]), "крок без лінії: %s" % str(pr))
	# Таблиці бази: граф справжніх даних без проблем, кожна лінія має кроки
	check(GameDB.quest_graph_problems(GameDB.table("quest_lines"), {"story": GameDB.table("story"), "legend_steps": GameDB.table("legend_steps"), "saga": GameDB.table("saga")}).is_empty(), "граф справжніх завдань без проблем")
	var raw: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("legend_steps")))
	raw["vii_2"]["after"] = "vii_1"
	check(_has_problem(GameDB.validate("legend_steps", raw), ["legend_steps/vii_2.after", "має бути"]), "«after» у файлі — лише список")
	raw = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("legend_steps")))
	raw["vii_2"]["after"] = []
	raw["vii_3"]["min_level"] = 0
	raw["vii_3"]["story"] = false
	pr = GameDB.validate("legend_steps", raw)
	check(_has_problem(pr, ["legend_steps/vii_2", "«after» порожній"]) and _has_problem(pr, ["legend_steps/vii_3", "«min_level»"]) and not _has_problem(pr, ["legend_steps/vii_3", "«story» пишеться лише як true"]), "порожній «after», нульовий рівень; «story»: false у кроці можна: %s" % str(pr))
	# Справжні дані: позначка сюжету сьогодні
	check(Q.is_story("village") and Q.is_story("kremlin") and Q.is_story("saga_dev") and Q.is_story("vii_1") and Q.kind_of("vii_1") == "legend" and Q.level_needed("vii_1") == 27 and Q.level_needed("vii_2") == 27 and Q.level_needed("saga_dev") == 90 and Q.level_needed("saga_khala") == 0
		and not Q.is_story("tower_intro") and Q.level_needed("tower_intro") == 38, "історія, перекази й сага — сюжетні, доручення — ні; рівень кроку свій, рівень лінії — на її першому кроці")
	# Перестановка таблиць не міняє рушія: той самий стан — ті самі місії
	var rl := {}
	var keys: Array = GameDB.ids("quest_lines").duplicate()
	keys.reverse()
	for k in keys:
		rl[k] = GameDB.row("quest_lines", k)
	var rs := {}
	var sk: Array = GameDB.quest_steps().keys()
	sk.reverse()
	for k in sk:
		rs[k] = GameDB.quest_steps()[k]
	var w4 = WorldState.new()
	w4.hero_level = 40
	_quests_set(w4, "story", {"chapter": 2, "step": 3, "stage": "active", "progress": 2, "choices": {"trial": 1}})
	_quests_set(w4, "legends", {"vii": {"step": 1, "stage": "active", "progress": 3}, "drakula": {"step": 0, "stage": "turnin", "progress": 0}})
	var before_ms: Array = Q.missions(w4).duplicate()
	before_ms.sort()
	Q.use_graph(Q.make_graph(rl, rs))
	var after_ms: Array = Q.missions(w4).duplicate()
	after_ms.sort()
	check(before_ms == after_ms and Q.stage(w4, "samples") == "active" and Q.progress(w4, "samples") == 2 and Q.stage(w4, "vii_2") == "active" and Q.is_skipped(w4, "oath") and Q.is_done(w4, "volkhv_trial"), "таблиці в іншому порядку — ті самі місії: %s" % str(after_ms))
	Q.use_graph({})
	check(Q.missions(w4).size() == before_ms.size() and Q.graph()["line_of"].has("village"), "назад до таблиць бази")


## Крок доручення для вигаданих таблиць (той самий вигляд, що в side.json).
func _side_step(after: Array, title: String, obj: Dictionary, extra: Dictionary = {}) -> Dictionary:
	var r := {"line": "dor", "title": title, "giver": "kobzar", "city": "sich", "turn_in": "sich", "start": [["kobzar", "Є діло."]], "end": [["kobzar", "Дякую."]], "reward": {}, "objective": obj}
	if not after.is_empty():
		r["after"] = after
	r.merge(extra, true)
	return r


## Тексти всіх написів під вузлом (Label і кнопки).
func _texts_under(n: Node) -> String:
	var out := []
	for c in n.find_children("*", "Label", true, false):
		out.append(c.text)
	for c in n.find_children("*", "Button", true, false):
		out.append(c.text)
	return "\n".join(out)


## Місії: позначка «★»/«!», місія, що чекає рівня, рівень бою місії, доручення з метою «stat», старі герої.
## На вигаданих таблицях (QuestEngine.use_graph): справжніх доручень і рівнів на кроках історії ще нема.
func _suite_mission_rules() -> void:
	suite("Місії: позначки, рівень, доручення")
	var Q = load("res://scripts/game/quest_engine.gd")
	var JS = load("res://scripts/game/journal_service.gd")
	var GS = load("res://scripts/game/guide_service.gd")
	var Side = load("res://scripts/game/side_service.gd")
	var CS = load("res://scripts/game/challenge_service.gd")
	var LS = load("res://scripts/game/legend_service.gd")
	var SS = load("res://scripts/game/story_service.gd")
	var Story = load("res://scripts/data/story.gd")
	var GameS = load("res://scripts/game/game.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var talk := [["kobzar", "Слухай."]]
	var bye := [["kobzar", "Дякую."]]
	var kob: String = "%s (%s)" % [Story.npc_name("kobzar"), Data.place_name("sich")]
	# ---- Позначка: одна функція, від даних ----
	check(Q.mark("village") == "★" and Q.mark("kremlin") == "★" and Q.mark("saga_dev") == "★" and Q.mark("vii_1") == "★" and Q.mark("drakula_3") == "★" and Q.mark("tower_intro") == "!", "сьогодні: історія, перекази й сага — зірка, доручення — знак оклику")
	var flip_lines := {}
	for k in GameDB.ids("quest_lines"):
		flip_lines[k] = GameDB.row("quest_lines", k).duplicate()
	flip_lines["vii"]["story"] = true
	flip_lines["story"]["story"] = false
	var flip_steps: Dictionary = GameDB.quest_steps().duplicate()
	var v3: Dictionary = flip_steps["vii_3"].duplicate(true)
	v3["story"] = false
	flip_steps["vii_3"] = v3
	var v1: Dictionary = flip_steps["vii_1"].duplicate(true)
	v1.erase("after")  # переказ відкритий одразу, поруч із першим кроком історії
	flip_steps["vii_1"] = v1
	Q.use_graph(Q.make_graph(flip_lines, flip_steps))
	var wf = WorldState.new()
	var pf = _new_player()
	wf.hero_level = 30
	pf.level = 30
	check(Q.mark("vii_1") == "★" and Q.mark("vii_3") == "!" and Q.mark("village") == "!" and Q.mark("saga_dev") == "★", "«story» лінії чи кроку в даних міняє позначку без коду")
	var fsecs: Array = JS.sections(wf, pf)
	var vii_row := ""
	for sec in fsecs:
		for r in sec["rows"]:
			if "Три ночі" in str(r["text"]):
				vii_row = str(r["text"])
	check(str(fsecs[0]["rows"][0]["text"]).begins_with("! ") and vii_row.begins_with("★ "), "журнал: позначка за даними (історія «!», Вій «★»): %s / %s" % [fsecs[0]["rows"][0]["text"], vii_row])
	var fmm: Dictionary = Q.map_marks(wf)
	check(fmm["stars"].has("kyiv") and fmm["marks"].has("ridne_selo") and not fmm["stars"].has("ridne_selo"), "мапа: позначка за даними: %s" % str(fmm))
	var fg: Array = GS.items(wf, pf, "sich")
	var fstory := ""
	for it in fg:
		if str(it["kind"]) == "story":
			fstory = str(it["text"])
	check(fstory.begins_with("! Історія: "), "порадник: позначка за даними: «%s»" % fstory)
	check(SS.mission_line(wf, "village").begins_with("! ") and SS.objective_line(wf).begins_with("★ Переказ «Три ночі"), "рядок мети (підказка над боєм) — теж за даними: %s" % SS.objective_line(wf))
	Q.use_graph({})
	check(Q.mark("vii_3") == "★" and Q.mark("village") == "★" and Q.after("vii_1") == ["solovei_3", "sorcerer"], "назад до таблиць бази")
	# Позначка вкладки ратуші: зірка, коли є сюжетна місія, інакше знак оклику; відмови не рахуються
	check(GameS.hall_badge([{"kind": "legend", "mark": "!"}, {"kind": "story", "mark": "★"}]) == "★" and GameS.hall_badge([{"kind": "legend", "mark": "!"}, {"kind": "hero", "mark": ""}]) == "!"
		and GameS.hall_badge([{"kind": "hero", "mark": ""}]) == "" and GameS.hall_badge([{"kind": "wait", "mark": "★"}]) == "", "вкладка ратуші: ★ / ! / без позначки")
	# ---- Доручення й мета «stat» на вигаданих таблицях ----
	# a → (обов'язкове доручення req) → b (з 5-го рівня) → c (з 9-го); opt — необов'язкове, far — з 10-го рівня; lv — крок історії з метою «stat»
	var lines := {"main": {"kind": "story", "story": true}, "dor": {"kind": "side", "title": "Доручення кобзаря"}}
	var story_steps := {
		"a": _qstep("main", [], {"type": "clear", "loc": "wild_field", "text": "Перша мета"}),
		"b": _qstep("main", ["a", "req"], {"type": "dungeon", "loc": "zmii_cave", "text": "Друга мета"}, {"min_level": 5, "start": talk, "end": bye, "turn_in": "sich"}),
		"c": _qstep("main", ["b"], {"type": "clear", "loc": "rapids", "text": "Третя мета"}, {"min_level": 9, "start": talk}),
		"lv": _qstep("main", ["b"], {"type": "stat", "stat": "level", "count": 4, "text": "Досягни 4-го рівня"}, {"start": talk, "end": bye, "turn_in": "sich"}),
	}
	var side_steps := {
		"opt": _side_step(["a"], "Перший поверх Башти", {"type": "stat", "stat": "tower", "count": 3, "loc": "bashta", "text": "Підіймись на третій поверх Башти"}, {"reward": {"gold": 100, "xp": 50}}),
		"req": _side_step(["a"], "Двоє заражених", {"type": "stat", "stat": "kill", "count": 2, "text": "Поклади двох ворогів"}, {"reward": {"trophy": 2}}),
		"far": _side_step(["a"], "Лист до Києва", {"type": "visit", "loc": "kyiv", "text": "Їдь до Києва"}, {"min_level": 10, "reward": {"gold": 10}}),
	}
	var gp := GameDB.quest_graph_problems(lines, {"story": story_steps, "side": side_steps})
	check(gp.is_empty(), "вигаданий граф з дорученнями без проблем: %s" % str(gp))
	var all_steps: Dictionary = story_steps.duplicate()
	all_steps.merge(side_steps)
	Q.use_graph(Q.make_graph(lines, all_steps))
	var w = WorldState.new()
	var p = _new_player()
	w.hero_level = 3
	p.level = 3
	check(Q.missions(w) == ["a"] and Q.waiting(w).is_empty(), "спершу лише a; ті, що далі в ланцюжку, не видно навіть як «потрібен рівень»")
	Q.on_event(w, p, "clear", "wild_field")
	check(Q.is_done(w, "a") and Q.missions(w) == ["opt", "req"] and Q.stage(w, "b") == "locked" and Q.waiting(w) == ["far"], "після a: два доручення поруч, b чекає обов'язкове req, far чекає рівня (%s, %s)" % [str(Q.missions(w)), str(Q.waiting(w))])
	check(Q.mark("opt") == "!" and Q.kind_of("opt") == "side" and Side.missions(w) == ["opt", "req"], "доручення — знак оклику")
	var sd: Array = Side.city_dialogues(w, "sich")
	check(sd.size() == 2 and str(sd[0]["kind"]) == "side_start" and str(sd[0]["id"]) == "opt", "у ратуші Січі обидва доручення чекають розмови")
	var dsec := {}
	for sec in JS.sections(w, p):
		if str(sec["title"]) == "Доручення":
			dsec = sec
	var dtexts := []
	for r in dsec.get("rows", []):
		dtexts.append(str(r["text"]))
	check(dtexts.size() == 3 and dtexts[0] == "! Перший поверх Башти: Поговори: %s" % kob and dtexts[2] == "! Лист до Києва: Поговори: %s — потрібен рівень 10" % kob, "журнал: розділ «Доручення», знак оклику й «потрібен рівень»: %s" % str(dtexts))
	var gmm: Dictionary = Q.map_marks(w)
	check(gmm["marks"].has("sich") and gmm["dim_marks"].has("sich") and gmm["stars"].is_empty(), "мапа: доручення — «!» над Січчю (і блідий для far): %s" % str(gmm))
	# Необов'язкове з «найвищим» лічильником: рахується нинішнє значення
	w.stats["tower"] = 1
	var m1: Array = Side.on_dialogue_done(w, p, "side_start", "opt")
	check(Q.stage(w, "opt") == "active" and Q.progress(w, "opt") == 1 and str(m1[0]["text"]).begins_with("! "), "взяте доручення: поверх 1 уже зараховано (найвище досягнуте)")
	CS.record(w, p, "tower", 2)
	var orow := ""
	for r in JS.sections(w, p).filter(func(x): return str(x["title"]) == "Доручення")[0]["rows"]:
		if "Башти" in str(r["text"]):
			orow = str(r["text"])
	check(Q.progress(w, "opt") == 2 and orow.ends_with("2/3"), "журнал показує поступ мети «stat»: «%s»" % orow)
	var tower_msgs: Array = CS.record(w, p, "tower", 3)
	check(Q.stage(w, "opt") == "turnin" and tower_msgs.any(func(t): return "Доручення: мету виконано" in str(t)), "третій поверх: мету виконано, повертайся (%s)" % str(tower_msgs))
	var gold0: int = p.gold
	var fin: Array = Side.on_dialogue_done(w, p, "side_end", "opt")
	check(Q.is_done(w, "opt") and p.gold == gold0 + 100 and fin.any(func(m): return "виконано" in str(m["text"])), "нагорода доручення: +100 грн")
	# Обов'язкове з лічильником-сумою: рахується від миті, коли взято; поступ переживає збереження
	w.stats["kill"] = 50
	Side.on_dialogue_done(w, p, "side_start", "req")
	check(int(w.missions["active"]["req"]["base"]) == 50 and Q.progress(w, "req") == 0, "сума: основа 50 на старті, поступ 0")
	CS.record(w, p, "kill", 1)
	check(Q.progress(w, "req") == 1 and Q.stage(w, "b") == "locked", "один ворог: 1/2, b ще закрита")
	var w2 = WorldState.new()
	w2.from_dict(w.to_dict())
	w2.hero_level = 3
	check(Q.stage(w2, "req") == "active" and Q.progress(w2, "req") == 1 and int(w2.missions["active"]["req"]["base"]) == 50 and Q.is_done(w2, "opt"), "збережено посередині: етап, лічильник і основа ті самі")
	CS.record(w2, p, "kill", 1)
	check(Q.stage(w2, "req") == "turnin", "після завантаження другий ворог закриває мету")
	var p_tr: int = int(p.resources.get("trophy", 0))
	Side.on_dialogue_done(w2, p, "side_end", "req")
	check(Q.is_done(w2, "req") and int(p.resources.get("trophy", 0)) == p_tr + 2 and Q.stage(w2, "b") == "level" and Q.waiting(w2) == ["b", "far"] and not "c" in Q.waiting(w2), "обов'язкове здано: b тепер чекає лише 5-го рівня, c далі в ланцюжку не видно")
	# Місія, якій бракує рівня: журнал, порадник, мапа
	var ssec: Dictionary = JS.sections(w2, p)[0]
	check(ssec["rows"].size() == 1 and str(ssec["rows"][0]["text"]) == "★ Поговори: %s — потрібен рівень 5" % kob and int(ssec["rows"][0]["wait"]) == 5 and str(ssec["rows"][0]["place"]) == "sich", "журнал: наступна місія історії з «потрібен рівень 5»: %s" % str(ssec["rows"]))
	var tips: Array = GS.items(w2, p, "sich").filter(func(x): return str(x["kind"]) == "level")
	check(tips.size() == 2 and str(tips[0]["text"]) == "★ Набери рівні: бракує 2 рівнів" and "з 5-го рівня" in str(tips[0]["sub"]) and str(tips[0]["place"]) == "sich" and str(tips[1]["text"]) == "! Набери рівні: бракує 7 рівнів", "порадник: скільки рівнів бракує: %s" % str(tips))
	check(Q.map_marks(w2)["dim_stars"].has("sich") and JS.total(w2, p) == JS.total(w2, p) and JS.ready_count(w2, p) == 0, "мапа: бліда зірка над Січчю")
	var n_wait := 0
	for sec in JS.sections(w2, p):
		for r in sec["rows"]:
			n_wait += 1 if r.has("wait") else 0
	check(n_wait == 2 and JS.total(w2, p) == 0, "місії, що чекають рівня, не рахуються як справи журналу")
	# Рівень дозволив: b відкрито; мета «stat» у кроці історії
	w2.hero_level = 5
	p.level = 5
	check(Q.stage(w2, "b") == "offer" and Q.waiting(w2) == ["far"], "з 5-го рівня b пропонують")
	Q.complete(w2, "b")
	w2.stats["level"] = 5
	var lvm: Array = SS.on_dialogue_done(w2, p, "start", -1, "lv")
	check(Q.stage(w2, "lv") == "turnin" and lvm.size() >= 2 and str(lvm[0]["text"]).begins_with("★ "), "крок історії з метою «stat»: «найвищого» досягнуто ще до кроку — одразу повертайся (%s)" % str(lvm))
	# Рівень бою місії
	var pl = _new_player()
	pl.level = 10
	var wl = WorldState.new()
	wl.hero_level = 10
	Q.state(wl)["done"]["a"] = true
	Q.state(wl)["done"]["req"] = true
	Q.start(wl, "b")
	var base_lvl: int = int(Data.place("zmii_cave")["level"])
	Q.use_graph({})
	var low := {}
	for k in ["a", "req", "b"]:
		low[k] = all_steps[k].duplicate(true)
	low["b"]["min_level"] = 30
	low["b2"] = _qstep("main", ["a"], {"type": "dungeon", "loc": "zmii_cave", "text": "Ще раз"}, {"min_level": 40, "start": talk})
	low["b3"] = _qstep("main", ["a"], {"type": "dungeon", "loc": "zmii_cave", "text": "Ще й ще"}, {"min_level": 2, "start": talk})
	low["b4"] = _qstep("main", ["a"], {"type": "clear", "loc": "wild_field", "text": "Без рівня"}, {"start": talk})
	Q.use_graph(Q.make_graph(lines, low))
	Q.start(wl, "b4")
	check(Q.fight_mods(wl, pl, "wild_field").is_empty(), "крок історії без «min_level» місця не міняє (як сьогодні)")
	var fm: Dictionary = Q.fight_mods(wl, pl, "zmii_cave")
	check(int(fm.get("level", 0)) == 30 and int(fm["base_level"]) == base_lvl and int(fm["hero_level"]) == 10 and str(fm["mission"]) == "b" and int(fm["goal"]) > 0, "місія 30-го рівня веде в печеру %d-го: бій на 30-му: %s" % [base_lvl, str(fm)])
	Q.start(wl, "b2")
	Q.start(wl, "b3")
	check(int(Q.fight_mods(wl, pl, "zmii_cave")["level"]) == 40 and str(Q.fight_mods(wl, pl, "zmii_cave")["mission"]) == "b2", "кілька місій в одному місці — найвищий рівень")
	Q.use_graph({})
	low["bt"] = _qstep("main", ["a"], {"type": "stat", "stat": "tower", "count": 1, "loc": "bashta", "text": "Башта"}, {"min_level": 60, "start": talk})
	Q.use_graph(Q.make_graph(lines, low))
	Q.start(wl, "bt")
	check(Q.fight_mods(wl, pl, "bashta").is_empty(), "Башту місія не підтягує: там рівень поверху")
	Q.use_graph({})
	# Перекази: як решта місій — рівень кроку («min_level»), коли він вищий за місце
	var wv = WorldState.new()
	var pv = _new_player()
	pv.level = 60
	wv.hero_level = 60
	_quests_set(wv, "legends", {"lykho": {"step": 0, "stage": "active", "progress": 0}})
	var vloc: String = str(Q.step("lykho_1")["objective"]["loc"])
	var lm: Dictionary = LS.mods_for(wv, pv, vloc)
	check(lm == Q.fight_mods(wv, pv, vloc) and lm.keys() == ["level", "hero_level", "base_level", "legend", "goal"] and int(lm["level"]) == 48 and int(lm["base_level"]) == int(Data.place(vloc)["level"]) and str(lm["legend"]) == "lykho", "переказ: бій на рівні кроку, ключі ті самі, що були: %s" % str(lm))
	pv.level = 1
	check(int(LS.mods_for(wv, pv, vloc).get("level", 0)) == 48, "рівень переказу — рівень кроку, хоч який герой")
	_quests_set(wv, "legends", {"vii": {"step": 1, "stage": "active", "progress": 0}})
	check(LS.mods_for(wv, pv, str(Q.step("vii_2")["objective"]["loc"])).is_empty(), "місце не слабше за крок переказу: бій як є")
	# ---- Довідник ----
	var me: Dictionary = WS.mission_entry()
	var found := false
	for e in WS.search("знак оклику"):
		found = found or str(e["entry"]["title"]) == str(me["title"])
	check("«★»" in str(me["text"]) and "«!»" in str(me["text"]) and "потрібен рівень" in str(me["text"]) and "рівень місії" in str(me["text"]) and found, "довідник: позначки, рівень місії й рівень бою (%s)" % str(me["title"]))
	p.free()
	pf.free()
	pl.free()
	pv.free()


## Доручення в таблицях: перевірка запису (мета «stat», нагорода, лінія) і порожня таблиця.
func _suite_side_db() -> void:
	suite("Доручення: таблиця")
	check(GameDB.ids("side") == ["tower_intro", "depths_intro"] + INTRO_SIDE and GameDB.problems().is_empty(), "доручення: Башта, Глибини й шість вступних до занять; таблиця без проблем")
	var good := {"probe": {"num": 8751, "line": "story", "title": "Проба", "giver": "kobzar", "city": "sich", "start": [["kobzar", "Є діло."]],
		"objective": {"type": "stat", "stat": "tower", "count": 1, "loc": "bashta", "text": "Перший поверх"}, "turn_in": "sich", "end": [["kobzar", "Дякую."]], "reward": {"gold": 10, "item": {"slot": "amulet", "rarity": 1, "ilvl": 5, "name": "Оберіг"}}}}
	var pr := GameDB.validate("side", good)
	check(pr.size() == 1 and _has_problem(pr, ["side/probe", "не лінія «side»"]), "запис доручення читається; лінія мусить бути виду side: %s" % str(pr))
	var bad: Dictionary = good.duplicate(true)
	bad["probe"]["num"] = 8601
	bad["probe"]["objective"] = {"type": "stat", "stat": "nema", "text": "x"}
	bad["probe"]["reward"] = {"gold_lvl": 5}
	bad["probe"]["turn_in"] = "nema"
	pr = GameDB.validate("side", bad)
	check(_has_problem(pr, ["side/probe", "«objective.count»"]) and _has_problem(pr, ["side/probe", "«nema»", "лічильника"]) and _has_problem(pr, ["side/probe.reward", "gold_lvl"]) and _has_problem(pr, ["side/probe", "«turn_in»"]) and _has_problem(pr, ["8601"]), "погане доручення: мета без «count», невідомий лічильник, чуже поле нагороди, «turn_in» у нікуди, номер не з проміжку: %s" % str(pr))
	var st: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("story")))
	st["recruit"]["objective"] = {"type": "stat", "stat": "dungeon", "count": 3, "text": "Пройди три печери"}
	check(GameDB.validate("story", st).is_empty(), "мета «stat» годиться й крокові історії")
	var ql: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("quest_lines")))
	ql["dor"] = {"num": 8716, "kind": "side", "title": "Доручення", "min_level": 5}
	ql["dor2"] = {"num": 8717, "kind": "side"}
	pr = GameDB.validate("quest_lines", ql)
	check(_has_problem(pr, ["quest_lines/dor2", "«title»"]) and not _has_problem(pr, ["quest_lines/dor:", "не має"]) and _has_problem(pr, ["quest_lines/dor", "нема жодного кроку"]), "лінія доручень: назва обов'язкова, рівень можна: %s" % str(pr))


## Вступні доручення (лінія «hospodarstvo»): рибалка, полювання, хутір, будова, казан, зілляварня. Хто дає, де,
## коли відкриваються (за справжніми умовами занять), порядок, нагороди, лічильники й запис довідника.
const INTRO_SIDE := ["hutir_intro", "build_intro", "fish_intro", "hunt_intro", "cook_intro", "brew_intro"]


func _suite_intro_side_db() -> void:
	suite("Доручення: вступ до занять")
	var Q = load("res://scripts/game/quest_engine.gd")
	var CS = load("res://scripts/game/challenge_service.gd")
	var CmS = load("res://scripts/game/camp_service.gd")
	var Acts = load("res://scripts/data/activities.gd")
	var Camp = load("res://scripts/data/camp_data.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var Story = load("res://scripts/data/story.gd")
	# ---- Шість записів, мовці з прологу й розділу I, у своїх містах ----
	var early := {}  # мовець → міста, де він говорить у пролозі й розділі I
	for id in GameDB.ids("story"):
		var R: Dictionary = GameDB.row("story", id)
		if not str(R["chapter"]) in ["prolog", "zaraza"]:
			continue
		for k in ["intro", "start", "end"]:
			for l in R.get(k, []):
				var c := str(R["city"]) if k == "start" else str(R["turn_in"])
				if not early.has(l[0]):
					early[l[0]] = {}
				early[l[0]][c] = true
	var bad := []
	for id in INTRO_SIDE:
		var st: Dictionary = Q.step(id)
		if st.is_empty() or Q.kind_of(id) != "side" or Q.line_of(id) != "hospodarstvo" or Q.mark(id) != "!" or Q.is_story(id):
			bad.append(id + ": не доручення лінії hospodarstvo")
			continue
		if not early.has(str(st["giver"])) or not early[str(st["giver"])].has(str(st["city"])) or str(st["turn_in"]) != str(st["city"]):
			bad.append(id + ": мовець не з прологу чи розділу I або не в своєму місті")
		if st["start"].size() < 4 or st["start"].size() > 6 or st["end"].size() < 1 or st["end"].size() > 2:
			bad.append(id + ": розмова не 4–6 реплік на початку чи 1–2 наприкінці")
		if str(st["objective"]["type"]) != "stat" or int(st["objective"]["count"]) != 1 or not CS.is_stat(str(st["objective"]["stat"])):
			bad.append(id + ": мета — не один раз лічильника")
		for k in ["start", "end"]:
			for l in st[k]:
				if str(l[1]).contains("-го рівн") or str(l[1]).contains("рівень героя") or str(l[1]).contains("рівня героя") or str(l[1]).contains("кнопк") or str(l[1]).contains("вкладк"):
					bad.append(id + ": репліка про рівень чи кнопки: " + str(l[1]))
	check(bad.is_empty() and GameDB.ids("side").size() == 8 and GameDB.problems().is_empty(), "шість вступних доручень: мовці з прологу й розділу I у своїх містах, 4–6 реплік, мета — один раз: %s" % str(bad))
	check(str(Q.step("hutir_intro")["giver"]) == "kobzar" and str(Q.step("build_intro")["giver"]) == "otaman" and str(Q.step("fish_intro")["giver"]) == "kobzar" and str(Q.step("hunt_intro")["giver"]) == "otaman"
		and str(Q.step("cook_intro")["city"]) == "chyhyryn" and str(Q.step("brew_intro")["giver"]) == "znakharka", "хутір і рибалка — кобзар, будова й полювання — кошовий (Січ), казан і зілля — Мотря (Чигирин)")
	# ---- Мети: справжні лічильники занять ----
	var obj := {}
	for id in INTRO_SIDE:
		obj[id] = "%s@%s" % [Q.step(id)["objective"]["stat"], Q.step(id)["objective"].get("loc", "")]
	check(obj == {"hutir_intro": "hutir@hutir", "build_intro": "camp_level@hutir", "fish_intro": "ryba@fish", "hunt_intro": "meat@hunt", "cook_intro": "cook@hutir", "brew_intro": "brew@hutir"}, "мети: навідини хутора, будова, улов, м'ясо, страва, зілля: %s" % str(obj))
	check("hutir" in CS.STATS and "camp_level" in CS.STATS and "brew" in CS.STATS and "camp_level" in CS.HIGHEST and not "hutir" in CS.HIGHEST and not "brew" in CS.HIGHEST, "нові лічильники: hutir і brew — суми, camp_level — найвище (рівнів будівель на хуторі)")
	var used := []
	for t in ["daily", "weekly", "achievements"]:
		for k in GameDB.ids(t):
			if str(GameDB.row(t, k)["stat"]) in ["hutir", "camp_level", "brew"]:
				used.append(t + "/" + k)
	for st in load("res://scripts/data/way_data.gd").steps():
		if str(st["check"].get("stat", "")) in ["hutir", "camp_level", "brew"]:
			used.append("way/" + str(st["id"]))
	check(used.is_empty(), "нові лічильники не чіпають викликів, досягнень і «Шляху козака»: %s" % str(used))
	var wc = WorldState.new()
	check(CmS.total_levels(wc) == 0, "порожній хутір: рівнів 0")
	CmS.state(wc)["buildings"] = {"kurin": 2, "sklad": 1}
	check(CmS.total_levels(wc) == 3, "курінь 2 і склад 1: рівнів 3")
	# ---- Коли відкриваються: за справжніми умовами ----
	check(Q.after("hutir_intro") == ["flee"] and Q.level_needed("hutir_intro") == 1 and Q.after("build_intro") == ["hutir_intro"] and Q.level_needed("build_intro") == 1, "хутір — щойно герой на Січі (після «%s»), будова — після хутора, обидва з 1-го" % Q.title("flee"))
	check(Q.after("fish_intro") == ["back_to_sich_s"] and Q.after("hunt_intro") == ["back_to_sich_s"] and Q.level_needed("fish_intro") == int(Acts.spot("fish")["level"]) and Q.level_needed("hunt_intro") == int(Acts.spot("hunt")["level"]),
		"рибалка й полювання — після прологу (дорогу обрано) і з рівня місця заняття (%d)" % int(Acts.spot("fish")["level"]))
	check(Q.after("cook_intro") == ["hunt_intro", "fish_intro", "road"] and Q.after("brew_intro") == ["build_intro", "road"] and Q.level_needed("cook_intro") == 3 and Q.level_needed("brew_intro") == 3, "казан — після полювання, рибалки й знайомства з Мотрею; зілля — після будови й Мотрі")
	var w = WorldState.new()
	w.hero_level = 1
	var stg := func(): return INTRO_SIDE.map(func(x): return Q.stage(w, x))
	check(stg.call() == ["locked", "locked", "locked", "locked", "locked", "locked"], "нова гра: жодного доручення")
	Q.place_at(w, "trial")
	check(stg.call() == ["offer", "locked", "locked", "locked", "locked", "locked"], "на Січі: кобзар кличе на хутір")
	Q.complete(w, "hutir_intro")
	check(Q.stage(w, "build_intro") == "offer", "хутір бачив — кошовий радить будуватися")
	Q.set_choice(w, "trial", 0)
	Q.place_at(w, "recruit")
	w.hero_level = 2
	check(Q.stage(w, "fish_intro") == "level" and Q.stage(w, "hunt_intro") == "level" and Q.level_needed("fish_intro") == 3, "пролог пройдено на 2-му рівні: рибалка й полювання чекають 3-го")
	w.hero_level = 3
	check(Q.stage(w, "fish_intro") == "offer" and Q.stage(w, "hunt_intro") == "offer" and Q.stage(w, "cook_intro") == "locked", "з 3-го — рибалка й полювання; казан ще ні")
	Q.complete(w, "fish_intro")
	Q.complete(w, "hunt_intro")
	check(Q.stage(w, "cook_intro") == "locked" and Q.stage(w, "brew_intro") == "locked", "без знайомства з Мотрею ні казана, ні зілля")
	Q.place_at(w, "potion")
	check(Q.stage(w, "cook_intro") == "offer" and Q.stage(w, "brew_intro") == "locked", "Мотря дає казан; зілля — лише коли збудовано першу будівлю")
	Q.complete(w, "build_intro")
	check(Q.stage(w, "brew_intro") == "offer", "і зілля")
	# ---- Нагороди: невеликі й на наступний крок того самого заняття ----
	var rw := {}
	for id in INTRO_SIDE:
		rw[id] = Q.step(id)["reward"]
	check(int(rw["hutir_intro"]["res"]["wood"]) >= int(GameDB.row("buildings", "sklad")["levels"][0]["wood"]) and int(rw["hutir_intro"]["res"]["wood"]) >= int(GameDB.row("buildings", "kurin")["levels"][0]["wood"]), "хутір: дерева на першу будівлю")
	var dish_ok := false
	for r in Acts.recipe_ids():
		var need: Dictionary = Acts.recipe(r)["need"]
		var have := {"herbs": int(rw["build_intro"]["res"]["herbs"]), "meat": int(rw["hunt_intro"]["res"]["meat"]), "ryba": int(rw["fish_intro"]["res"]["ryba"])}
		var ok := true
		for k in need:
			ok = ok and int(have.get(k, 0)) >= int(need[k])
		dish_ok = dish_ok or ok
	check(dish_ok and rw["cook_intro"]["res"].has("herbs") and int(rw["brew_intro"]["res"]["herbs"]) >= int(Camp.brew("heal")["herbs"]), "трави з будови, м'ясо з полювання й риба з рибалки — на першу страву; трави за казан і зілля — на наступне")
	var rich := []
	for id in INTRO_SIDE:
		if int(rw[id].get("gold", 0)) > 100 or rw[id].has("xp") or rw[id].has("item"):
			rich.append(id)
	check(rich.is_empty(), "нагороди скромні: до 100 грн, без досвіду й речей: %s" % str(rich))
	# ---- Перевірка поля «res» ----
	var good := {"probe": {"num": 8790, "line": "hospodarstvo", "title": "Проба", "giver": "kobzar", "city": "sich", "start": [["kobzar", "Є діло."]],
