func _suite_stones() -> void:
	suite("Камені долі")
	var ST = load("res://scripts/game/stone_service.gd")
	var p = _new_player()
	p.job = "cossack"
	p.skills = {}
	p.skill_gifts = {"whirl": 1}
	p.skills["whirl"] = 1
	p.stat_gifts = {"str": 3}
	p.stats["str"] += 3
	p.stat_points = 6
	p.add_stat("str")
	p.add_stat("vit")
	p.skill_points = 5
	p.learn_skill("whirl")
	p.learn_skill("sharp")
	p.learn_skill("battle_cry")
	p.perk_points = 2
	p.learn_perk("boots")
	check(not ST.reset_points(p), "без каменя не скинеш")
	ST.grant(p, "zabuttia")
	var str_gift: int = Data.STAT_BASE + 3
	check(ST.reset_points(p) and ST.count(p, "zabuttia") == 0, "Камінь забуття витрачено")
	check(p.stats["str"] == str_gift and p.stats["vit"] == Data.STAT_BASE and p.stat_points == 6, "характеристики повернуто, присяга лишилась")
	check(p.sk("whirl") == 1 and p.sk("sharp") == 0 and p.skill_points == 5, "вміння класу повернуто, подарований Вихор лишився")
	check(p.perks.is_empty() and p.perk_points == 2, "Загартування повернуто")
	# Алатир: Козак → Волхв
	p.learn_skill("whirl")
	p.learn_skill("battle_cry")
	check(ST.siblings(p) == ["volkhv", "strilets"], "сусідні дороги Козака — Волхв і Стрілець")
	check(not ST.change_path(p, "volkhv"), "без Алатиря дорогу не зміниш")
	ST.grant(p, "alatyr")
	p.job_level = 25
	var pts: int = p.skill_points
	check(ST.change_path(p, "volkhv") and p.job == "volkhv" and p.job_level == 25, "Алатир: тепер волхв, майстерність лишилась")
	check(p.sk("whirl") == 0 and p.sk("battle_cry") == 0 and p.skill_points == pts + 3, "козацькі вміння забуто з поверненням очок")
	check(p.learn_skill("fireball"), "одразу вчить волхвівське")
	var sp = _new_player()
	sp.change_class("plastun")
	check(ST.siblings(sp).size() == 2 and not "plastun" in ST.siblings(sp), "пластун може стати іншим козацьким майстром")
	# Камінь забуття вертає очки з усієї дороги: і з пройдених дерев теж
	var rp = _new_player()
	rp.skills = {}
	rp.skill_points = 3
	rp.learn_skill("vyly")
	rp.change_class("cossack")
	rp.learn_skill("whirl")
	rp.change_class("plastun")
	rp.learn_skill("kydok")
	ST.grant(rp, "zabuttia")
	check(rp.skill_points == 0 and ST.reset_points(rp) and rp.skill_points == 3 and rp.sk("vyly") == 0 and rp.sk("whirl") == 0 and rp.sk("kydok") == 0, "Камінь забуття вертає очки з усіх дерев дороги")
	check(rp.learn_skill("whirl") and rp.learn_skill("vyly") and rp.learn_skill("kydok"), "і їх можна розкласти наново в будь-яке дерево дороги")
	rp.free()
	# Боси
	var msgs: Array = ST.on_boss(sp, "putinoid", true)
	check(ST.count(sp, "alatyr") == 1 and ST.count(sp, "zabuttia") == 1 and msgs.size() == 2, "перший Путіноїд — гарантовано обидва камені")
	check(is_equal_approx(float(GameDB.row("stones", "zabuttia")["chance"]), 0.01) and is_equal_approx(float(GameDB.row("stones", "alatyr")["chance"]), 0.005), "шанс із боса: 1% Камінь забуття, 0,5% Алатир-камінь")
	check(int(GameDB.row("stones", "zabuttia")["coins"]) == 150 and int(GameDB.row("stones", "alatyr")["coins"]) == 300 and not GameDB.row("stones", "zabuttia").has("price"), "ціна в крамниці: 150 і 300 червінців, гривневої ціни нема")
	var z0: int = ST.count(sp, "zabuttia")
	var a0: int = ST.count(sp, "alatyr")
	seed(5)
	for i in 20000:
		ST.on_boss(sp, "upyr", false)
	var gz: int = ST.count(sp, "zabuttia") - z0
	var ga: int = ST.count(sp, "alatyr") - a0
	check(gz >= 150 and gz <= 250 and ga >= 65 and ga <= 135, "з босів камені падають рідко: %d забуття й %d Алатирів за 20000 (чекаємо 200 і 100)" % [gz, ga])
	var sk = _new_player()
	check(ST.on_boss(sk, "putinoid", true).size() == 2 and ST.count(sk, "alatyr") == 1 and ST.count(sk, "zabuttia") == 1, "перша перемога над Путіноїдом і далі дає обидва камені")
	sk.free()
	var with_stones := []
	for kind in GameDB.mob_ids():
		if GameDB.mob(kind).get("boss", {}).has("stones"):
			with_stones.append(kind)
	var pz: Array = ST.first_kill("putinoid")
	check(with_stones == ["putinoid"] and pz.size() == 2 and pz.count("zabuttia") == 1 and pz.count("alatyr") == 1, "«boss.stones» лише в Путіноїда, по одному каменю кожного виду: %s" % str(with_stones))
	var nine := ["zmii", "chaklun", "koshchii", "baba_yaha", "solovei", "lykho", "oprychnyk", "vidma", "vii"]
	var nine_ok := true
	var nine_roll := true
	for kind in nine:
		var np = _new_player()
		np.art = {"stone": -1.0}  # шанс нуль: гарантованого каменя нема, тож нічого
		nine_ok = nine_ok and ST.first_kill(kind).is_empty() and ST.on_boss(np, kind, true).is_empty() and np.stones.is_empty()
		np.art = {"stone": 1000.0}  # шанс понад одиницю: перша перемога йде звичайним кидком і дає обидва
		nine_roll = nine_roll and ST.on_boss(np, kind, true).size() == 2
		np.free()
	check(nine_ok, "перша перемога над дев'ятьма колишніми босами з каменем гарантованого каменя не дає")
	check(nine_roll, "перша перемога над ними йде звичайним кидком, як будь-яка інша")
	# Ранги слави й останній крок «Шляху козака» камені дають, як і раніше
	var gw = WorldState.new()
	var gp = _new_player()
	var want := {}
	for r in load("res://scripts/data/activities.gd").glory_ranks():
		if str(r.get("stone", "")) != "":
			want[str(r["stone"])] = int(want.get(str(r["stone"]), 0)) + 1
	load("res://scripts/game/glory_service.gd").add(gw, gp, 100000000)
	check(want.size() == 2 and int(want["zabuttia"]) + int(want["alatyr"]) == 3 and ST.count(gp, "zabuttia") == int(want["zabuttia"]) and ST.count(gp, "alatyr") == int(want["alatyr"]), "три ранги слави дають свої камені: %s" % str(gp.stones))
	var WayS = load("res://scripts/game/way_service.gd")
	var last: Dictionary = load("res://scripts/data/way_data.gd").steps()[-1]
	var lid: String = str(last["reward"].get("stone", ""))
	WayS._grant(last, gp)
	check(lid != "" and ST.count(gp, lid) == int(want.get(lid, 0)) + 1, "останній крок «Шляху козака» дає камінь: %s" % lid)
	gp.free()
	# Довідник: звідки камені тепер
	var arts := {}
	var heads := []
	var all_txt := ""
	for sec in load("res://scripts/game/wiki_service.gd").sections():
		for e in sec["entries"]:
			arts[str(e["title"])] = str(e["text"])
			heads.append(str(e.get("head", "")))
			all_txt += str(e["title"]) + " " + str(e.get("sub", "")) + " " + str(e["text"]) + "\n"
	var stone_ok := true
	for sid in ["zabuttia", "alatyr"]:
		var at: String = arts.get(ST.name_of(sid), "")
		var pct: String = load("res://scripts/game/wiki_service.gd")._pct(float(GameDB.row("stones", sid)["chance"]))
		stone_ok = stone_ok and pct in at and "%d червінців" % int(GameDB.row("stones", sid)["coins"]) in at and "останнім босом історії (Путіноїд; раз на весь рід" in at and not "сюжетними босами" in at and "ранги слави" in at and "«Шляху козака»" in at and "«Камені долі»" in at
	check(stone_ok and "1%" in arts.get("Камінь забуття", "") and "0,5%" in arts.get("Алатир-камінь", "") and "150 червінців" in arts.get("Камінь забуття", "") and "300 червінців" in arts.get("Алатир-камінь", ""), "статті каменів: шанс із боса, сюжет раз за гру, ціна в крамниці: %s" % arts.get("Алатир-камінь", ""))
	var where: String = arts.get("Де взяти камені", "")
	check("1%" in where and "0,5%" in where and "Путіноїд" in where and "150 червінців" in where and "300 червінців" in where and "раз за гру" in where and not "свят" in where and not "Башт" in where and not "гривн" in where, "«Де взяти камені»: бос, сюжет і крамниця, без свят, Башти й гривень: %s" % where)
	check(not "скарбник" in all_txt.replace("Скарбник Кам'яного Поясу", "").to_lower() and not "Скарбник" in heads, "у довіднику більше нема скарбника (звання «Скарбник Кам'яного Поясу» — інше)")
	check(not "амін" in arts.get("Трофейний ярмарок", "x амін") and "Жетон безпечної заточки" in arts.get("Трофейний ярмарок", ""), "ярмарок у довіднику без каменів, із жетоном")
	check("камені долі" in arts.get("Крамниця", ""), "стаття крамниці згадує камені долі")
	check("Гривні кладуть і забирають повзунком або вписаною сумою, а ще всі одразу." in arts.get("Скриня", ""), "стаття скрині каже, як класти гривні")
	var w = sp.to_dict()
	check(w["stones"]["alatyr"] >= 1 and w.has("stat_gifts"), "камені зберігаються")
	# Зілля відновлює й наснагу
	var m = _new_player()
	m.mana = 0.0
	m.potions = 1
	m.potion_timer = 0.0
	check(m.use_potion() and m.mana > 0.0, "зілля повертає наснагу навіть при повному здоров'ї")
	p.free()
	sp.free()
	m.free()


func _suite_endgame() -> void:
	suite("Після сюжету: крива досвіду й Глибини")
	var DS = load("res://scripts/game/depth_service.gd")
	var same := true
	for l in range(1, 30):
		if Data.xp_for_level(l) != 200 + 150 * l + 15 * l * l:
			same = false
	check(same, "до 30-го рівня крива без змін (сюжет не сповільнився)")
	check(Data.xp_for_level(35) > 3 * (200 + 150 * 35 + 15 * 35 * 35), "після 30-го крива крутішає")
	var prev := 0
	var mono := true
	for l in range(1, 99):
		if Data.xp_for_level(l) <= prev:
			mono = false
		prev = Data.xp_for_level(l)
	check(mono, "досвід на рівень завжди росте")
	var w = WorldState.new()
	check(not DS.unlocked(w, 99), "Глибини закриті до кінця сюжету")
	_quests_set(w, "story", {"chapter": 6, "step": 0, "stage": "done"})
	check(not DS.unlocked(w, 79) and DS.unlocked(w, 80) and DS.state(w)["max"] == 1 and DS.level_of(1) == 80, "після Путіноїда з 80-го — перша глибина 80-го рівня")
	var a = DS.loc_for(1)
	var b = DS.loc_for(20)
	check(b["level"] > a["level"] and b["rooms"] >= a["rooms"] and b["elite_bonus"] > a["elite_bonus"], "глибше — сильніше")
	var deep: Dictionary = DS.loc_for(200)
	var edge_d := 1
	while DS.level_of(edge_d + 1) <= Data.ENDLESS_SOFT:
		edge_d += 1
	check(int(deep["level"]) == DS.BASE_LEVEL + 2 * 199 and int(deep["level"]) > 400 and int(deep["loot_level"]) == Data.ENDLESS_SOFT, "дна нема: глибина 200 має %d-й рівень, а здобич лишається %d-го" % [int(deep["level"]), Data.ENDLESS_SOFT])
	check(int(DS.loc_for(10)["loot_level"]) == int(DS.loc_for(10)["level"]) and is_equal_approx(float(DS.loc_for(edge_d)["hp_mult"]), 1.1 + 0.02 * edge_d), "до %d-го рівня глибини ростуть, як і раніше" % Data.ENDLESS_SOFT)
	var d1: Dictionary = DS.loc_for(edge_d + 10)
	var d2: Dictionary = DS.loc_for(edge_d + 11)
	check(float(d2["hp_mult"]) / float(d1["hp_mult"]) > pow(Data.ENDLESS_HP_PER_LEVEL, 2.0) * 0.999 and float(d2["dmg_mult"]) / float(d1["dmg_mult"]) > pow(Data.ENDLESS_DMG_PER_LEVEL, 2.0) * 0.999, "понад %d-й рівень кожна глибина множить здоров'я й удар нечисті" % Data.ENDLESS_SOFT)
	check(Data.endless_hp(Data.ENDLESS_SOFT) == 1.0 and Data.endless_hp(Data.ENDLESS_SOFT + 50) > 2.5 and Data.endless_dmg(Data.ENDLESS_SOFT + 50) > 2.0 and Data.enemy_std_hp(400) > Data.enemy_std_hp(99), "мірка нечисті росте й на сотих рівнях")
	check(DS.loc_for(7)["enemies"] == DS.loc_for(7)["enemies"], "та сама глибина — та сама печера")
	for d in [1, 5, 12]:
		var L: Dictionary = DS.loc_for(d)
		check(GameDB.has_boss(L["boss"]) and L["enemies"].size() == 3, "глибина %d: бос і нечисть" % d)
	var m = DS.on_clear(w, 1)
	check(DS.state(w)["max"] == 2 and DS.state(w)["best"] == 1 and "2" in m, "пройшов — відкрито наступну")
	DS.on_clear(w, 1)
	check(DS.state(w)["max"] == 2, "повторне проходження не відкриває зайвого")
	var w2 = WorldState.new()
	w2.from_dict(w.to_dict())
	check(w2.depths["best"] == 1, "глибини зберігаються")
	var wq = WorldState.new()
	var bad := false
	for i in 200:
		if wq._gen_quest("lviv")["loc"] == "hlybyny" or wq._gen_quest("chernihiv")["loc"] == "hlybyny":
			bad = true
	check(not bad, "доручення не ведуть у Глибини")


func _suite_depth_battle() -> void:
	suite("Глибини зарази: спуск")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	game.world.hints = {"combat": true, "block": true, "elite": true, "boss": true, "item": true, "map": true, "depths": true, "stones": true}
	var p = game.player
	game.start_depth(1)
	await _frames(2)
	check(game.state != game.State.PLAYING, "до кінця сюжету не пускає")
	_quests_set(game.world, "story", {"chapter": 6, "step": 0, "stage": "done"})
	p.change_class("cossack")
	p.level = 80
	p.stats["str"] = 3000
	p.stats["vit"] = 3000
	p.skills = {"whirl": 5}
	p.recalc()
	p.hp = p.max_hp
	game.start_depth(1)
	await _frames(2)
	check(game.state == game.State.PLAYING and game.combat.loc.get("depth", 0) == 1 and game.combat.is_dungeon(), "спуск на глибину 1")
	var frames := 0
	while game.state == game.State.PLAYING and game.DepthService.state(game.world)["best"] < 1 and frames < 9000:
		_bot_fight(game)
		p.hp = p.max_hp
		await process_frame
		frames += 1
	check(game.DepthService.state(game.world)["best"] == 1 and game.DepthService.state(game.world)["max"] == 2, "глибину 1 пройдено (кадрів: %d)" % frames)
	check(int(game.world.stats.get("depth", 0)) == 1 and int(game.world.stats.get("depth_clear", 0)) == 1, "рекорд глибини записано, пройдена глибина йде у виклики")
	# Пройдена глибина каменя долі не дає (раніше — 15% і більше щоразу): п'ятдесят зачисток поспіль
	var dc = game.combat
	var st_before: Dictionary = p.stones.duplicate()
	var fx_before: int = dc.effects.get_child_count()
	var depth_banners := ""
	for i in 50:
		game._on_dungeon_cleared(game.DepthService.LOC_ID)
		depth_banners += game.hud.banner.text + " "
	var fx_txt := ""
	for t in dc.effects.get_children().slice(fx_before):
		if "text" in t:
			fx_txt += str(t.text) + " "
	check(dc.loc.has("depth") and int(game.world.stats.get("depth_clear", 0)) == 51 and p.stones == st_before, "п'ятдесят пройдених глибин — жодного каменя долі")
	check(not "амін" in depth_banners and not "амін" in fx_txt and not "амін" in str(GameDB.row("events", "depths")["reward"]), "про камінь із глибин не пишуть: %s" % str(GameDB.row("events", "depths")["reward"]))
	game.queue_free()
	await _frames(2)
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


func _suite_tower() -> void:
	suite("Башта Кощія: правила")
	var TS = load("res://scripts/game/tower_service.gd")
	var w = WorldState.new()
	var p = _new_player()
	p.level = 60
	check(not TS.unlocked(p, w) and not TS.unlocked(p), "до перемоги над Кощієм Башта закрита навіть на 60-му")
	_quests_set(w, "story", {"chapter": 4, "step": 0, "stage": "offer", "progress": 0})
	p.level = 37
	check(not TS.unlocked(p, w), "Кощія здолано, та до 38-го рівня Башта закрита")
	p.level = 38
	check(TS.unlocked(p, w) and TS.state(w)["max"] == 1 and TS.state(w)["best"] == 0, "після Кощія з 38-го рівня — перший поверх")
	check(Data.is_place(TS.LOC_ID) and Data.place(TS.LOC_ID).get("endless", false) and Data.place(TS.LOC_ID).get("tower", false), "Башта на мапі")
	var a = TS.loc_for(1)
	var b = TS.loc_for(30)
	check(a["type"] == "tower" and a["level"] == 38 and a["boss"] == "" and a["mini"] != "" and a["waves"] == 2, "поверх 1: рівень 38, хвилі, міні-бос")
	check(b["level"] > a["level"] and b["waves"] > a["waves"] and b["hp_mult"] > a["hp_mult"] and b["mini_affixes"] == 3, "вище — сильніше")
	var high: Dictionary = TS.loc_for(200)
	check(int(high["level"]) == TS.BASE_LEVEL + 200 and int(high["loot_level"]) == Data.ENDLESS_SOFT and TS.loot_level(30) == TS.level_of(30), "вершини нема: поверх 200 має %d-й рівень, а здобич лишається %d-го" % [int(high["level"]), Data.ENDLESS_SOFT])
	var f1: Dictionary = TS.loc_for(120)
	var f2: Dictionary = TS.loc_for(121)
	check(float(f2["hp_mult"]) / float(f1["hp_mult"]) > Data.ENDLESS_HP_PER_LEVEL * 0.999 and float(TS.loc_for(60)["hp_mult"]) == 1.0 + 0.012 * 60 and TS.first_gold(200) > TS.first_gold(85), "понад %d-й рівень кожен поверх множить силу нечисті, нагорода теж росте" % Data.ENDLESS_SOFT)
	check(TS.loc_for(7)["enemies"] == TS.loc_for(7)["enemies"], "той самий поверх — ті самі вороги")
	var supers := {}
	for f in [5, 10, 15, 20]:
		var L: Dictionary = TS.loc_for(f)
		check(TS.is_super(f) and L["boss"] != "" and GameDB.has_boss(L["boss"]) and (GameDB.mob_name(L["boss"]) != ""), "поверх %d: супербос %s" % [f, L["boss"]])
		supers[L["boss"]] = true
	check(supers.size() == 4, "чотири різні супербоси за перші 20 поверхів")
	check(not TS.is_super(4) and TS.loc_for(4)["boss"] == "", "4-й поверх — міні-бос")
	for f in [1, 2, 3, 6, 11]:
		var L: Dictionary = TS.loc_for(f)
		check(not (L["mini"] in L["enemies"]) and (GameDB.mob_name(L["mini"]) != ""), "поверх %d: міні-бос не з рядової нечисті" % f)
	var r = TS.on_clear(w, 1)
	check(TS.state(w)["max"] == 2 and TS.state(w)["best"] == 1 and r[1] == true and "2" in r[0], "пройшов 1-й — відкрито 2-й, перше проходження")
	r = TS.on_clear(w, 1)
	check(TS.state(w)["max"] == 2 and r[1] == false, "повторне проходження — не перше й не відкриває зайвого")
	check(TS.first_gold(5) > TS.first_gold(4) * 2, "за супербоса нагорода більша")
	var w2 = WorldState.new()
	w2.from_dict(w.to_dict())
	check(w2.tower["best"] == 1, "Башта зберігається")
	var wq = WorldState.new()
	var bad := false
	for i in 200:
		if wq._gen_quest("lviv")["loc"] == TS.LOC_ID or wq._gen_quest("chernihiv")["loc"] == TS.LOC_ID:
			bad = true
	check(not bad, "доручення не ведуть у Башту")
	# Нові боси: є назви; каменя за першу перемогу в них нема (його дає лише Путіноїд)
	var SS = load("res://scripts/game/stone_service.gd")
	for k in TS.super_bosses():
		check(SS.first_kill(k).is_empty() and (GameDB.mob_plural(k) != ""), "%s: має назву, каменя за першу перемогу нема" % k)
	var CS = load("res://scripts/game/challenge_service.gd")
	CS.now_override = 1762700000
	var w3 = WorldState.new()
	var p3 = _new_player()
	CS.record(w3, p3, "tower", 7)
	CS.record(w3, p3, "tower", 3)
	check(int(w3.stats.get("tower", 0)) == 7 and CS.state(w3)["ach"].has("tower_5"), "рекорд Башти — найвищий поверх, досягнення є")
	CS.now_override = 0


