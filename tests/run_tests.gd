	check(gp.alive and gp.hp >= gp.max_hp * 0.49 and not gp.ladanka_ready, "ладанка підняла героя з половиною здоров'я (%d із %d)" % [int(gp.hp), int(gp.max_hp)])
	game.queue_free()
	await _frames(3)
	get_root().get_tree().paused = false
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)


## Клітинки речей на екрані: кнопки заданого розміру без тексту (UI.item_cell).
func _cells(root_c: Control, px: int) -> Array:
	var out := []
	for b in root_c.find_children("*", "Button", true, false):
		if not b.is_queued_for_deletion() and b.text == "" and b.custom_minimum_size == Vector2(px, px):
			out.append(b)
	return out


func _suite_grid_shops() -> void:
	suite("Крамниця й скриня сіткою значків")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var UCity = load("res://scripts/ui/ui_city.gd")
	var UCamp = load("res://scripts/ui/ui_camp.gd")
	var UChar = load("res://scripts/ui/ui_character.gd")
	var UKit = load("res://scripts/ui/ui_kit.gd")
	var Camp = load("res://scripts/data/camp_data.gd")
	var Arts = load("res://scripts/data/artifacts.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	# ---- Клітинка з ціною й позначкою ----
	var sample: Dictionary = Data.gen_item(20, 2, "head")
	var plain: Button = UKit.item_cell(sample, func(): pass, false, 70)
	var priced: Button = UKit.item_cell(sample, func(): pass, false, 70, false, "1 384", true)
	var note_ok := false
	var check_ok := false
	for l in priced.find_children("*", "Label", true, false):
		note_ok = note_ok or l.text == "1 384"
		check_ok = check_ok or l.text == "✓"
	check(note_ok and check_ok and plain.find_children("*", "Label", true, false).is_empty() and priced.text == "" and priced.custom_minimum_size == Vector2(70, 70), "клітинка речі вміє показати ціну під значком і галочку")
	plain.free()
	priced.free()
	check(UCity.SHOP_CELL == UChar.CELL and UCity.BAG_COLS == 6, "клітинки крамниці такі самі, як у торбі героя: той самий розмір і шість стовпців")
	# ---- Примірка речі пам'ятається, доки не зміниться герой чи сама річ ----
	var cp = _new_player()
	cp.change_class("cossack")
	cp.level = 30
	var worn0: Dictionary = Data.gen_item(30, 1, "head")
	cp.add_item(worn0, true)
	cp.equip(worn0["uid"])
	var better: Dictionary = Data.gen_item(30, 3, "head")
	cp.add_item(better, true)
	var g1: float = cp.gain_from(better)
	check(cp._gain_cache.size() == 1 and is_equal_approx(cp.gain_from(better), g1) and cp._gain_cache.size() == 1, "друга примірка тієї самої речі береться з пам'яті")
	cp._gain_cache.clear()
	check(is_equal_approx(cp.gain_from(better), g1), "з пам'яті й наново примірка дає те саме: %.4f" % g1)
	better["up"] = 5
	var g2: float = cp.gain_from(better)
	check(g2 > g1 and cp._gain_cache.size() == 2, "заточена річ приміряється наново: %.4f проти %.4f" % [g2, g1])
	cp.equip(better["uid"])
	check(cp._gain_cache.is_empty() and is_equal_approx(cp.gain_from(better), 0.0) and cp.gain_from(worn0) < 0.0, "вдягнув іншу річ: стара пам'ять скинута, знята шапка тепер гірша за вдягнену")
	cp.free()
	# ---- Крамниця міста ----
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	var gw = game.world
	var gp = game.player
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "char", "levelup", "way", "camp", "kleinody"]:
		gw.hints[k] = true
	gp.change_class("cossack")
	game._sync_class()
	gp.level = 30
	gp.gold = 500000
	for i in 5:
		gp.add_item(Data.gen_item(28, i % 3, "body" if i % 2 == 0 else "boots"), true)
	gp.add_item(Arts.make(Arts.ids()[0]), true)
	gp.recalc()
	game.enter_map()
	await _frames(2)
	game.enter_city("poltava")
	await _frames(2)
	var tc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	var shop_i := -1
	for i in tc.get_tab_count():
		if tc.get_tab_title(i) == "Крамниця":
			shop_i = i
	# вкладки будуються ліниво: поки вкладку не відкрито, її вміст не збудовано
	var built := 0
	for i in tc.get_tab_count():
		if not tc.get_tab_control(i).has_meta("build"):
			built += 1
	check(built == 1 and tc.get_tab_control(shop_i).has_meta("build") and _cells(tc.get_tab_control(shop_i), UCity.SHOP_CELL).is_empty(), "з усіх вкладок міста збудовано лише відкриту (%d із %d)" % [built, tc.get_tab_count()])
	tc.current_tab = shop_i  # відкрити вкладку «Крамниця»
	check(not tc.get_tab_control(shop_i).has_meta("build") and game.city_tab == shop_i, "відкрита вкладка будується в ту ж мить")
	var page: Control = tc.get_tab_control(shop_i)
	var stock: Array = game.shop_stock("poltava")
	var cells: Array = _cells(page, UCity.SHOP_CELL)
	var tiles := 0
	for b in page.find_children("*", "Button", true, false):
		if "\n" in b.text and "грн" in b.text and not b.text.begins_with("Продати"):
			tiles += 1
	check(cells.size() == stock.size() + gp.inventory.size() and tiles == 0 and stock.size() > 0, "товари й торба стоять клітинками зі значками, текстових плиток нема (%d клітинок)" % cells.size())
	var price_seen := false
	var sell_seen := false
	for l in page.find_children("*", "Label", true, false):
		price_seen = price_seen or l.text == UKit.num(game.buy_price("poltava", stock[0]))
		sell_seen = sell_seen or l.text == "+" + UKit.num(Data.sell_price(gp.inventory[0]))
	var empties := 0
	for pn in page.find_children("*", "Panel", true, false):
		if pn.custom_minimum_size == Vector2(UCity.SHOP_CELL, UCity.SHOP_CELL):
			empties += 1
	check(price_seen and sell_seen and empties >= gp.bag_size() - gp.inventory.size(), "під значком ціна купівлі чи продажу, порожні місця торби видно клітинками")
	# дотик до товару показує картку й кнопку купівлі
	cells[0].pressed.emit()
	await _frames(2)
	page = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(shop_i)
	var buy_btn = null
	for b in page.find_children("*", "Button", true, false):
		if not b.is_queued_for_deletion() and b.text.begins_with("Купити за"):
			buy_btn = b
	var bag0: int = gp.inventory.size()
	check(game.city_sel_uid == int(stock[0]["uid"]) and buy_btn != null and not buy_btn.disabled, "дотик до клітинки товару відкриває картку з кнопкою «Купити»")
	buy_btn.pressed.emit()
	await _frames(2)
	check(gp.inventory.size() == bag0 + 1, "товар куплено з картки")
	# продаж кількох: позначені клітинки, артефакт не позначається
	game.city_do("sell_multi", null)
	await _frames(2)
	page = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(shop_i)
	var bag_cells: Array = _cells(page, UCity.SHOP_CELL).slice(game.shop_stock("poltava").size())
	var art_i := -1
	for i in gp.inventory.size():
		if gp.inventory[i].has("artifact"):
			art_i = i
	bag_cells[0].pressed.emit()
	bag_cells[1].pressed.emit()
	bag_cells[art_i].pressed.emit()
	await _frames(2)
	check(game.sell_marked.size() == 2 and not game.sell_marked.has(gp.inventory[art_i]["uid"]), "у режимі «Вибрати кілька» дотик позначає клітинки, артефакт не позначається")
	page = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(shop_i)
	var ticks := 0
	for l in page.find_children("*", "Label", true, false):
		if not l.is_queued_for_deletion() and l.text == "✓":
			ticks += 1
	check(ticks == 2, "позначені клітинки мають галочку")
	var n0: int = gp.inventory.size()
	game.city_do("sell_marked", null)
	await _frames(2)
	check(gp.inventory.size() == n0 - 2, "вибране продано разом")
	game.city_do("sell_multi", null)
	# ---- Скриня на хуторі ----
	game.enter_map()
	await _frames(2)
	var in_chest: Dictionary = Data.gen_item(25, 3, "amulet")
	game.account.put_item(in_chest, game.world)
	game.enter_camp()
	await _frames(2)
	var ctc = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0]
	for i in ctc.get_tab_count():
		if ctc.get_tab_title(i) == "Скриня":
			game.camp_tab = i
	game._build_camp()
	await _frames(2)
	var cpage: Control = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(game.camp_tab)
	var ccells: Array = _cells(cpage, UCamp.CHEST_CELL)
	var chest_n: int = game.account.chest["items"].size()
	check(game.chest_sel == "" and ccells.size() == chest_n + gp.inventory.size() and chest_n == 1, "скриня й торба стоять двома сітками клітинок (%d)" % ccells.size())
	var bag_n: int = gp.inventory.size()
	ccells[0].pressed.emit()
	await _frames(2)
	cpage = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(game.camp_tab)
	var take_btn := false
	for b in cpage.find_children("*", "Button", true, false):
		take_btn = take_btn or (not b.is_queued_for_deletion() and b.text == UCamp.CHEST_TAKE)
	check(game.chest_sel.begins_with("c:") and take_btn and game.account.chest["items"].size() == 1 and gp.inventory.size() == bag_n, "перший дотик лише показує річ зі скрині й кнопку «%s»" % UCamp.CHEST_TAKE)
	_cells(cpage, UCamp.CHEST_CELL)[0].pressed.emit()
	await _frames(2)
	check(game.account.chest["items"].is_empty() and gp.inventory.size() == bag_n + 1 and game.chest_sel == "", "другий дотик по тій самій клітинці забирає річ у торбу")
	var put_uid: int = int(gp.inventory[0]["uid"])
	game.camp_do("chest_select", "b:%d" % put_uid)
	await _frames(2)
	cpage = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(game.camp_tab)
	var put_btn = null
	for b in cpage.find_children("*", "Button", true, false):
		if not b.is_queued_for_deletion() and b.text == UCamp.CHEST_PUT:
			put_btn = b
	check(put_btn != null, "вибрана річ із торби має кнопку «%s»" % UCamp.CHEST_PUT)
	put_btn.pressed.emit()
	await _frames(2)
	check(game.account.chest["items"].size() == 1 and gp.find_item(put_uid).is_empty(), "кнопка картки кладе річ до скрині")
	# Чумацький віз: скриня з ним більша; зняли, коли речей понад місткість, — екран цілий і чесний
	var DSc = load("res://scripts/game/divine_service.gd")
	var div_had: Dictionary = gw.shop.get("divine", {}).duplicate()
	var worn_had: Dictionary = gp.divine.duplicate()
	if not gw.shop.has("divine"):
		gw.shop["divine"] = {}
	gw.shop["divine"]["mazha"] = true
	DSc.equip(gw, gp, "mazha")
	var c_on: int = game.account.chest_size(gw)
	var c_items: Array = game.account.chest["items"]
	var c_keep: Array = c_items.duplicate()
	while c_items.size() < c_on - 50 + 5:
		game.account.put_item(Data.gen_item(1, 0, "belt"), gw)
	var c_n: int = c_items.size()
	game._build_camp()
	await _frames(2)
	var chest_head := func() -> String:
		var pg: Control = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(game.camp_tab)
		for l in pg.find_children("*", "Label", true, false):
			if not l.is_queued_for_deletion() and l.text.begins_with("Скриня "):
				return l.text
		return ""
	check(chest_head.call() == "Скриня %d/%d" % [c_n, c_on], "з возом заголовок скрині: %s" % chest_head.call())
	DSc.unequip(gw, gp, "cart")
	var c_off: int = game.account.chest_size(gw)
	game.chest_sel = "b:%d" % int(gp.inventory[0]["uid"]) if not gp.inventory.is_empty() else ""
	game._build_camp()
	await _frames(2)
	cpage = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(game.camp_tab)
	var put_off = null
	for b in cpage.find_children("*", "Button", true, false):
		if not b.is_queued_for_deletion() and b.text == UCamp.CHEST_PUT:
			put_off = b
	check(c_off == c_on - 50 and chest_head.call() == "Скриня %d/%d" % [c_n, c_off] and _cells(cpage, UCamp.CHEST_CELL).size() == c_n + gp.inventory.size(), "віз зняли: екран скрині будується, заголовок %s, порожніх клітинок нема" % chest_head.call())
	check(game.chest_sel == "" or (put_off != null and put_off.disabled), "кнопка «%s» вимкнена, поки скриня переповнена" % UCamp.CHEST_PUT)
	if not gp.inventory.is_empty():
		var bag_was: int = gp.inventory.size()
		game.camp_do("chest_put", int(gp.inventory[0]["uid"]))
		check(game.account.chest["items"].size() == c_n and gp.inventory.size() == bag_was, "покласти в переповнену скриню не можна, річ лишилась у торбі")
	# прибрати: речі тесту зі скрині геть, дари як були
	game.account.chest["items"] = c_keep
	gw.shop["divine"] = div_had
	gp.divine = worn_had
	DSc.apply(gw, gp)
	game.chest_sel = ""
	game.smith_msg = ""
	# ---- Гривні скрині: повзунок, поле суми, «Покласти» й «Забрати» ----
	var gold_ui := func() -> Dictionary:
		var pg: Control = game.hud.screen_root.find_children("*", "TabContainer", true, false)[0].get_tab_control(game.camp_tab)
		var out := {"btn": {}, "label": "", "slider": null, "edit": null, "row": null}
		for n in pg.find_children("*", "", true, false):
			if n.is_queued_for_deletion():
				continue
			if n is HSlider and n.name == "ChestGoldSlider":
				out["slider"] = n
				out["row"] = n.get_parent()
			elif n is LineEdit and n.name == "ChestGoldSum":
				out["edit"] = n
			elif n is Button:
				out["btn"][n.text] = n
			elif n is Label and n.text.begins_with("У скрині:"):
				out["label"] = n.text
		return out
	var type_sum := func(g: Dictionary, t: String) -> void:
		g["edit"].text = t
		g["edit"].text_changed.emit(t)
	var win0: Vector2i = root.size
	root.size = Vector2i(1280, 720)
	gp.gold = 82800
	game.account.chest["gold"] = 26300009
	game.chest_gold_sum = 0
	game._build_camp()
	await _frames(2)
	var gu: Dictionary = gold_ui.call()
	var old_gone := true
	for t in ["↓100", "↑100", "↓1000", "↑1000"]:
		old_gone = old_gone and not gu["btn"].has(t)
	check(old_gone and gu["btn"].has(UCamp.CHEST_GOLD_PUT) and gu["btn"].has(UCamp.CHEST_GOLD_TAKE) and gu["btn"].has("↓ усе") and gu["btn"].has("↑ усе") and gu["slider"] != null and gu["edit"] != null, "у скрині нема «↓100», «↑1000» і подібних, є повзунок, поле, «Покласти», «Забрати», «↓ усе» й «↑ усе»")
	check(gu["label"] == "У скрині: 26 300 009 грн   •   у тебе: 82 800 грн", "суми з проміжками: %s" % gu["label"])
	var sl: HSlider = gu["slider"]
	var ed: LineEdit = gu["edit"]
	var put_b: Button = gu["btn"][UCamp.CHEST_GOLD_PUT]
	var take_b: Button = gu["btn"][UCamp.CHEST_GOLD_TAKE]
	check(int(sl.min_value) == 0 and int(sl.max_value) == 26300009 and int(sl.value) == 0 and ed.text == "0" and put_b.disabled and take_b.disabled, "повзунок від 0 до більшої суми, на нулі обидві кнопки вимкнені")
	check(ed.virtual_keyboard_type == LineEdit.KEYBOARD_TYPE_NUMBER and ed.max_length == 0, "поле суми відкриває цифрову клавіатуру й не має max_length")
	var row: Control = gu["row"]
	var row_kids: Array = row.get_children().filter(func(ch): return ch is Control)
	var tall := true
	for ch in row_kids:
		tall = tall and ch.size.y >= 44.0
	check(row_kids[0] == sl and row_kids[1] == ed and row_kids[2] == put_b and row_kids[3] == take_b and row_kids[4] == gu["btn"]["↓ усе"] and row_kids[5] == gu["btn"]["↑ усе"] and tall and not gu["label"] in row.get_children().map(func(ch): return ch.get("text")), "повзунок, поле, «Покласти», «Забрати», «↓ усе», «↑ усе» одним рядком під сумами, усе заввишки з кнопки")
	sl.value = 50000
	check(ed.text == "50000" and game.chest_gold_sum == 50000 and not put_b.disabled and not take_b.disabled, "повзунок міняє поле, кнопки вмикаються на місці")
	sl.value = 100000
	check(ed.text == "100000" and put_b.disabled and not take_b.disabled and is_instance_valid(put_b) and not put_b.is_queued_for_deletion(), "сума понад гривні героя: «Покласти» вимкнено, екран не перебудовано")
	type_sum.call(gu, "12a3 4")
	check(ed.text == "1234" and int(sl.value) == 1234 and game.chest_gold_sum == 1234, "у полі лише цифри, повзунок іде за полем: %s" % ed.text)
	type_sum.call(gu, "999999999")
	check(ed.text == "26300009" and int(sl.value) == 26300009 and game.chest_gold_sum == 26300009 and put_b.disabled and not take_b.disabled, "сума понад межу обрізана до межі: %s" % ed.text)
	type_sum.call(gu, "")
	check(ed.text == "" and game.chest_gold_sum == 0 and int(sl.value) == 0 and put_b.disabled and take_b.disabled, "порожнє поле — нуль")
	type_sum.call(gu, "82801")
	check(put_b.disabled and not take_b.disabled, "на гривню більше, ніж у героя: «Покласти» вимкнено")
	type_sum.call(gu, "30000")
	check(not put_b.disabled and not take_b.disabled, "30 000: обидві кнопки ввімкнено")
	put_b.pressed.emit()
	await _frames(2)
	gu = gold_ui.call()
	check(gp.gold == 52800 and int(game.account.chest["gold"]) == 26330009 and game.chest_gold_sum == 30000 and gu["edit"].text == "30000" and int(gu["slider"].value) == 30000, "«Покласти» кладе рівно 30 000, сума пережила перебудову")
	gu["btn"][UCamp.CHEST_GOLD_TAKE].pressed.emit()
	await _frames(2)
	gu = gold_ui.call()
	check(gp.gold == 82800 and int(game.account.chest["gold"]) == 26300009 and gu["label"] == "У скрині: 26 300 009 грн   •   у тебе: 82 800 грн", "«Забрати» забирає рівно 30 000")
	# ширина: найгірші суми не виходять за правий край ні на 1280, ні на широкому телефоні
	for wsz in [Vector2i(1280, 720), Vector2i(1560, 720)]:
		root.size = wsz
		game._build_camp()
		await _frames(3)
		gu = gold_ui.call()
		var right := 0.0
		for ch in gu["row"].get_children():
			if ch is Control:
				right = maxf(right, ch.get_global_rect().end.x)
		var vis_w: float = game.hud.screen_root.get_viewport_rect().size.x
		check(right <= vis_w - 8.0 and gu["row"].get_global_rect().end.x <= vis_w, "рядок гривень уміщається: правий край %d із %d" % [int(right), int(vis_w)])
	root.size = Vector2i(1280, 720)
	# обрізання після дії: хтось забрав гривні зі скрині, а сума стояла велика
	type_sum.call(gu, "26300009")
	game.account.chest["gold"] = 1000
	gu["btn"]["↓ усе"].pressed.emit()
