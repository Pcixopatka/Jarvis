## Суперники в герці: кожен стиль — своя механіка (scripts/mechanics/rival/), і вона справді б'ється.
func _suite_rival_mechanics() -> void:
	suite("Механіки суперників")
	var Acts = load("res://scripts/data/activities.gd")
	var M = load("res://scripts/mechanics/mechanic.gd")
	var files: Array = GameDB.mechanic_files("rival")
	check(files.size() == 5 and Acts.rival_ids().size() == 5, "п'ять стилів — п'ять файлів механік: %s" % str(files))
	var hooks_ok := true
	for id in Acts.rival_ids():
		var ref := str(Acts.rival(id)["mechanic"])
		var s: Script = M.script_of(ref)
		hooks_ok = hooks_ok and s != null and M.hooks_of(s) & M.SETUP != 0 and M.hooks_of(s) & M.ABILITY != 0 and M.hooks_of(s) & M.VOLLEY != 0 and ref in files
	check(hooks_ok, "механіка кожного суперника вантажиться, походить від основи нечисті й пише setup, ability (постріл — від mob/rival)")
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
	var game = load("res://scenes/main.tscn").instantiate()
	game.save_path = TEST_SAVE
	game.account_path = TEST_ACCOUNT
	game.use_slots = false
	root.add_child(game)
	await _frames(2)
	game.new_game()
	game.hud.close_dialogue()
	for k in ["combat", "block", "elite", "city", "map", "boss", "item", "cleared", "trail", "stones", "status"]:
		game.world.hints[k] = true
	game.enter_location("wild_field")
	await _frames(3)
	_clear_enemies(game)
	var c = game.combat
	var p = game.player
	p.max_hp = 1.0e9
	p.hp = p.max_hp
	var fight_ok := true
	var bad := []
	var want := {"rubaka": {"rush": true, "kd": 0.0, "ranged": false}, "spysnyk": {"rush": false, "kd": 170.0, "ranged": false}, "strilets": {"rush": false, "kd": 330.0, "ranged": true},
		"kharakternyk": {"rush": true, "kd": 0.0, "ranged": false}, "bulavnyk": {"rush": true, "kd": 0.0, "ranged": false}}
	for id in Acts.rival_ids():
		c.spawn_enemy("rival", 20, false, p.global_position + Vector2(0, -260))
		var e = c._last_enemy()
		e.make_rival(Acts.rival(id), 3000.0, 10.0)
		var st := str(e.style)
		var W: Dictionary = want.get(st, {})
		var ok: bool = (e.mechanic != null and str(e.mechanic.get_script().resource_path).ends_with("rival/%s.gd" % st) and e.rush == W.get("rush", false)
			and is_equal_approx(e.keep_distance, W.get("kd", -1.0)) and e.ranged == W.get("ranged", false) and is_equal_approx(e.hp, e.max_hp))
		if st == "bulavnyk":
			ok = ok and is_equal_approx(e.max_hp, 3000.0 * 1.25) and is_equal_approx(e.damage, 10.0 * 1.15)
		var tele0: int = c.effects.get_child_count()
		for i in 6:
			e.cast_time = 0.0
			e._rival_ability(p)
		ok = ok and e.ability_step == 6 and e.ability_timer > 0.0 and c.effects.get_child_count() > tele0
		for f in 120:
			await process_frame
		ok = ok and is_instance_valid(e)
		if not ok:
			bad.append(id)
		fight_ok = fight_ok and ok
		if is_instance_valid(e):
			e.take_damage(1.0e9, Vector2.ZERO)
		await _frames(2)
	check(fight_ok, "кожен суперник у справжньому бою: стиль від механіки, прийоми обертаються, попередження з'являються: %s" % str(bad))
	# Боєць сотні огляду бере механіку суперника свого стилю
	var MS = load("res://scripts/game/muster_service.gd")
	var fs: Array = MS.fighters("serdiuky", 5, "w-test")
	c.spawn_enemy("rival", 20, false, p.global_position + Vector2(0, -260))
	var f0 = c._last_enemy()
	f0.make_rival(fs[0], 1000.0, 10.0)
	check(not fs[0].has("mechanic") and f0.style == "kharakternyk" and f0.mechanic != null and str(f0.mechanic.get_script().resource_path).ends_with("rival/kharakternyk.gd") and f0.title.begins_with("Сотник "), "сотник огляду б'ється механікою свого стилю")
	f0.take_damage(1.0e9, Vector2.ZERO)
	await _frames(2)
	game.queue_free()
	await _frames(2)


## Налаштування балансу (data/settings.json): кожне число-правило лежить лише там, модулі тримають робочі копії
## (static var), їх можна змінити під час гри, а зламаний запис помічає перевірка.
func _suite_settings_db() -> void:
	suite("Налаштування балансу")
	var SS = load("res://scripts/core/settings_schema.gd")
	var raw: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(GameDB.path_of("settings")))
	var vprobs := GameDB.validate("settings", raw)
	check(vprobs.is_empty(), "налаштування з файлу без проблем: %s" % str(vprobs.slice(0, 5)))
	# ---- Записи: усі розділи є, номери в проміжку 11001… і за порядком ----
	var doms: Array = SS.SCHEMAS.keys()
	check(GameDB.ids("settings") == doms and doms.size() == SS.MODULES.size() and doms.size() == SS.TITLES.size(), "у файлі всі %d розділів у порядку схеми, у кожного є модулі й заголовок" % doms.size())
	var num_bad := []
	for i in doms.size():
		if int(GameDB.settings(doms[i])["num"]) != 11001 + i or GameDB.by_num("settings", 11001 + i) != doms[i]:
			num_bad.append(doms[i])
	check(num_bad.is_empty() and GameDB.NUM_RANGES["settings"] == [11001, 11099], "номери записів 11001… по порядку, шукаються за номером: %s" % str(num_bad))
	# ---- Типи й заморожені записи ----
	var Elites = load("res://scripts/data/elites.gd")
	var Souls = load("res://scripts/data/souls.gd")
	var Acts = load("res://scripts/data/activities.gd")
	var PS = load("res://scripts/entities/player.gd")
	var L: Dictionary = GameDB.settings("loot")
	check(L.is_read_only() and GameDB.settings("enemies")["enemy_curve"].is_read_only() and GameDB.settings("enemies")["enemy_curve"][0].is_read_only()
		and GameDB.settings("enemies")["ref_dps"].is_read_only() and GameDB.settings("souls")["chance"].is_read_only(), "записи налаштувань заморожені")
	check(typeof(L["item_drop_chance"]) == TYPE_FLOAT and typeof(L["inventory_size"]) == TYPE_INT and typeof(GameDB.settings("enemies")["enemy_curve"][0]["level"]) == TYPE_INT
		and typeof(GameDB.settings("enemies")["std_hp"]) == TYPE_FLOAT and typeof(GameDB.settings("shop")["coins_on_sale"]) == TYPE_BOOL, "цілі — цілі, дробові — дробові, вимикачі — так/ні")
	check(typeof(Data.ITEM_DROP_CHANCE) == TYPE_FLOAT and typeof(Data.INVENTORY_SIZE) == TYPE_INT and typeof(Elites.XP_MULT) == TYPE_INT and typeof(Data.BOSS_XP_MULT) == TYPE_INT
		and typeof(Data.STD_HP) == TYPE_FLOAT and typeof(Acts.FISH_ZONE) == TYPE_ARRAY and typeof(Souls.CHANCE) == TYPE_DICTIONARY and typeof(PS.COMBO_MULT[0]) == TYPE_FLOAT
		and typeof(Data.ENEMY_CURVE[0][0]) == TYPE_INT and typeof(Data.ENEMY_CURVE[0][1]) == TYPE_FLOAT, "робочі копії в модулях тих самих типів, що були сталі")
	check(Data.ENEMY_CURVE.is_read_only() and Data.ENEMY_CURVE[0].is_read_only() and PS.COMBO_MULT.is_read_only() and Souls.CHANCE.is_read_only() and Acts.FISH_ZONE.is_read_only(),
		"перелічені числа модулів лише для читання, як були сталі")
	check(is_same(Data.ITEM_DROP_CHANCE, L["item_drop_chance"]) and Data.XP_GOLD_CAP == Data.XP_GOLD_MAX_TOP / (1.0 + Data.UPGRADE_BONUS * Data.MAX_UPGRADE),
		"модуль бере число з налаштувань, похідне (XP_GOLD_CAP) рахує з них")
	# ---- Кожне поле дійшло до свого модуля, і жодне не лишилося сталою ----
	var where := _settings_targets(SS)
	var lost: Array = where[1]
	var targets: Dictionary = where[0]
	check(lost.is_empty() and not targets.is_empty(), "кожне поле налаштувань має робочу копію в одному з модулів запису (static var, не стала): %s" % str(lost))
	var mism := _settings_mismatch(targets)
	check(mism.is_empty(), "робочі копії дорівнюють налаштуванням (тип і значення): %s" % str(mism.slice(0, 5)))
	var consts := []
	for d in SS.MODULES:
		for m in SS.MODULES[d]:
			var cm: Dictionary = load(m[0]).get_script_constant_map()
			for key in targets:
				if str(key).begins_with(d + ".") and cm.has(targets[key][1]):
					consts.append("%s.%s" % [m[0].get_file(), targets[key][1]])
	check(consts.is_empty(), "перенесені імена ніде в модулях запису не лишилися сталими: %s" % str(consts))
	# Ініціалізатор static var виконується раніше за _static_init, а в зібраній грі ще й в іншому порядку: він не
	# має читати перенесених чисел (усе похідне рахує apply_settings()). Сталі, що їх читають, не скомпілюються.
	var moved_names := {}
	for key in targets:
		moved_names[targets[key][1]] = true
	moved_names["XP_GOLD_CAP"] = true
	var re := RegEx.new()
	re.compile("\\b(" + "|".join(moved_names.keys()) + ")\\b")
	var early := []
	for path in _gd_files("res://scripts"):
		var lines := FileAccess.get_file_as_string(path).split("\n")
		for i in lines.size():
			var code := lines[i].get_slice("#", 0)
			if code.begins_with("static var ") and "=" in code and re.search(code.get_slice("=", 1)) != null:
				early.append("%s:%d" % [path.get_file(), i + 1])
	check(early.is_empty() and moved_names.size() > 300, "жоден ініціалізатор static var не читає перенесених чисел: %s" % str(early))
	# ---- Нові налаштування під час гри: модулі беруть нові числа ----
	var orig: Dictionary = raw.duplicate(true)
	var file_rows: Dictionary = GameDB.table("settings")
	var edit: Dictionary = raw.duplicate(true)
	edit["loot"]["item_drop_chance"] = 0.5
	edit["elites"]["hp_mult"] = 3.25
	edit["sharpening"]["max_upgrade"] = 12
	edit["shop"]["coins_on_sale"] = true
	edit["divine"]["on_sale"] = false
	var put := GameDB.put_settings(edit)
	check(put.is_empty() and Data.ITEM_DROP_CHANCE == 0.5 and Elites.HP_MULT == 3.25 and Data.MAX_UPGRADE == 12 and Data.XP_GOLD_CAP == Data.XP_GOLD_MAX_TOP / (1.0 + Data.UPGRADE_BONUS * 12)
		and load("res://scripts/data/shop.gd").COINS_ON_SALE and load("res://scripts/game/shop_service.gd").coins_on_sale and not load("res://scripts/game/divine_service.gd").on_sale and GameDB.settings("loot")["item_drop_chance"] == 0.5,
		"змінене в копії налаштувань число після put_settings — у модулях (і похідне, і вимикачі продажу): %s" % str(put.slice(0, 3)))
	# Кожне поле окремо: усі числа змінено, і кожна робоча копія стала новим числом
	var bumped := {}
	for d in doms:
		bumped[d] = _settings_bump(file_rows[d], SS.SCHEMAS[d])
	var put2 := GameDB.put_settings(bumped, false)
	var mism2 := _settings_mismatch(targets)
	var same := []
	for key in targets:
		if var_to_str(targets[key][0].get(targets[key][1])) == var_to_str(_settings_value_in(file_rows, key)):
			same.append(key)
	check(put2.is_empty() and mism2.is_empty() and same.is_empty(), "кожне з %d полів, змінене в налаштуваннях, змінює своє число в модулі: %s %s" % [targets.size(), str(mism2.slice(0, 5)), str(same.slice(0, 5))])
	# Назад: числа з файлу
	var back := GameDB.put_settings(orig)
	_set_sale(true)
	check(back.is_empty() and _settings_mismatch(targets).is_empty() and is_same(Data.ITEM_DROP_CHANCE, GameDB.settings("loot")["item_drop_chance"])
		and Data.XP_GOLD_CAP == Data.XP_GOLD_MAX_TOP / (1.0 + Data.UPGRADE_BONUS * Data.MAX_UPGRADE) and not load("res://scripts/data/shop.gd").COINS_ON_SALE, "налаштування з файлу повернулися в модулі")
	# ---- Зламаний запис помічає перевірка, і такі налаштування не ставляться ----
	var bad: Dictionary = raw.duplicate(true)
	bad["loot"]["item_drop_chance"] = 1.5
	bad["potions"]["potion_max"] = "п'ять"
	bad["elites"]["chanse"] = 0.1
	bad["death"].erase("death_gold_loss")
	bad.erase("ads")
	bad["bogus"] = {"num": 11098}
	bad["trails"]["trail_min_level"] = 150
	bad["enemies"]["enemy_curve"][1]["level"] = 1
	bad["quests"]["daily_count"] = 40
	bad["party"]["max_companions"] = 9
	bad["duel"]["rounds"] = 5
	bad["loot"]["rarity_max_random"] = 9
	bad["hunting"]["fish_zone"] = [0.8, 0.3]
	bad["souls"]["chance"].erase("named")
	bad["battle"]["field_spawn_min"] = 0
	var bp := GameDB.validate("settings", bad)
	var want := {"шанс": "settings/loot.item_drop_chance: шанс", "тип": "settings/potions.potion_max: має бути цілим числом", "невідоме поле": "settings/elites: невідоме поле «chanse»",
		"нема поля": "settings/death: немає обов'язкового поля «death_gold_loss»", "нема запису": "settings: немає запису «ads»", "невідомий запис": "settings/bogus: невідомий запис",
		"рівень": "settings/trails.trail_min_level: рівень від 0 до стелі", "мірка": "settings/enemies.enemy_curve[1]: рівні точок мають рости", "виклики": "settings/quests.daily_count:",
		"загін": "settings/party.max_companions:", "кола": "settings/duel.rounds:", "рідкість": "settings/loot.rarity_max_random: номер рідкості", "смуга": "settings/hunting.fish_zone:",
		"душі": "settings/souls.chance: роди", "більше нуля": "settings/battle.field_spawn_min: має бути більшим за нуль"}
	var missed := []
	for k in want:
		var found := false
		for p in bp:
			found = found or str(p).begins_with(want[k])
		if not found:
			missed.append(k)
	check(missed.is_empty(), "зламаний запис помічено: тип, межа шансу, невідоме поле, брак поля чи запису, рівень понад стелю, мірка, зв'язки з таблицями: %s; %s" % [str(missed), str(bp.slice(0, 4))])
	var refused := GameDB.put_settings(bad)
	check(not refused.is_empty() and is_same(Data.ITEM_DROP_CHANCE, GameDB.settings("loot")["item_drop_chance"]) and Data.ITEM_DROP_CHANCE < 1.0, "зламані налаштування не ставляться: лишаються теперішні")
	check(GameDB.problems().is_empty(), "у базі нема проблем після всіх замін")


## Куди йде кожне поле налаштувань: {"запис.поле": [модуль, ІМ'Я]} і перелік полів без робочої копії.
## Ім'я — поле великими літерами (вкладений запис — через «_»), без префікса модуля (SettingsSchema.MODULES).
func _settings_targets(SS) -> Array:
	var out := {}
	var lost := []
	for d in SS.SCHEMAS:
		var flat := []
		for k in SS.SCHEMAS[d]:
			if k == "num":
				continue
			var f: Dictionary = SS.SCHEMAS[d][k]
			if f["type"] == "record":
				for sub in f["fields"]:
					flat.append("%s_%s" % [k, sub])
			else:
				flat.append(k)
		for k in flat:
			var hits := []
			for m in SS.MODULES[d]:
				var M = load(m[0])
				var cm: Dictionary = M.get_script_constant_map()
				var names := [str(k).to_upper()]
				if m[1] != "" and str(k).begins_with(m[1]):
					names.append(str(k).trim_prefix(m[1]).to_upper())
				for n in names:
					if not cm.has(n) and M.get(n) != null:
						hits.append([M, n])
			if hits.size() == 1:
				out["%s.%s" % [d, k]] = hits[0]
			else:
				lost.append("%s.%s (%d)" % [d, k, hits.size()])
	return [out, lost]


## Значення поля «запис.поле» (вкладене — через «_») так, як його тримає модуль (мірка — [рівень, ttk, hit]).
func _settings_value(key: String):
	return _settings_value_in(GameDB.table("settings"), key)


func _settings_value_in(all: Dictionary, key: String):
	var d := key.get_slice(".", 0)
	var k := key.get_slice(".", 1)
	var R: Dictionary = all[d]
	if not R.has(k):
		for rec in R:
			if R[rec] is Dictionary and k.begins_with(str(rec) + "_") and R[rec].has(k.trim_prefix(str(rec) + "_")):
				return R[rec][k.trim_prefix(str(rec) + "_")]
	var v = R[k]
	if v is Array and not v.is_empty() and v[0] is Dictionary:
		return v.map(func(P): return [P["level"], P["ttk"], P["hit"]])
	return v


## Поля, у яких робоча копія не дорівнює налаштуванню (за значенням і типом).
func _settings_mismatch(targets: Dictionary) -> Array:
	var out := []
	for key in targets:
		var have = targets[key][0].get(targets[key][1])
		var want = _settings_value(key)
		if typeof(have) != typeof(want) or have != want:
			out.append("%s: %s / %s" % [key, var_to_str(have), var_to_str(want)])
	return out


## Те саме налаштування з іншими числами: ціле +1, дробове — половина й ще трохи (лишається в межах шансу), так/ні навпаки.
func _settings_bump(v, f: Dictionary):
	var t: String = f.get("type", "schema")
	match t:
		"schema", "record":
			var out := {}
			var fields: Dictionary = f if t == "schema" else f["fields"]
			for k in v:
				out[k] = v[k] if k == "num" else _settings_bump(v[k], fields[k])
			return out
		"bool":
			return not v
		"int":
			return v + 1
		"float":
			return v * 0.5 + 0.001
		"string":
			return str(v) + "_x"
		"list":
			return v.map(func(x): return _settings_bump(x, f["of"]))
		"map":
			var out := {}
			for k in v:
				out[k] = _settings_bump(v[k], f["of"])
			return out
	return v


## Усі .gd у теці (з підтеками).
func _gd_files(dir: String) -> Array:
	var out := []
	for d in DirAccess.get_directories_at(dir):
		out.append_array(_gd_files(dir + "/" + d))
	for f in DirAccess.get_files_at(dir):
		if f.ends_with(".gd"):
			out.append(dir + "/" + f)
	return out


# ======================= Майстерність: вища стеля, рання зміна класу =======================

## Скільки очок умінь герой має загалом: невитрачені й вкладені (без подарованих сюжетом рангів).
func _skill_total(p) -> int:
	var n: int = int(p.skill_points)
	for id in p.skills:
		n += maxi(0, int(p.skills[id]) - int(p.skill_gifts.get(id, 0)))
	return n


## Вивчити все, що можна, у дереві класу (у порядку вимог), поки є очки.
func _learn_tree(p, cls: String) -> void:
	var Classes = p.Classes
	var moved := true
	while moved and p.skill_points > 0:
		moved = false
		for br in Classes.tree(cls):
			for n in br["nodes"]:
				if p.skill_points > 0 and p.can_learn_skill(n) and p.learn_skill(n["id"]):
					moved = true


## Тексти всіх написів під вузлом (вікно, екран).
func _label_texts(node) -> String:
	var out := []
	if node == null or not is_instance_valid(node):
		return ""
	for l in node.find_children("*", "Label", true, false):
		out.append(l.text)
	return "\n".join(out)


## Збереження героя класу job старої версії формату (v12): так його лишила попередня збірка гри.
func _v12_hero(job: String, points: int, path: String) -> void:
	var p = _new_player()
	p.change_class(job)
	p.job_level = 7
	p.skills = {}  # без умінь: інакше чуже вміння стартового героя повернулось би очком під час читання
	p.skill_gifts = {}
	p.skill_points = points
	p.nick = "Сірко"
	SaveSystem.delete(path)
	SaveSystem.write_var(path, {"player": p.to_dict(), "world": WorldState.new().to_dict(), "meta": {"playtime": 60.0}, "version": 12})
	p.free()


## Файли героїв на пристрої (слоти й давній файл без слота): забрати на час перевірки й повернути.
func _hero_files_keep() -> Dictionary:
	var keep := {}
	var paths := [SaveSystem.SAVE_PATH]
	for i in range(1, SaveSystem.MAX_SLOTS + 1):
		paths.append(SaveSystem.slot_path(i))
	for path in paths:
		for suffix in ["", ".bak"]:
			var f: String = path + suffix
			keep[f] = FileAccess.get_file_as_bytes(f) if FileAccess.file_exists(f) else null
			if FileAccess.file_exists(f):
				DirAccess.remove_absolute(f)
	return keep


func _hero_files_restore(keep: Dictionary) -> void:
	for f in keep:
		if FileAccess.file_exists(f):
			DirAccess.remove_absolute(f)
		if keep[f] != null:
			var w := FileAccess.open(f, FileAccess.WRITE)
			w.store_buffer(keep[f])
			w.close()


func _suite_job_limits() -> void:
	suite("Майстерність: вища стеля, рання зміна класу")
	var Classes = load("res://scripts/data/classes.gd")
	var ST = load("res://scripts/game/stone_service.gd")
	var SS = load("res://scripts/game/spec_service.gd")
	var WS = load("res://scripts/game/wiki_service.gd")
	var per: int = Data.SKILL_POINTS_PER_LEVEL
	# ---- Дані ----
	var P: Dictionary = Classes.info("peasant")
	check(int(P["job_max"]) == 20 and int(P["change_at"]) == 10, "Селянин: майстерність до 20-ї, дорогу обирають з 10-ї")
	var firsts_ok := true
	for c in P["next"]:
		firsts_ok = firsts_ok and int(Classes.info(c)["tier"]) == 1 and int(Classes.info(c)["job_max"]) == 50 and int(Classes.info(c)["change_at"]) == 40
	check(firsts_ok and P["next"].size() == 3, "Козак, Волхв і Стрілець: майстерність до 50-ї, спеціалізацію обирають з 40-ї")
	var specs_ok := true
	for c in Classes.ids():
		if int(Classes.info(c)["tier"]) == 2:
			specs_ok = specs_ok and int(Classes.info(c)["job_max"]) == 50 and not Classes.info(c).has("change_at") and Classes.info(c)["next"].is_empty()
	check(specs_ok, "спеціалізації: майстерність до 50-ї, далі нікуди")
	check(per == 1 and Classes.plural(1, "очко", "очки", "очок") == "очко" and Classes.plural(3, "очко", "очки", "очок") == "очки" and Classes.plural(12, "очко", "очки", "очок") == "очок" and Classes.plural(21, "очко", "очки", "очок") == "очко", "очко за рівень; слово до числа: 1 очко, 3 очки, 12 очок, 21 очко")
	# ---- Селянин росте до 20-ї, і не далі ----
	var p = _new_player()
	p.job = "peasant"
	p.job_level = 1
	p.job_xp = 0
	p.skills = {}
	p.skill_points = 0
	p.recalc()
	var at10 := 0
	for jl in range(1, 10):
		at10 += Classes.job_xp_for(0, jl)
	p._add_job_xp(at10 - 1)
	check(p.job_level == 9 and not p.can_change_class(), "на 9-й майстерності дороги ще не обирають")
	p._add_job_xp(1)
	check(p.job_level == 10 and p.can_change_class() and p.skill_points == 9 * per, "з 10-ї — можна обирати (9 очок)")
	check(p.job_levels_left() == 10 and p.job_points_left() == 10 * per, "до вершини ще 10 рівнів і 10 очок")
	p._add_job_xp(10000000)
	check(p.job_level == 20 and p.job_xp == 0 and p.skill_points == 19 * per and p.can_change_class(), "Селянин доріс до 20-ї і далі не росте: 19 очок від першого рівня")
	p._add_job_xp(10000000)
	check(p.job_level == 20 and p.skill_points == 19 * per and p.job_points_left() == 0, "на вершині досвід майстерності більше нічого не дає")
	# ---- Терплячий Селянин: зайві очки йдуть у дерево Козака ----
	_learn_tree(p, "peasant")
	var pr: Array = p.tree_progress("peasant")
	var spare: int = 19 * per - int(pr[1])
	check(pr[0] == pr[1] and spare > 0 and p.skill_points == spare, "селянське дерево вивчене до кінця (%d рангів), а %d очок лишилось" % [pr[1], spare])
	p.change_class("cossack")
	check(p.job == "cossack" and p.job_level == 1 and p.skill_points == spare, "з Козаком майстерність з 1, зайві очки лишились")
	check(p.learn_skill("whirl") and p.skill_points == spare - 1, "зайве селянське очко вкладено в дерево Козака")
	p.free()
	# ---- Рання зміна на 10-й: очок за 11–20 нема й ніщо їх не верне ----
	var e = _new_player()
	e.job = "peasant"
	e.job_level = 1
	e.job_xp = 0
	e.skills = {}
	e.skill_points = 0
	e.recalc()
	e._add_job_xp(at10)
	check(e.job_level == 10 and e.skill_points == 9 * per, "Селянин на 10-й: 9 очок")
	e.learn_skill("hardy")
	e.learn_skill("vyly")
	e.change_class("cossack")
	check(e.job == "cossack" and e.job_level == 1 and _skill_total(e) == 9 * per, "змінив клас на 10-й: усього 9 очок, а не 19")
	var at40 := 0
	for jl in range(1, 40):
		at40 += Classes.job_xp_for(1, jl)
	e._add_job_xp(at40 - 1)
	check(e.job_level == 39 and not e.can_change_class() and SS.available(e).is_empty(), "Козак на 39-й: до наставника ще рано")
	e._add_job_xp(1)
	check(e.job_level == 40 and e.can_change_class() and SS.available(e).size() == 3 and e.job_max() == 50 and e.job_points_left() == 10 * per, "з 40-ї — до наставника; до вершини 50-ї ще 10 очок")
	var earned: int = (9 + 39) * per
	e.learn_skill("whirl")
	e.learn_skill("sharp")
	check(_skill_total(e) == earned, "Селянин до 10-ї й Козак до 40-ї: усього %d очок" % earned)
	ST.grant(e, "zabuttia")
	check(ST.reset_points(e) and _skill_total(e) == earned and e.skill_points == earned, "Камінь забуття вертає лише зароблене (%d), не очки за рівні, яких не було" % e.skill_points)
	e.learn_skill("whirl")
	ST.grant(e, "alatyr")
	check(ST.change_path(e, "volkhv") and e.job == "volkhv" and e.job_level == 40 and _skill_total(e) == earned, "Алатир-камінь (Козак → Волхв): майстерність та сама, очок стільки ж")
	ST.grant(e, "alatyr")
	check(ST.change_path(e, "cossack") and e.job == "cossack", "і назад у Козака")
	e.change_class("plastun")  # рання посвята на 40-й: очок за 41–50 нема
	e._add_job_xp(10000)
	var spec_lvl: int = e.job_level
	earned += (spec_lvl - 1) * per
	e.learn_skill("kydok")
	e.learn_skill("whirl")
	check(e.job == "plastun" and _skill_total(e) == earned, "пластун після ранньої посвяти: %d очок" % earned)
	ST.grant(e, "alatyr")
	var sp_before: int = e.skill_points
	check(ST.change_path(e, "zaporozhets") and e.job == "zaporozhets" and e.job_level == spec_lvl and _skill_total(e) == earned and e.skill_points > sp_before, "камінь зміни спеціалізації (Пластун → Запорожець): вміння пластуна вертаються очками, нових очок не додає й не забирає")
	ST.grant(e, "zabuttia")
	check(ST.reset_points(e) and _skill_total(e) == earned and e.skill_points == earned, "Камінь забуття й тепер вертає лише зароблене")
	var back = _new_player()
	back.from_dict(e.to_dict())
	check(_skill_total(back) == earned, "запис і читання героя очок не додають")
	back.free()
	e.free()
	# ---- Перший клас: зайві очки йдуть і в пройдені дерева, вершина 50 ----
	var k = _new_player()
	k.change_class("strilets")
	k.skills = {}
	k.skill_points = 0
	k._add_job_xp(10000000)
	check(k.job_level == 50 and k.skill_points == 49 * per and k.can_change_class(), "Стрілець доріс до 50-ї: 49 очок")
	k.free()
	# ---- У грі: попередження перед ранньою зміною класу ----
	SaveSystem.delete(TEST_SAVE)
	SaveSystem.delete(TEST_ACCOUNT)
