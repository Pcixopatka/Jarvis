extends RefCounted
## Годинник гри. Денні й тижневі обмеження, платня й термін Гетьманського універсалу, пасіка й нічна
## крадіжка рахуються від нього, а не просто від годинника телефона. Гра пам'ятає найпізніший час,
## який бачила (high, зберігається в акаунті), і назад не йде. Перевів годинник назад, а потім уперед:
## нічого не скинулось і вдруге не нарахувалось. Переведений уперед годинник лише пришвидшує те,
## що й так настало б, а вернутись назад уже не дасть.
## День для всіх обмежень один, за Гринвічем: зміна часового поясу теж нічого не скидає.
## Свята йдуть за місцевим календарем (HolidayService додає зсув поясу до цього ж годинника).

## Якщо телефон відстає від баченого часу більш як на стільки, вважаємо, що помилкою був саме той
## далекий час (годинник колись стояв на рік уперед), і вертаємось до годинника телефона.
## Без цього обмеження завмерли б на рік. Менший відступ лишається чинним.
const GIVE_UP := 30.0 * 86400.0

static var high := 0.0  # найпізніший бачений час, секунди епохи
static var _mono := -1.0  # лічильник часу роботи гри при минулому запиті, секунди


static func now() -> float:
	var t := Time.get_unix_time_from_system()
	var m := Time.get_ticks_msec() / 1000.0
	var passed: float = maxf(0.0, m - _mono) if _mono >= 0.0 else 0.0
	_mono = m
	if t >= high or high - t > GIVE_UP:
		high = t
	else:
		high += passed  # телефон відстає: час гри йде далі сам, зі справжньою швидкістю, поки гра відкрита
	return high


## Узяти збережений час з акаунта: якщо він пізніший за нинішній, годинник телефона перевели назад.
static func adopt(saved: float) -> void:
	high = maxf(high, saved)


## Чи годинник телефона зараз відстає від того, що гра вже бачила (більш ніж на хвилину).
static func rolled_back() -> bool:
	return Time.get_unix_time_from_system() < high - 60.0
