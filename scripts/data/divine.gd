static func has(id: String) -> bool:
	return DEFS.has(id)


## Які дари лягають у це гніздо, за порядком ORDER.
static func in_slot(slot: String) -> Array:
	var out := []
	for id in ORDER:
		if str(DEFS[id]["slot"]) == slot:
			out.append(id)
	return out
