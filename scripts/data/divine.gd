extends RefCounted
## Божі дари: чотири речі з крамниці за червінці. Кожна має власне гніздо на екрані героя, поруч зі
## звичайним спорядженням, і не займає місця в торбі. Купується раз на весь рід, вдягає кожен герой окремо.
## На відміну від вбрання, дари дають силу й зручність. Поля:
##   slot — гніздо (pet, cart, wings, relic); icon — значок (tools/pixel/icons.py); price — червінці;
##   pickup — у скільки разів більший радіус збору (надбавка), shop — чи дає крамницю будь-де,
##   bag — місця в торбі, stats — частка до всіх чотирьох характеристик,
##   fx — бойові показники (ключі як у пасивних умінь: Classes.FX_TEXT); lines — рядки опису.

const SLOTS := ["pet", "cart", "wings", "relic"]
const SLOT_NAMES := {"pet": "Супутник", "cart": "Віз", "wings": "Крила", "relic": "Реліквія"}
const ORDER := ["khovanets", "mazha", "kryla", "molot"]
const DEFS := {
	"khovanets": {"slot": "pet", "name": "Хованець", "icon": "dv_pet", "price": 900, "pickup": 4.0, "shop": true,
		"desc": "Рудий домашній дух із Карпат. Носить господареві добро й торгує за нього.",
		"lines": ["збирає здобич з усієї галявини: радіус збору вп'ятеро більший", "відкриває крамницю будь-де: продати зайве й купити зілля можна на мапі й посеред бою"]},
	"mazha": {"slot": "cart", "name": "Чумацька мажа", "icon": "dv_cart", "price": 700, "bag": 30,
		"desc": "Міцний чумацький віз. Герой тягне його за собою, і здобичі влазить значно більше.",
		"lines": ["торба більша на 30 місць"]},
	"kryla": {"slot": "wings", "name": "Крила Рарога", "icon": "dv_wings", "price": 1800, "stats": 0.1,
		"desc": "Крила вогняного сокола з переказів. З ними герой дужчий у всьому.",
		"lines": ["Сила, Спритність, Витривалість і Характерництво більші на 10%"]},
	"molot": {"slot": "relic", "name": "Громовий молот", "icon": "dv_hammer", "price": 1800,
		"fx": {"dmg": 12.0, "aspd": 8.0, "crit": 5.0, "crit_dmg": 20.0},
		"desc": "Молот громовержця. Варяги звуть його Мйольніром, а на Дніпрі кажуть, що то Перунова зброя.",
		"lines": ["+12% шкоди", "+8% швидкості удару", "+5% шансу криту", "+20% шкоди криту"]},
}


static func has(id: String) -> bool:
	return DEFS.has(id)


## Який дар лягає в це гніздо ("" — такого гнізда нема).
static func for_slot(slot: String) -> String:
	for id in ORDER:
		if str(DEFS[id]["slot"]) == slot:
			return id
	return ""
